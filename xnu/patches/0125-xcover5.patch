+/* MACH_KERNEL_PRIVATE in kern/sched_prim.h and kern/processor.h. */
+extern processor_t thread_bind(processor_t processor);
+extern processor_t cpu_to_processor(int cpu);
+
+static void
+xc5ts_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint8_t pt[66];
+	unsigned errors = 0;
+	/* Boot-arg xc5tscpu=N binds this thread to CPU N. Off by default:
+	 * binding to CPU 0 broke swipe-to-unlock even with cpus=1 (boot 25,
+	 * unbound boot 26 unlocked with the same kernel). */
+	int cpu = -1;
+	(void)PE_parse_boot_argn("xc5tscpu", &cpu, sizeof(cpu));
+	if (cpu >= 0) {
+		thread_bind(cpu_to_processor(cpu));
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	printf("XC5 TOUCH: poll thread on cpu %d (bound %d)\n", cpu_number(), cpu);
+	for (;;) {
+		uint64_t deadline;
+		bool now[XC5_FINGERS] = { false };
+		clock_interval_to_deadline(10, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&xc5ts_sleep, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		if (!xc5ts_read(XC5_EVENT_BUF, pt, 65)) {
+			if (errors++ < 5) {
+				printf("XC5 TOUCH: SPI timeout\n");
+			}
+			continue;
+		}
+		/* Vendor buffers keep the address byte at [0]: their point[1 + 6i]
+		 * is our pt[6i] (boot 20: one byte off, every contact 1 poll). */
+		if (pt[0] == 0xfd || pt[0] == 0xfe || pt[0] == 0x77) {
+			continue;       /* watchdog / ESD marker: no data */
+		}
+		for (int i = 0; i < XC5_FINGERS; i++) {
+			const uint8_t *q = &pt[6 * i];
+			unsigned id = q[0] >> 3, st = q[0] & 7u;
+			if (id == 0 || id > XC5_FINGERS || (st != 1 && st != 2)) {
+				continue;
+			}
+			unsigned px = ((unsigned)q[1] << 4) | (q[3] >> 4);
+			unsigned py = ((unsigned)q[2] << 4) | (q[3] & 0xfu);
+			if (px >= 720 || py >= 1480) {
+				continue;
+			}
+			int x, y, t = (int)id - 1;
+			xc5ts_map(px, py, &x, &y);
+			now[t] = true;
+			if (!xc5ts_down[t]) {
+				printf("XC5 TOUCH: down id=%d st=%u hdr=%02x panel %u,%u\n",
+				    t, st, pt[0], px, py);
+				xc5ts_seen[t] = 0;
+			}
+			xc5ts_down[t] = true;
+			xc5ts_miss[t] = 0;
+			xc5ts_seen[t]++;
+			xc5ts_x[t] = (uint16_t)x;
+			xc5ts_y[t] = (uint16_t)y;
+			if (t < 5) {
+				sweet_hid_touch(t, 1, x, y);
+			}
+		}
+		for (int t = 0; t < XC5_FINGERS; t++) {
+			if (xc5ts_down[t] && !now[t] && ++xc5ts_miss[t] >= XC5_RELEASE_MISSES) {
+				printf("XC5 TOUCH: up id=%d after %u polls\n", t, xc5ts_seen[t]);
+				xc5ts_down[t] = false;
+				if (t < 5) {
+					sweet_hid_touch(t, 0, xc5ts_x[t], xc5ts_y[t]);
+				}
+			}
+		}
+	}
+}
+
+static void
+xcover5_touch_start(void)
+{
+	int ready = 0;
+	thread_t thread;
+	(void)PE_parse_boot_argn("xc5touch", &ready, sizeof(ready));
+	(void)PE_parse_boot_argn("sweetfb_native", &xc5ts_native, sizeof(xc5ts_native));
+	if (!ready) {
+		printf("XC5 TOUCH: off (loader did not start the firmware)\n");
