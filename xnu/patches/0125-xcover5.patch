+/*
+ * GPU step 0 (docs/xcover5-gpu-plan.md), boot-arg xc5gpu: read only.
+ * 1: the G3D power domain (pd-g3d at 0x11861d00: config, status; the DT's
+ *    gpu_pmu_status_reg_offset 0x1d04, mask 1). 2: also, if powered, the
+ *    Mali-G52 identity and state registers at 0x11500000. No writes.
+ * Kept for the heartbeat: the console scrolls past the one-time lines.
+ */
+static const uint16_t xcover5_gpu_regs[] = {
+	0x000, 0x004, 0x008, 0x00c, 0x010, 0x014, 0x018, 0x01c, 0x034,   /* ID, L2/CORE/TILER/MEM/MMU_FEATURES, AS/JS_PRESENT, GPU_STATUS */
+	0x100, 0x110, 0x120, 0x140, 0x150, 0x160,                         /* SHADER/TILER/L2 PRESENT, READY */
+	0x300, 0x310, 0x04c,                                              /* COHERENCY_FEATURES, THREAD_TLS_ALLOC, AFBC_FEATURES */
+};
+static uint32_t xcover5_gpu_pd[2];
+static uint32_t xcover5_gpu_val[sizeof(xcover5_gpu_regs) / sizeof(xcover5_gpu_regs[0])];
+static int xcover5_gpu_state;   /* 0 off, 1 power read, 2 G3D off, 3 GPU read */
+
+/*
+ * GPU step 2 (xc5gpu=3), after Luminous418/hakios-a32's bring-up of the same
+ * Mali-G52 (kernel/bsd/dev/hakios.mali.c, steps 4-6): soft reset, L2/tiler/
+ * shader cores powered, then one WRITE_VALUE job on JS1 in identity mode
+ * (AS0 unmapped: a GPU address is physical) and the same job through AArch64
+ * 4K page tables (AS_TRANSCFG mode 6, 35-bit input). Boot 44 found the G3D
+ * domain on and the registers readable (GPU_ID 0x72120000, one shader core,
+ * MMU_FEATURES 0x2830, COHERENCY_FEATURES 0): S-Boot leaves power and clock
+ * on, so nothing outside the GPU is written.
+ */
+extern "C" uint64_t kvtophys(vm_offset_t va);
+extern "C" void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);
+static vm_offset_t xcover5_mali;
+static uint32_t xcover5_gpu_step;
+static uint32_t xcover5_gpu_jobres[2][5];  /* rawstat, js status, AS fault, header, word */
+
+static inline uint32_t
+xc5m_rd(uint32_t at)
+{
+	return *(volatile uint32_t *)(xcover5_mali + at);
+}
+
+static inline void
+xc5m_wr(uint32_t at, uint32_t value)
+{
+	*(volatile uint32_t *)(xcover5_mali + at) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+xc5m_wait(uint32_t at, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	for (uint32_t us = 0; us < ms * 1000; us += 10) {
+		if ((xc5m_rd(at) & mask) == want) {
+			return true;
+		}
+		IODelay(10);
+	}
+	return (xc5m_rd(at) & mask) == want;
+}
+
+#define XC5M_JS1        0x1880
+#define XC5M_AS0        0x2400
+#define XC5M_TRANSCFG   (6u | (20u << 6) | (1u << 24))   /* AArch64 4K, 55 - 35 bits, walks not cached */
+#define XC5M_JOB_GPU    0x00100000ull
+
+static void
+xc5m_as0(uint64_t transtab, uint32_t transcfg)
+{
+	xc5m_wr(XC5M_AS0 + 0x00, (uint32_t)transtab);
+	xc5m_wr(XC5M_AS0 + 0x04, (uint32_t)(transtab >> 32));
+	xc5m_wr(XC5M_AS0 + 0x30, transcfg);
+	xc5m_wr(XC5M_AS0 + 0x34, 0);
+	xc5m_wr(XC5M_AS0 + 0x08, 0x88888888u);
+	xc5m_wr(XC5M_AS0 + 0x0c, 0x88888888u);
+	xc5m_wr(XC5M_AS0 + 0x18, 1);           /* UPDATE */
+	(void)xc5m_wait(XC5M_AS0 + 0x28, 1, 0, 50);
+}
+
+/* WRITE_VALUE 0xc0ffee01 to page + 0x800; gpu is the page's GPU address. */
+static bool
+xc5m_write_job(vm_offset_t page, uint64_t gpu, uint32_t shaders, unsigned which)
+{
+	volatile uint32_t *job = (volatile uint32_t *)page;
+	volatile uint32_t *target = (volatile uint32_t *)(page + 0x800);
+	bzero((void *)page, PAGE_SIZE);
+	job[4] = (2u << 1) | 1u | (1u << 16);   /* WRITE_VALUE, 64-bit pointers, index 1 */
+	job[8] = (uint32_t)(gpu + 0x800);
+	job[9] = (uint32_t)((gpu + 0x800) >> 32);
+	job[10] = 6;                            /* 32-bit immediate */
+	job[12] = 0xc0ffee01u;
+	FlushPoC_DcacheRegion(page, PAGE_SIZE);
+	xc5m_wr(0x1008, 0);                    /* JOB_INT_MASK */
+	xc5m_wr(0x1004, 0xffffffffu);          /* JOB_INT_CLEAR */
+	xc5m_wr(XC5M_JS1 + 0x40, (uint32_t)gpu);
+	xc5m_wr(XC5M_JS1 + 0x44, (uint32_t)(gpu >> 32));
+	xc5m_wr(XC5M_JS1 + 0x50, shaders);
+	xc5m_wr(XC5M_JS1 + 0x54, 0);
+	xc5m_wr(XC5M_JS1 + 0x58, (3u << 8) | (3u << 12) | (8u << 16));
+	xc5m_wr(XC5M_JS1 + 0x60, 1);           /* START */
+	(void)xc5m_wait(0x1000, (1u << 1) | (1u << 17), 1u << 1, 100);
+	FlushPoC_DcacheRegion(page, PAGE_SIZE);
+	uint32_t *r = xcover5_gpu_jobres[which];
+	r[0] = xc5m_rd(0x1000);
+	r[1] = xc5m_rd(XC5M_JS1 + 0x24);
+	r[2] = xc5m_rd(XC5M_AS0 + 0x1c);
+	r[3] = job[0];
+	r[4] = *target;
+	xc5m_wr(0x1004, 0xffffffffu);
+	IOLog("XC5 GPU: job %u: irq=%x js=%x fault=%x hdr=%x word=%x%s\n", which + 1, r[0], r[1],
+	    r[2], r[3], r[4], r[4] == 0xc0ffee01u ? " -- the GPU ran it" : " -- not written");
+	return r[4] == 0xc0ffee01u;
+}
+
+static void
+xcover5_gpu_first_jobs(vm_offset_t mali)
+{
+	xcover5_mali = mali;
+	uint32_t shaders = xc5m_rd(0x100), tiler = xc5m_rd(0x110), l2 = xc5m_rd(0x120);
+	xc5m_wr(0x028, 0);                     /* GPU_INT_MASK */
+	xc5m_wr(0x024, 0xffffffffu);           /* GPU_INT_CLEAR */
+	xc5m_wr(0x030, 1);                     /* GPU_CMD: soft reset */
+	if (!xc5m_wait(0x020, 1u << 8, 1u << 8, 100)) {
+		IOLog("XC5 GPU: soft reset did not complete (raw %x)\n", xc5m_rd(0x020));
+		return;
+	}
+	xcover5_gpu_step = 1;
+	xc5m_wr(0x024, 0xffffffffu);
+	xc5m_wr(0x1a0, l2);                    /* L2_PWRON */
+	xc5m_wr(0x190, tiler);                 /* TILER_PWRON */
+	xc5m_wr(0x180, shaders);               /* SHADER_PWRON */
+	if (!xc5m_wait(0x160, l2, l2, 50) || !xc5m_wait(0x150, tiler, tiler, 50) ||
+	    !xc5m_wait(0x140, shaders, shaders, 50)) {
+		IOLog("XC5 GPU: cores not ready: l2 %x tiler %x shaders %x\n", xc5m_rd(0x160),
+		    xc5m_rd(0x150), xc5m_rd(0x140));
+		return;
+	}
+	xcover5_gpu_step = 2;
+	IOLog("XC5 GPU: cores powered: shaders %x tiler %x l2 %x\n", shaders, tiler, l2);
+	vm_offset_t page = (vm_offset_t)IOMallocAligned(PAGE_SIZE, PAGE_SIZE);
+	uint64_t *pt[3];
+	for (int i = 0; i < 3; i++) {
+		pt[i] = (uint64_t *)IOMallocAligned(PAGE_SIZE, PAGE_SIZE);
+	}
+	if (page == 0 || pt[0] == NULL || pt[1] == NULL || pt[2] == NULL) {
+		return;
+	}
+	xc5m_as0(0, 2);                         /* identity */
+	if (!xc5m_write_job(page, kvtophys(page), shaders, 0)) {
+		return;
+	}
+	xcover5_gpu_step = 3;
+	for (int i = 0; i < 3; i++) {
+		bzero(pt[i], PAGE_SIZE);
+	}
+	uint64_t gpu = XC5M_JOB_GPU;
+	pt[0][(gpu >> 30) & 31] = kvtophys((vm_offset_t)pt[1]) | 3;
+	pt[1][(gpu >> 21) & 511] = kvtophys((vm_offset_t)pt[2]) | 3;
+	pt[2][(gpu >> 12) & 511] = (kvtophys(page) & 0x0000fffffffff000ull) |
+	    (1ull << 10) | (3ull << 8) | (1ull << 6) | 3;   /* AF, inner shareable, RW, page */
+	for (int i = 0; i < 3; i++) {
+		FlushPoC_DcacheRegion((vm_offset_t)pt[i], PAGE_SIZE);
+	}
+	xc5m_as0(kvtophys((vm_offset_t)pt[0]), XC5M_TRANSCFG);
+	if (xc5m_write_job(page, gpu, shaders, 1)) {
+		xcover5_gpu_step = 4;
+		IOLog("XC5 GPU: step 2 done: jobs run in identity mode and through page tables\n");
+	}
+}
+
+static void
+xcover5_gpu_probe(void)
+{
+	int mode = 0;
+	(void)PE_parse_boot_argn("xc5gpu", &mode, sizeof(mode));
+	if (mode <= 0) {
+		return;
+	}
+	vm_offset_t pmu = ml_io_map(0x11861000, 0x1000);
+	if (pmu == 0) {
+		return;
+	}
+	xcover5_gpu_pd[0] = *(volatile uint32_t *)(pmu + 0xd00);
+	xcover5_gpu_pd[1] = *(volatile uint32_t *)(pmu + 0xd04);
+	xcover5_gpu_state = 1;
+	IOLog("XC5 GPU: pd-g3d config=%x status=%x (%s)\n", xcover5_gpu_pd[0], xcover5_gpu_pd[1],
+	    (xcover5_gpu_pd[1] & 1) ? "on" : "off");
+	if (mode < 2) {
+		return;
+	}
+	if (!(xcover5_gpu_pd[1] & 1)) {
+		xcover5_gpu_state = 2;
+		IOLog("XC5 GPU: G3D off, Mali not read\n");
+		return;
+	}
+	/* A clock-gated Mali can stop the bus: say so first, then read. */
+	IOLog("XC5 GPU: reading Mali registers at 0x11500000\n");
+	IOSleep(1000);
+	/* The whole block (DT size 0x5000): job slots at 0x1000, MMU/AS at 0x2000.
+	 * Boot 45 mapped one page and faulted writing AS0 (0x2400). */
+	vm_offset_t mali = ml_io_map(0x11500000, 0x5000);
+	if (mali == 0) {
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(xcover5_gpu_regs) / sizeof(xcover5_gpu_regs[0]); i++) {
+		xcover5_gpu_val[i] = *(volatile uint32_t *)(mali + xcover5_gpu_regs[i]);
+	}
+	xcover5_gpu_state = 3;
+	IOLog("XC5 GPU: id=%x (product %x) read\n", xcover5_gpu_val[0], xcover5_gpu_val[0] >> 16);
+	if (mode == 3) {                /* 4: the XC5GPU service does its own bring-up */
+		xcover5_gpu_first_jobs(mali);
+	}
+}
+
+static void
+xcover5_gpu_report(void)
+{
+	if (xcover5_gpu_state == 0) {
+		return;
+	}
+	const uint32_t *v = xcover5_gpu_val;
+	IOLog("XC5 gpu st=%d pd=%x/%x id=%x l2f=%x core=%x tilf=%x mem=%x mmu=%x as=%x js=%x "
+	    "gst=%x\n", xcover5_gpu_state, xcover5_gpu_pd[0], xcover5_gpu_pd[1], v[0], v[1], v[2],
+	    v[3], v[4], v[5], v[6], v[7], v[8]);
+	IOLog("XC5 gpu shader=%x tiler=%x l2=%x ready %x/%x/%x coh=%x tls=%x afbc=%x\n",
+	    v[9], v[10], v[11], v[12], v[13], v[14], v[15], v[16], v[17]);
+	IOLog("XC5 gpusvc state=%u clients=%u bos=%u jobs=%u failed=%u selftest=%u (%u us)\n",
+	    xcover5_gpusvc[0], xcover5_gpusvc[1], xcover5_gpusvc[2], xcover5_gpusvc[3],
+	    xcover5_gpusvc[4], xcover5_gpusvc[5], xcover5_gpusvc[6]);
+	const uint32_t *ds = xcover5_drop_state;
+	IOLog("XC5 drop state=%u written=%u failed=%u bbd launches=%u inserted=%u\n",
+	    ds[2], ds[0], ds[1], ds[3], ds[4]);
+	if (xc5_wlbt_heartbeat) {
+		xc5_wlbt_heartbeat();
+	}
+	if (xcover5_gl_exit[0] != 0) {
+		IOLog("XC5 GL exit pid=%u status=0x%x ns=%u code=0x%x\n", xcover5_gl_exit[0],
+		    xcover5_gl_exit[1], xcover5_gl_exit[2], xcover5_gl_exit[3]);
+	}
+	IOLog("XC5 amfi svc=%u open=%u(%s) sel0-7=%u,%u,%u,%u,%u,%u,%u,%u(%s) dev=%u(%s)\n",
+	    xcover5_amfi_svc[0], xcover5_amfi_svc[1], xcover5_amfi_last[0],
+	    xcover5_amfi_sel[0], xcover5_amfi_sel[1], xcover5_amfi_sel[2], xcover5_amfi_sel[3],
+	    xcover5_amfi_sel[4], xcover5_amfi_sel[5], xcover5_amfi_sel[6], xcover5_amfi_sel[7],
+	    xcover5_amfi_last[1], xcover5_amfi_dev_reads, xcover5_amfi_dev_last);
+	IOLog("XC5 amfi sys %d:%u(%s) %d:%u(%s) %d:%u(%s) %d:%u(%s) %d:%u(%s) %d:%u(%s)\n",
+	    xcover5_amfi_callno[0], xcover5_amfi_callcnt[0], xcover5_amfi_calllast[0],
+	    xcover5_amfi_callno[1], xcover5_amfi_callcnt[1], xcover5_amfi_calllast[1],
+	    xcover5_amfi_callno[2], xcover5_amfi_callcnt[2], xcover5_amfi_calllast[2],
+	    xcover5_amfi_callno[3], xcover5_amfi_callcnt[3], xcover5_amfi_calllast[3],
+	    xcover5_amfi_callno[4], xcover5_amfi_callcnt[4], xcover5_amfi_calllast[4],
+	    xcover5_amfi_callno[5], xcover5_amfi_callcnt[5], xcover5_amfi_calllast[5]);
+	for (uint32_t i = xcover5_gpusvc_line > 4 ? xcover5_gpusvc_line - 4 : 0;
+	    i < xcover5_gpusvc_line; i++) {
+		IOLog("XC5 mesa: %s\n", xcover5_gpusvc_lines[i % 4]);
+	}
+	const uint32_t (*j)[5] = xcover5_gpu_jobres;
+	IOLog("XC5 gpu step=%u job1 irq=%x js=%x flt=%x hdr=%x w=%x job2 irq=%x js=%x flt=%x "
+	    "hdr=%x w=%x\n", xcover5_gpu_step, j[0][0], j[0][1], j[0][2], j[0][3], j[0][4],
+	    j[1][0], j[1][1], j[1][2], j[1][3], j[1][4]);
+}
+
+static void
+xcover5_timer_state(const char *when)
+{
+	uint64_t ctl = __builtin_arm_rsr64("CNTP_CTL_EL0");
+	uint64_t cval = __builtin_arm_rsr64("CNTP_CVAL_EL0");
+	uint64_t now = __builtin_arm_rsr64("CNTPCT_EL0");
+	IOLog("XC5 TIMER %s: cntp_ctl=%llx cval=%llx now=%llx daif=%llx\n", when,
+	    ctl, cval, now, (uint64_t)__builtin_arm_rsr64("DAIF"));
+	a5xelte_gic_diagnostics(0, when);
+}
+
+static void
+xcover5_heartbeat(__unused void *arg, __unused wait_result_t wr)
+{
+	IOLog("XC5 heartbeat thread up, klog=%u\n", xcover5_klog_size());
+	xcover5_timer_state("before");
+	IODelay(200000);
+	xcover5_timer_state("after 200ms busy");
+	xcover5_gpu_probe();
+	for (unsigned n = 1;; n++) {
+		IOSleep(5000);
+		IOLog("XC5 heartbeat %u t=%llu klog=%u emmc rd=%llu dma=%llu wr=%llu "
+		    "fb swap=%llu present=%llu vsync=%llu off=%d\n", n,
+		    mach_absolute_time(), xcover5_klog_size(), xcover5_emmc_reads,
+		    xcover5_emmc_dma_reads, xcover5_emmc_writes, xcover5_fb_swaps, xcover5_fb_presents,
+		    xcover5_fb_vsyncs, xcover5_fb_off);
+		xcover5_cpu_report();
+		xcover5_gpu_report();
+		IOLog("XC5 dma on=%d err=%u last=%d checks=%u rint=%x ids=%x bmod=%x ctrl=%x "
+		    "dsc=%x buf=%x tbb=%x st=%x\n", xcover5_emmc_dma_on,
+		    emmc_dma_errors, xcover5_emmc_dma_last_error, xcover5_emmc_dma_checks_left,
+		    xcover5_emmc_dma_diag[0], xcover5_emmc_dma_diag[1], xcover5_emmc_dma_diag[2],
+		    xcover5_emmc_dma_diag[3], xcover5_emmc_dma_diag[4], xcover5_emmc_dma_diag[5],
+		    xcover5_emmc_dma_diag[6], xcover5_emmc_dma_diag[7]);
+		IOLog("XC5 aks sel7=%u sel8=%u sel26=%u sel27=%u sel17=%u throttle=%d\n",
+		    xcover5_aks_calls[7], xcover5_aks_calls[8], xcover5_aks_calls[26],
+		    xcover5_aks_calls[27], xcover5_aks_calls[17], lowpri_throttle_enabled);
+		if (n % 2 == 0) {
+			xcover5_task_report("SpringBoard");
+		} else {
+			xcover5_task_report("backboardd");
+		}
+	}
+}
