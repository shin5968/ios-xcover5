+/* Per CPU: timer, IPI and other IRQs (XC5 heartbeat). */
+uint32_t xcover5_irqs[MAX_CPUS][3];
+/* Boot 30: CPUs kept running kernel_task tid 133 at priority 81; the
+ * pc each CPU was interrupted at shows what that kernel code is. */
+uint64_t xcover5_irq_pc[MAX_CPUS];
+extern char *proc_name_address(void *p);
+void xcover5_cpu_report(void);
+
+void
+xcover5_cpu_report(void)
+{
+	for (int i = 0; i <= ml_get_max_cpu_number() && i < MAX_CPUS; i++) {
+		cpu_data_t *cdp = cpu_datap(i);
+		if (cdp == NULL) {
+			continue;
+		}
+		thread_t th = cdp->cpu_active_thread;
+		task_t task = th ? get_threadtask(th) : TASK_NULL;
+		void *p = task ? get_bsdtask_info(task) : NULL;
+		processor_t pr = cpu_to_processor(i);
+		uint64_t ipc = xcover5_irq_pc[i];
+		printf("XC5 cpu%d tmr=%u ipi=%u irq=%u run=%s tid=%llu st=%d pri=%d ipc=%llx\n", i,
+		    xcover5_irqs[i][0], xcover5_irqs[i][1], xcover5_irqs[i][2],
+		    p ? proc_name_address(p) : (task ? "kernel" : "-"),
+		    th ? thread_tid(th) : 0ULL, pr ? (int)pr->state : -1,
+		    pr ? (int)pr->current_pri : -1,
+		    ipc >= vm_kernel_slide + VM_MIN_KERNEL_ADDRESS ? ipc - vm_kernel_slide : ipc);
+	}
+}
+
+/* First threads of a named task: state, block hint (kern/block_hint.h),
+ * priority and user pc/lr. Shows where SpringBoard/backboardd wait. */
+void xcover5_task_report(const char *want);
+void
+xcover5_task_report(const char *want)
+{
+	task_t task;
+	lck_mtx_lock(&tasks_threads_lock);
+	queue_iterate(&tasks, task, task_t, tasks) {
+		void *p = get_bsdtask_info(task);
+		if (p == NULL || strcmp(proc_name_address(p), want) != 0) {
+			continue;
+		}
+		thread_t th;
+		int n = 0;
+		task_lock(task);
+		queue_iterate(&task->threads, th, thread_t, task_threads) {
+			if (n++ >= 6) {
+				break;
+			}
+			arm_saved_state_t *us = th->machine.upcb;
+			printf("XC5 %s tid=%llu st=%x hint=%d pri=%d pc=%llx lr=%llx\n",
+			    want, thread_tid(th), th->state, (int)th->block_hint, th->sched_pri,
+			    us ? (uint64_t)get_saved_state_pc(us) : 0ULL,
+			    us ? (uint64_t)get_saved_state_lr(us) : 0ULL);
+			/* Boot 29: runnable priority-4 threads did not run for minutes.
+			 * How long since they last ran, and which CPU queues hold them. */
+			if (th->state & TH_RUN) {
+				uint64_t age = mach_absolute_time() - th->last_run_time;
+				printf("XC5   run age=%llums runq=%d bound=%d last=%d mode=%d base=%d sfl=%x\n",
+				    age / 26000, th->runq ? th->runq->cpu_id : -1,
+				    th->bound_processor ? th->bound_processor->cpu_id : -1,
+				    th->last_processor ? th->last_processor->cpu_id : -1,
+				    (int)th->sched_mode, th->base_pri, th->sched_flags);
+			}
+			/* Uninterruptible waits (boot 25: only with cpus=4): where in
+			 * the kernel, as unslid addresses for the kernel symbols. */
+			vm_offset_t top = th->machine.kstackptr;
+			if ((th->state & TH_UNINT) && top != 0) {
+				arm_kernel_saved_state_t *ks =
+				    &((thread_kernel_state_t)top)->machine.ss;
+				uint64_t pcs[5] = { ks->lr, 0, 0, 0, 0 };
+				uint64_t fp = ks->fp;
+				for (int k = 1; k < 5; k++) {
+					if (fp < top - kernel_stack_size || fp + 16 > top || (fp & 7)) {
+						break;
+					}
+					pcs[k] = ((uint64_t *)fp)[1];
+					fp = ((uint64_t *)fp)[0];
+				}
+				printf("XC5   kbt %llx %llx %llx %llx %llx ev=%llx\n",
+				    pcs[0] ? pcs[0] - vm_kernel_slide : 0, pcs[1] ? pcs[1] - vm_kernel_slide : 0,
+				    pcs[2] ? pcs[2] - vm_kernel_slide : 0, pcs[3] ? pcs[3] - vm_kernel_slide : 0,
+				    pcs[4] ? pcs[4] - vm_kernel_slide : 0, (uint64_t)th->wait_event);
+			}
+		}
+		task_unlock(task);
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+}
