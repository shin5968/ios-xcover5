+ * Darwin's Wi-Fi side -- wifid, and through it Settings and the status bar -- talks to a Wi-Fi
+ * driver in requests that were once ioctls and are, where the driver offers no user client,
+ * ioctls still: SIOCGA80211 and SIOCSA80211 on any socket, with a struct apple80211req that
+ * names the interface, a request type, a value, and a buffer in the caller's memory
+ * (IO80211.framework: Apple80211Get/Set and their kin all end there). XNU hands an interface
+ * ioctl it does not know to the interface, so they arrive in drivers/net/hakios.net.c, which
+ * passes them here when its link is a radio.
+ *
+ * What is asked is answered from the station boundary (sys/hakios.sta.h): the radio's power,
+ * its channels, a scan and what it heard, the network joined. What happens there by itself is
+ * told to Darwin the way a driver tells it: kernel events of class 6 (IEEE 802.11), subclass 1,
+ * whose code is Apple80211's own event number and whose data begins with the interface's name
+ * in 16 bytes (IO80211.framework reads them from a PF_SYSTEM socket and compares the name).
+ *
+ * Every request is still written to the log -- who asks, get or set, the type, the value, the
+ * length -- because which of them wifid needs is found that way. Never what a request carries:
+ * a network's name or its key may be in there.
+ *
+ * The request types and the layouts are Apple's. The old ones are as the headers of its open
+ * IO80211 sources once described them (apple80211_ioctl.h, apple80211_var.h); where Darwin userland 16.5
+ * differs the layout was read out of IO80211.framework of 16.5, which fills and reads the same
+ * structures on the other side (Apple80211GetWithIOCTL, _getScanData, _addScanResultToList,
+ * _performAssociation, _dispatchAsyncAssocEvent, _dispatchLinkChangedEvent).
+ *
+ * A join: ASSOCIATE (20) carries the network's name, perhaps its access point, and the
+ * passphrase as typed (the framework does not make the key of it), and is answered at once;
+ * when the station has joined or failed, event 9 says so, and ASSOCIATE_RESULT (21) gives the
+ * outcome as one of Apple80211's result numbers, which the framework turns into its errors:
+ * 1 success, 21 "invalid PMK" (a wrong passphrase), 9 a timeout, 2 anything else.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <sys/errno.h>
+#include <sys/kern_event.h>
+#include <sys/kernel.h>
+#include <sys/proc.h>
+#include <sys/hakios.input.h>
+#include <sys/hakios.net.h>
+#include <sys/hakios.sta.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+#define SIOCSA80211             0x802869c8u     /* _IOW('i', 200, struct apple80211req) */
+#define SIOCGA80211             0xc02869c9u     /* _IOWR('i', 201, struct apple80211req) */
+
+struct apple80211req {
+	char req_if_name[16];
+	int32_t req_type;
+	int32_t req_val;
+	uint32_t req_len;
+	user_addr_t req_data __attribute__((aligned(8)));
+};
+
+/* (as far as they have come by: the names help reading the log) */
+static const char *
+type_name(int32_t type)
+{
+	static const struct {
+		int32_t type;
+		const char *name;
+	} names[] = {
+		{ 1, "SSID" }, { 2, "AUTH_TYPE" }, { 3, "CIPHER_KEY" }, { 4, "CHANNEL" }, { 5, "POWERSAVE" }, { 6, "PROTMODE" },
+		{ 7, "TXPOWER" }, { 8, "RATE" }, { 9, "BSSID" }, { 10, "SCAN_REQ" }, { 11, "SCAN_RESULT" }, { 12, "CARD_CAPABILITIES" },
+		{ 13, "STATE" }, { 14, "PHY_MODE" }, { 15, "OP_MODE" }, { 16, "RSSI" }, { 17, "NOISE" }, { 18, "INT_MIT" }, { 19, "POWER" },
+		{ 20, "ASSOCIATE" }, { 21, "ASSOCIATE_RESULT" }, { 22, "DISASSOCIATE" }, { 23, "STATUS_DEV_NAME" }, { 24, "IBSS_MODE" },
+		{ 25, "HOST_AP_MODE" }, { 26, "AP_MODE" }, { 27, "SUPPORTED_CHANNELS" }, { 28, "LOCALE" }, { 29, "DEAUTH" },
+		{ 30, "COUNTERMEASURES" }, { 32, "RATE_SET" }, { 42, "STATION_LIST" }, { 43, "DRIVER_VERSION" },
+		{ 44, "HARDWARE_VERSION" }, { 46, "RSN_IE" }, { 47, "BACKGROUND_SCAN" }, { 48, "AP_IE_LIST" }, { 49, "STATS" },
+		{ 50, "ASSOCIATION_STATUS" }, { 51, "COUNTRY_CODE" }, { 54, "RADIO_INFO" }, { 57, "MCS" }, { 66, "MCS_INDEX_SET" },
+		{ 79, "STA_STATS" }, { 80, "ROAM_THRESH" }, { 85, "IE" }, { 86, "SCAN_REQ_MULTIPLE" }, { 87, "BTCOEX_MODE" },
+		{ 90, "SCANCACHE_CLEAR" }, { 94, "VIRTUAL_IF_CREATE" }, { 95, "VIRTUAL_IF_DELETE" }, { 103, "CURRENT_NETWORK" },
+		{ 106, "RSSI_BOUNDS" }, { 107, "ROAM" }, { 207, "CHANNELS_INFO" }, { 254, "HW_SUPPORTED_CHANNELS" },
+	};
+
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (names[i].type == type) {
+			return names[i].name;
+		}
+	}
+	return "?";
+}
+
+/* ---- the layouts ------------------------------------------------------------------------------------------ */
+
+#define CHANNEL_20MHZ           0x2u
+#define CHANNEL_2GHZ            0x8u
+#define CHANNEL_5GHZ            0x10u
+#define CHANNEL_ACTIVE          0x80u           /* the radio may send there */
+#define CHANNEL_DFS             0x100u
+
+struct apple80211_channel {
+	uint32_t version, channel, flags;
+};
+
+/* SUPPORTED_CHANNELS (27) and HW_SUPPORTED_CHANNELS (254): 4824 bytes */
+struct apple80211_channels {
+	uint32_t version, count;
+	struct apple80211_channel channels[401];
+	uint32_t unused;
+};
+
+/* CHANNELS_INFO (207): 10016 bytes; of each channel a byte in each of several rows, and a word of flags */
+struct apple80211_channels_info {
+	uint8_t unknown_0[12];
+	uint16_t count;
+	uint8_t unknown_1[800];
+	uint8_t number[400], indoor[400], dfs[400], passive[400], wide_40[400], wide_80[400];
+	uint8_t unknown_2[1602];
+	uint32_t flags[400];
+	uint8_t unknown_3[3600];
+} __attribute__((packed));
+
+/* SCAN_REQ (10): 5456 bytes */
+struct apple80211_scan_request {
+	uint32_t version, bss_type;
+	uint8_t bssid[6], unused_0[2];
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint32_t scan_type;                     /* 1: asking, 2: listening only */
+	uint32_t phy_mode;
+	uint16_t dwell_ms, unused_1;
+	uint32_t rest_ms;
+	uint32_t channel_count;
+	struct apple80211_channel channels[400];
+	uint64_t flags;
+	uint32_t unused_2;
+	uint32_t name_count;                    /* networks asked for by name, each in 56 bytes */
+	uint8_t names[10][56];
+	uint32_t short_ssid, unused_3;
+};
+
+/* SCAN_RESULT (11) and CURRENT_NETWORK (103): 1164 bytes */
+struct apple80211_scan_result {
+	uint32_t version;
+	struct apple80211_channel channel;
+	uint16_t noise_known;
+	int16_t noise, snr, rssi;
+	uint16_t beacon_interval, capability;
+	uint8_t bssid[6];
+	uint8_t rate_count, unused_0;
+	uint32_t rates[15];                     /* Mbit/s */
+	uint8_t ssid_length, ssid[32], unused_1[3];
+	uint32_t age_ms;
+	uint8_t flags, unused_2;
+	uint16_t elements_length;               /* comes in as the room there is */
+	uint8_t elements[1024];
+};
+
+/* ASSOCIATE (20): 592 bytes; of what follows the key (the RSN element wifid built, flags) nothing is used */
+struct apple80211_assoc {
+	uint32_t version;
+	uint16_t mode, auth_lower, auth_upper, unused_0;
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint8_t bssid[6], unused_1[2];
+	uint32_t key_version, key_length, key_cipher;   /* cipher 10: a passphrase as typed; 6: the key (from 64 hex digits) */
+	uint16_t key_flags, key_index;
+	uint8_t key[64];
+	uint8_t rest[0x250 - 0x88];
+};
+
+#define CIPHER_PMK              6
+#define CIPHER_PASSPHRASE       10
+
+/* the link event's data (at least 32 bytes, or the framework drops the event) */
+struct apple80211_link_changed {
+	uint8_t down, unused_0[3];
+	int32_t rssi;
+	uint16_t snr, noise;
+	uint8_t unused_1[4];
+	uint8_t involuntary, unused_2[3];
+	uint32_t reason, subreason;
+	uint8_t unused_3[4];
+};
+
+_Static_assert(sizeof(struct apple80211_assoc) == 592 && offsetof(struct apple80211_assoc, key) == 0x48,
+    "the association request as Darwin userland 16.5 has it");
+_Static_assert(sizeof(struct apple80211_link_changed) == 32 && offsetof(struct apple80211_link_changed, reason) == 0x14,
+    "the link event as Darwin userland 16.5 reads it");
+_Static_assert(sizeof(struct apple80211_channels) == 4824, "the channel list as Darwin userland 16.5 has it");
+_Static_assert(sizeof(struct apple80211_channels_info) == 10016 && offsetof(struct apple80211_channels_info, number) == 0x32e &&
+    offsetof(struct apple80211_channels_info, flags) == 0x12d0, "the channels' description as Darwin userland 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_request) == 5456 && offsetof(struct apple80211_scan_request, channels) == 0x48 &&
+    offsetof(struct apple80211_scan_request, flags) == 0x1308 && offsetof(struct apple80211_scan_request, names) == 0x1318,
+    "the scan request as Darwin userland 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_result) == 1164 && offsetof(struct apple80211_scan_result, ssid_length) == 0x60 &&
+    offsetof(struct apple80211_scan_result, age_ms) == 0x84 && offsetof(struct apple80211_scan_result, elements) == 0x8c,
+    "a scan's result as Darwin userland 16.5 has it");
+
+/* Apple80211's events (APPLE80211_M_...) */
+enum { EVENT_POWER_CHANGED = 1, EVENT_SSID_CHANGED = 2, EVENT_BSSID_CHANGED = 3, EVENT_LINK_CHANGED = 4, EVENT_ASSOC_DONE = 9,
+       EVENT_SCAN_DONE = 10 };
+
+static const char interface_name[16] = "en0";   /* (drivers/net/hakios.net.c makes one interface, and that is its name) */
+
+static LCK_GRP_DECLARE(apple80211_lock_group, "hakios-apple80211");
+static LCK_MTX_DECLARE(apple80211_lock, &apple80211_lock_group);
+static unsigned result_next;                    /* which of what the last scan heard a SCAN_RESULT request gets next */
+static uint32_t join_result;                    /* of the last join asked for: 0 while it runs, then Apple80211's number */
+
+/* ---- channels ---------------------------------------------------------------------------------------- */
+
+static unsigned
+channel_number(unsigned frequency)
+{
+	return frequency == 2484 ? 14 : frequency < 4000 ? (frequency - 2407) / 5 : (frequency - 5000) / 5;
+}
+
+static unsigned
+channel_frequency(const struct apple80211_channel *channel)
+{
+	bool low = channel->flags & CHANNEL_2GHZ ? true : channel->flags & CHANNEL_5GHZ ? false : channel->channel <= 14;
+
+	if (channel->channel == 0 || channel->channel > 196 || (channel->flags & 0x2000)) {     /* (0x2000: 6 GHz) */
+		return 0;
+	}
+	return low ? (channel->channel == 14 ? 2484 : 2407 + 5 * channel->channel) : 5000 + 5 * channel->channel;
+}
+
+static void
+channel_fill(struct apple80211_channel *channel, unsigned frequency, unsigned flags)
+{
+	channel->version = 1;
+	channel->channel = channel_number(frequency);
+	channel->flags = CHANNEL_20MHZ | (frequency < 4000 ? CHANNEL_2GHZ : CHANNEL_5GHZ) | (flags & HAKIOS_STA_CHANNEL_PASSIVE ?
+	    0 : CHANNEL_ACTIVE) | (flags & HAKIOS_STA_CHANNEL_RADAR ? CHANNEL_DFS : 0);
+}
+
+/* ---- what the caller is given back ------------------------------------------------------------------- */
+
+/* At most as many bytes as it has room for. */
+static int
+give(const struct apple80211req *request, const void *data, size_t length)
+{
+	return request->req_data == USER_ADDR_NULL ? 0 : copyout(data, request->req_data, length < request->req_len ? length :
+	       request->req_len);
+}
+
+/* An access point in the form a scan's result has; the caller has said how much room for elements there is. */
+static int
+give_network(const struct apple80211req *request, const struct hakios_sta_bss *bss)
+{
+	struct apple80211_scan_result *result = kalloc_data(sizeof(*result), Z_WAITOK | Z_ZERO);
+	unsigned room = sizeof(result->elements);
+	int error;
+
+	if (result == NULL) {
+		return ENOMEM;
+	}
+	if (request->req_len >= sizeof(*result) && copyin(request->req_data, result, offsetof(struct apple80211_scan_result,
+	    elements)) == 0 && result->elements_length < room) {
+		room = result->elements_length;
+	}
+	bzero(result, sizeof(*result));
+	result->version = 1;
+	channel_fill(&result->channel, bss->frequency, 0);
+	result->rssi = bss->rssi;
+	result->beacon_interval = bss->beacon_interval;
+	result->capability = bss->capability;
+	memcpy(result->bssid, bss->bssid, sizeof(result->bssid));
+	result->ssid_length = bss->ssid_length;
+	memcpy(result->ssid, bss->ssid, bss->ssid_length);
+	result->age_ms = bss->age_ms;
+	result->elements_length = (uint16_t)(bss->elements_length <= room ? bss->elements_length : 0);
+	memcpy(result->elements, bss->elements, result->elements_length);
+	/* the rates it says it has (elements 1 and 50: units of 500 kbit/s, the top bit marks the ones everybody must have) */
+	for (unsigned at = 0; at + 2 <= bss->elements_length && at + 2 + bss->elements[at + 1] <= bss->elements_length;
+	    at += 2 + bss->elements[at + 1]) {
+		for (unsigned i = 0; (bss->elements[at] == 1 || bss->elements[at] == 50) && i < bss->elements[at + 1]; i++) {
+			unsigned rate = (bss->elements[at + 2 + i] & 0x7f) / 2;
+
+			if (rate != 0 && rate <= 54 && result->rate_count < 15) {
+				result->rates[result->rate_count++] = rate;
+			}
+		}
+	}
+	error = give(request, result, sizeof(*result));
+	kfree_data(result, sizeof(*result));
+	return error;
+}
+
+/* ---- get ---------------------------------------------------------------------------------------------- */
+
+static int
+get(struct apple80211req *request)
+{
+	struct hakios_sta_state *state;
+	int error = 0;
+
+	switch (request->req_type) {
+	case 43:
+	case 44: {                              /* the driver's and the hardware's name: the text alone, in 256 bytes */
+		static const char name[256] = "hakios: ath11k for the WCN6750";
+
+		return give(request, name, sizeof(name));
+	}
+	case 12: {
+		/*
+		 * What the card can do, a bit each (apple80211_var.h: APPLE80211_CAP_*): the 13 bytes are the
+		 * bits alone, from the first (the framework hands in a buffer that begins after the old
+		 * header's version word). AES, AES-CCM, power management, short slot and preamble, WPA2, WME,
+		 * short guard interval at 20 MHz. Read wrong, the framework sees no WPA2 and builds no join
+		 * for a WPA2 network ("Unable to join").
+		 */
+		uint8_t bits[13] = { 0 };
+		static const uint8_t has[] = { 2, 3, 6, 9, 10, 14, 17, 19 };
+
+		for (unsigned i = 0; i < sizeof(has); i++) {
+			bits[has[i] / 8] |= (uint8_t)(1u << (has[i] % 8));
+		}
+		return give(request, bits, sizeof(bits));
+	}
+	case 19: {                              /* the radio's power: one radio. Until the driver is up it counts as on: it */
+		struct {                        /* is being brought up, and Darwin asks this once, early */
+			uint32_t version, radios, state[4];
+		} answer = { .version = 1, .radios = 1, .state = { !hakios_sta_present() || hakios_sta_powered() } };
+
+		return give(request, &answer, sizeof(answer));
+	}
+	case 15:                                /* the mode: a station (APPLE80211_M_STA) */
+		request->req_val = 1;
+		return 0;
+	case 27:
+	case 254: {                             /* the channels the radio may tune to */
+		struct apple80211_channels *answer;
+		struct hakios_sta_channel channels[96];
+		unsigned count = hakios_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->version = 1;
+		answer->count = count;
+		for (unsigned i = 0; i < count; i++) {
+			channel_fill(&answer->channels[i], channels[i].frequency, channels[i].flags);
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 207: {                             /* ... and more of each */
+		struct apple80211_channels_info *answer;
+		struct hakios_sta_channel channels[96];
+		unsigned count = hakios_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->count = (uint16_t)count;
+		for (unsigned i = 0; i < count; i++) {
+			struct apple80211_channel channel;
+
+			channel_fill(&channel, channels[i].frequency, channels[i].flags);
+			answer->number[i] = (uint8_t)channel.channel;
+			answer->dfs[i] = (channels[i].flags & HAKIOS_STA_CHANNEL_RADAR) != 0;
+			answer->passive[i] = (channels[i].flags & HAKIOS_STA_CHANNEL_PASSIVE) != 0;
+			answer->flags[i] = channel.flags;
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 21:                                /* how the last join went (0: not over yet) */
+		lck_mtx_lock(&apple80211_lock);
+		request->req_val = (int32_t)join_result;
+		lck_mtx_unlock(&apple80211_lock);
+		return 0;
+	case 11: {                              /* what the last scan heard, one access point a request; EIO: that was all */
+		struct hakios_sta_bss *bss = kalloc_data(sizeof(*bss), Z_WAITOK);
+		unsigned index;
+		bool there;
+
+		if (bss == NULL) {
+			return ENOMEM;
+		}
+		lck_mtx_lock(&apple80211_lock);
+		index = result_next++;
+		lck_mtx_unlock(&apple80211_lock);
+		there = hakios_sta_heard(index, bss);
+		error = there ? give_network(request, bss) : EIO;
+		kfree_data(bss, sizeof(*bss));
+		return error;
+	}
+	default:
+		break;
+	}
+
+	/* the rest is about the network joined, and there is none unless the station says so */
+	if ((state = kalloc_data(sizeof(*state), Z_WAITOK)) == NULL) {
+		return ENOMEM;
+	}
+	hakios_sta_state(state);
+	switch (request->req_type) {
+	case 13:                                /* the state: APPLE80211_S_INIT 0, _SCAN 1, _AUTH 2, _ASSOC 3, _RUN 4 */
+		request->req_val = state->phase == HAKIOS_STA_JOINED ? 4 : state->phase == HAKIOS_STA_JOINING ? 2 :
+		    state->phase == HAKIOS_STA_SCANNING ? 1 : 0;
+		break;
+	case 1:                                 /* its name; the length goes back in the request */
+		if (state->phase != HAKIOS_STA_JOINED) {
+			error = ENXIO;
+		} else if ((error = give(request, state->bss.ssid, state->bss.ssid_length)) == 0) {
+			request->req_len = state->bss.ssid_length;
+		}
+		break;
+	case 9:                                 /* its access point's address */
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give(request, state->bss.bssid, 6);
+		break;
+	case 4: {                               /* its channel */
+		struct {
+			uint32_t version;
+			struct apple80211_channel channel;
+		} answer = { .version = 1 };
+
+		if (state->phase != HAKIOS_STA_JOINED) {
+			error = ENXIO;
+		} else {
+			channel_fill(&answer.channel, state->bss.frequency, 0);
+			error = give(request, &answer, sizeof(answer));
+		}
+		break;
+	}
+	case 16: {                              /* how strongly it is heard: dBm, per radio and all together, twice over */
+		struct {
+			uint32_t version, radios, unit;
+			int32_t each[4], all, each_ext[4], all_ext;
+		} answer = { .version = 1, .radios = 1, .each = { state->bss.rssi }, .all = state->bss.rssi,
+			     .each_ext = { state->bss.rssi }, .all_ext = state->bss.rssi };
+
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 103:                               /* all of it, as a scan's result */
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give_network(request, &state->bss);
+		break;
+	case 2: {                               /* how it was joined: open system, then WPA2 with a passphrase -- or */
+		struct {                        /* nothing more, for a network whose beacon has no RSN element (48) */
+			uint32_t version, lower, upper, extended;
+		} answer = { .version = 1, .lower = 1, .upper = 8 };
+		bool secured = false;
+
+		for (unsigned at = 0; at + 2 <= state->bss.elements_length; at += 2 + state->bss.elements[at + 1]) {
+			secured |= state->bss.elements[at] == 48;
+		}
+		if (!secured && state->bss.elements_length != 0) {
+			answer.upper = 0;
+		}
+
+		error = state->phase != HAKIOS_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	default:
+		error = EOPNOTSUPP;
+		break;
+	}
+	kfree_data(state, sizeof(*state));
+	return error;
+}
+
+/* ---- set ---------------------------------------------------------------------------------------------- */
+
+static int
+set_scan(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_scan_request *asked;
+	struct hakios_sta_scan *what;
+	unsigned unknown = 0;
+	int error;
+
+	if (request->req_len != sizeof(*asked)) {
+		return EINVAL;
+	}
+	if (!hakios_sta_present()) {
+		return EBUSY;                   /* (the radio is still being brought up: the framework tries again) */
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, sizeof(*asked))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	if (asked->ssid_length <= sizeof(what->ssid)) {
+		what->ssid_length = (uint8_t)asked->ssid_length;
+		memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	}
+	what->passive = asked->scan_type == 2;
+	what->dwell_ms = asked->dwell_ms;
+	/* (more channels than there is room to name: every channel) */
+	for (unsigned i = 0; i < asked->channel_count && i < 400 && asked->channel_count <= 64; i++) {
+		unsigned frequency = channel_frequency(&asked->channels[i]);
+
+		if (frequency != 0) {
+			what->frequencies[what->frequency_count++] = (uint16_t)frequency;
+		} else {
+			unknown++;
+		}
+	}
+	snprintf(said, said_size, " (a scan: type %u, %u channels of which %u are not the radio's, %u ms on each, a name of %u bytes, "
+	    "%u more names, flags %#llx)", asked->scan_type, asked->channel_count, unknown, asked->dwell_ms, asked->ssid_length,
+	    asked->name_count, asked->flags);
+	if (asked->channel_count != 0 && asked->channel_count <= 64 && what->frequency_count == 0) {
+		error = EINVAL;                 /* (nothing of what is asked for is a channel of this radio's) */
+	} else {
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		error = hakios_sta_ask_scan(what);
+	}
+out:
+	if (asked != NULL) {
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set_join(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_assoc *asked;
+	struct hakios_sta_join *what;
+	int error;
+
+	if (request->req_len < offsetof(struct apple80211_assoc, rest)) {
+		return EINVAL;
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK | Z_ZERO);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, offsetof(struct apple80211_assoc, rest))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	/* (lengths and kinds only: the name, the access point and the key stay out of the log) */
+	snprintf(said, said_size, " (a join: a name of %u bytes, %s access point, authentication %#x/%#x, a key of %u bytes of kind %u)",
+	    asked->ssid_length, asked->bssid[0] | asked->bssid[1] | asked->bssid[2] | asked->bssid[3] | asked->bssid[4] |
+	    asked->bssid[5] ? "a given" : "any", asked->auth_lower, asked->auth_upper, asked->key_length, asked->key_cipher);
+	if (asked->ssid_length == 0 || asked->ssid_length > sizeof(what->ssid)) {
+		error = EINVAL;
+		goto out;
+	}
+	what->ssid_length = (uint8_t)asked->ssid_length;
+	memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	memcpy(what->bssid, asked->bssid, sizeof(what->bssid));
+	if (asked->key_length == 0) {
+		what->security = HAKIOS_STA_OPEN;
+	} else if (asked->key_cipher == CIPHER_PASSPHRASE && asked->key_length >= 8 && asked->key_length <= 63) {
+		what->security = HAKIOS_STA_WPA2_PSK;
+		what->passphrase_length = (uint8_t)asked->key_length;
+		memcpy(what->passphrase, asked->key, asked->key_length);
+	} else if (asked->key_cipher == CIPHER_PMK && asked->key_length == sizeof(what->pmk)) {
+		what->security = HAKIOS_STA_WPA2_PSK;
+		memcpy(what->pmk, asked->key, sizeof(what->pmk));
+	} else {
+		error = EINVAL;
+		goto out;
+	}
+	lck_mtx_lock(&apple80211_lock);
+	join_result = 0;
+	lck_mtx_unlock(&apple80211_lock);
+	error = hakios_sta_ask_join(what);
+out:
+	if (asked != NULL) {
+		memset_s(asked, sizeof(*asked), 0, sizeof(*asked));
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		memset_s(what, sizeof(*what), 0, sizeof(*what));
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set(const struct apple80211req *request, char *said, size_t said_size)
+{
+	switch (request->req_type) {
+	case 20:
+		return set_join(request, said, said_size);
+	case 22:                                /* leave the network */
+		return hakios_sta_ask_leave();
+	case 19: {                              /* the radio's power */
+		struct {
+			uint32_t version, radios, state[4];
+		} asked;
+		int error;
+
+		if (request->req_len < sizeof(asked) || (error = copyin(request->req_data, &asked, sizeof(asked))) != 0) {
+			return request->req_len < sizeof(asked) ? EINVAL : error;
+		}
+		snprintf(said, said_size, " (power: %s)", asked.state[0] ? "on" : "off");
+		return hakios_sta_ask_power(asked.state[0] != 0);
+	}
+	case 10:
+		return set_scan(request, said, said_size);
+	/*
+	 * Requests of iOS 16's wifid that this driver has no use for (383 every five seconds, 4104 bytes; 365; 419): refused,
+	 * wifid retried 383 for 10-15 s, and Settings stood still that long when a network was chosen. Taken and ignored.
+	 */
+	case 383:
+	case 365:
+	case 419:
+		snprintf(said, said_size, " (taken, ignored)");
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+/* ---- events -------------------------------------------------------------------------------------------- */
+
+static void
+post(uint32_t code, const void *data, uint32_t length)
+{
+	struct kev_msg message = { .vendor_code = KEV_VENDOR_APPLE, .kev_class = KEV_IEEE80211_CLASS, .kev_subclass = 1,
+		                   .event_code = code };
+	char name[16];
+
+	memcpy(name, interface_name, sizeof(name));
+	message.dv[0].data_length = sizeof(name);
+	message.dv[0].data_ptr = name;
+	if (length != 0) {
+		message.dv[1].data_length = length;
+		message.dv[1].data_ptr = __DECONST(void *, data);
+	}
+	kev_post_msg(&message);
+}
+
+/* What the station side says has happened (drivers/wifi/hakios.sta.c calls this, on its thread or the station's). */
+void
+hakios_apple80211_event(enum hakios_sta_event event, int status)
+{
+	static unsigned said;
+
+	if (said < 200) {
+		said++;
+		printf("apple80211: the station says: %s, %d\n", event == HAKIOS_STA_POWER ? "power" : event == HAKIOS_STA_SCAN_DONE ?
+		    "a scan is over" : event == HAKIOS_STA_JOIN_DONE ? "a join is over" : "the link", status);
+	}
+	switch (event) {
+	case HAKIOS_STA_POWER:
+		post(EVENT_POWER_CHANGED, NULL, 0);
+		break;
+	case HAKIOS_STA_SCAN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_SCAN_DONE, NULL, 0);
+		break;
+	case HAKIOS_STA_JOIN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		join_result = status == 0 ? 1 : status == EAUTH ? 21 : status == ETIMEDOUT ? 9 : 2;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_ASSOC_DONE, NULL, 0);
+		break;
+	case HAKIOS_STA_LINK: {
+		struct apple80211_link_changed link = { .down = status != 1, .involuntary = status != 1 && status != 0,
+			                                .reason = status != 1 && status != 0 ? 4 : 0 };      /* (4: gone, not asked) */
+		struct hakios_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+
+		if (state != NULL) {
+			hakios_sta_state(state);
+			link.rssi = status == 1 ? state->bss.rssi : 0;
+			kfree_data(state, sizeof(*state));
+		}
+		post(EVENT_SSID_CHANGED, NULL, 0);
+		post(EVENT_BSSID_CHANGED, NULL, 0);
+		post(EVENT_LINK_CHANGED, &link, sizeof(link));
+		break;
+	}
+	}
+}
+
+/* ---- the requests as they arrive --------------------------------------------------------------------- */
+
+/*
+ * How often each kind of request came and how it fared: said when the run ends, because the
+ * lines said along the way can be lost with the middle of a long log.
+ */
+static struct {
+	int32_t type;
+	bool set;
+	unsigned times, answered;
+	int last_error;
+} kinds[96];
+static unsigned kind_count;
+
+static void
+note(const struct apple80211req *request, bool is_set, int error)
+{
+	unsigned i;
+
+	lck_mtx_lock(&apple80211_lock);
+	for (i = 0; i < kind_count && !(kinds[i].type == request->req_type && kinds[i].set == is_set); i++) {
+	}
+	if (i < sizeof(kinds) / sizeof(kinds[0])) {
+		if (i == kind_count) {
+			kinds[kind_count++] = (typeof(kinds[0])) { .type = request->req_type, .set = is_set };
+		}
+		kinds[i].times++;
+		kinds[i].answered += error == 0;
+		kinds[i].last_error = error != 0 ? error : kinds[i].last_error;
+	}
+	lck_mtx_unlock(&apple80211_lock);
+}
+
+void
+hakios_apple80211_summary(void)
+{
+	static bool said;
+
+	if (said) {
+		return;
+	}
+	said = true;
+	for (unsigned i = 0; i < kind_count; i++) {
+		printf("apple80211: in this run: %s %d (%s) %u times, answered %u times%s", kinds[i].set ? "set" : "get", kinds[i].type,
+		    type_name(kinds[i].type), kinds[i].times, kinds[i].answered, kinds[i].last_error == 0 ? "\n" : "");
+		if (kinds[i].last_error != 0) {
+			printf("; the last refusal: %d%s\n", kinds[i].last_error, kinds[i].last_error == EOPNOTSUPP ? " (not built)" : "");
+		}
+	}
+}
+
+/* An Apple80211 request for the radio's interface, from the process that is running now. */
+errno_t
+hakios_apple80211_ioctl(u_long command, void *data)
+{
+	static unsigned said;
+	struct apple80211req *request = data;
+	char who[32] = "?", what[200] = "";
+	bool is_set = command == SIOCSA80211;
+	int error;
+
+	if (command != SIOCSA80211 && command != SIOCGA80211) {
+		return EOPNOTSUPP;
+	}
+	proc_selfname(who, sizeof(who));
+	error = is_set ? set(request, what, sizeof(what)) : get(request);
+	note(request, is_set, error);
+	/*
+	 * (a request that is repeated for ever is said a few hundred times)
+	 * XCover5: wifid asks CURRENT_NETWORK every second and that filled the RAM log (wifi58); a request is said the
+	 * first two times it gets an answer it did not get before. A scan or a join (set 10, 20) is always said.
+	 */
+	static uint16_t told[2][512];
+	static int told_error[2][512];
+	uint32_t kind = (uint32_t)request->req_type, side = is_set ? 1 : 0;
+	bool tell = said < 800;
+	if (kind < 512) {
+		if (told[side][kind] != 0 && told_error[side][kind] != error) {
+			told[side][kind] = 0;
+		}
+		told_error[side][kind] = error;
+		if (told[side][kind] < 2) {
+			told[side][kind]++;
+		} else if (!(is_set && (kind == 10 || kind == 20))) {
+			tell = false;
+		}
+	}
+	if (tell) {
+		said++;
+		printf("apple80211: %s %s %d (%s), value %d, %u bytes%s: %s", who, is_set ? "sets" : "gets", request->req_type,
+		    type_name(request->req_type), request->req_val, request->req_len, what, error == 0 ? "answered\n" : error ==
+		    EOPNOTSUPP ? "REFUSED\n" : "");
+		if (error != 0 && error != EOPNOTSUPP) {
+			printf("error %d\n", error);
+		}
+	}
+	return error;
+}
diff --git a/bsd/dev/hakios.lx_wpa.c b/bsd/dev/hakios.lx_wpa.c
new file mode 100644
index 0000000..8b7ee71
--- /dev/null
+++ b/bsd/dev/hakios.lx_wpa.c
@@ -0,0 +1,544 @@
+/*
+ * The arithmetic of WPA2 with a passphrase (lx_wpa.h): SHA-1 and HMAC over it (FIPS 180, RFC
+ * 2104), the key of a name and a passphrase (PBKDF2, RFC 8018), the function that makes the
+ * handshake's keys out of that key, two addresses and two nonces (IEEE 802.11-2020, 12.7.1.2),
+ * AES decryption and the unwrapping of a key with it (FIPS 197, RFC 3394), and the messages of
+ * the four-way and the group-key handshake (12.7.6, 12.7.7; figure 12-35 is the layout).
+ *
+ * Nothing here is taken from another implementation; the tests in tools/wpa-test check it
+ * against the standards' own examples and against Python's hashlib and "cryptography".
+ * Nothing here is written for speed, and nothing here says a key in a message.
+ */
+#if defined(_KERNEL) || defined(KERNEL)      /* XCover5: XNU defines KERNEL */
+#include <sys/param.h>
+#include <sys/systm.h>
+#else
+#include <stdint.h>
+#include <string.h>
+#endif
+
+#if defined(_KERNEL) || defined(KERNEL)      /* XCover5: XNU defines KERNEL */
+#include "hakios.lx_wpa.h"		/* drivers/map gives the header the kernel's required name */
+#else
+#include "lx_wpa.h"
+#endif
+
+/* ---- SHA-1 ------------------------------------------------------------------------------------ */
+
+struct sha1 {
+	uint32_t h[5];
+	uint64_t length;			/* bytes so far */
+	uint8_t block[64];
+};
+
+static uint32_t
+rol(uint32_t x, unsigned n)
+{
+	return (x << n | x >> (32 - n));
+}
+
+static void
+sha1_block(uint32_t h[5], const uint8_t *p)
+{
+	uint32_t w[80], a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];
+
+	for (unsigned t = 0; t < 16; t++) {
+		w[t] = (uint32_t)p[4 * t] << 24 | (uint32_t)p[4 * t + 1] << 16 | (uint32_t)p[4 * t + 2] << 8 | p[4 * t + 3];
+	}
+	for (unsigned t = 16; t < 80; t++) {
+		w[t] = rol(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1);
+	}
+	for (unsigned t = 0; t < 80; t++) {
+		uint32_t f = t < 20 ? ((b & c) | (~b & d)) + 0x5a827999 : t < 40 ? (b ^ c ^ d) + 0x6ed9eba1 : t < 60 ?
+		    ((b & c) | (b & d) | (c & d)) + 0x8f1bbcdc : (b ^ c ^ d) + 0xca62c1d6;
+		uint32_t next = rol(a, 5) + f + e + w[t];
+
+		e = d;
+		d = c;
+		c = rol(b, 30);
+		b = a;
+		a = next;
+	}
+	h[0] += a;
+	h[1] += b;
+	h[2] += c;
+	h[3] += d;
+	h[4] += e;
+}
+
+static void
+sha1_begin(struct sha1 *s)
+{
+	s->h[0] = 0x67452301;
+	s->h[1] = 0xefcdab89;
+	s->h[2] = 0x98badcfe;
+	s->h[3] = 0x10325476;
+	s->h[4] = 0xc3d2e1f0;
+	s->length = 0;
+}
+
+static void
+sha1_more(struct sha1 *s, const uint8_t *data, unsigned length)
+{
+	for (unsigned i = 0; i < length; i++) {
+		s->block[s->length++ % 64] = data[i];
+		if (s->length % 64 == 0) {
+			sha1_block(s->h, s->block);
+		}
+	}
+}
+
+static void
+sha1_end(struct sha1 *s, uint8_t digest[20])
+{
+	uint64_t bits = s->length * 8;
+	uint8_t tail[8];
+
+	sha1_more(s, (const uint8_t *)"\x80", 1);
+	while (s->length % 64 != 56) {
+		sha1_more(s, (const uint8_t *)"", 1);
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		tail[i] = (uint8_t)(bits >> (56 - 8 * i));
+	}
+	sha1_more(s, tail, 8);
+	for (unsigned i = 0; i < 20; i++) {
+		digest[i] = (uint8_t)(s->h[i / 4] >> (24 - 8 * (i % 4)));
+	}
+}
+
+/* HMAC-SHA1 of several pieces in a row. */
+static void
+hmac_sha1(const uint8_t *key, unsigned key_length, const uint8_t *const pieces[], const unsigned lengths[], unsigned count,
+    uint8_t digest[20])
+{
+	uint8_t pad[64], hashed[20], inner[20];
+	struct sha1 s;
+
+	if (key_length > 64) {
+		sha1_begin(&s);
+		sha1_more(&s, key, key_length);
+		sha1_end(&s, hashed);
+		key = hashed;
+		key_length = 20;
+	}
+	for (unsigned i = 0; i < 64; i++) {
+		pad[i] = (i < key_length ? key[i] : 0) ^ 0x36;
+	}
+	sha1_begin(&s);
+	sha1_more(&s, pad, 64);
+	for (unsigned i = 0; i < count; i++) {
+		sha1_more(&s, pieces[i], lengths[i]);
+	}
+	sha1_end(&s, inner);
+	for (unsigned i = 0; i < 64; i++) {
+		pad[i] ^= 0x36 ^ 0x5c;
+	}
+	sha1_begin(&s);
+	sha1_more(&s, pad, 64);
+	sha1_more(&s, inner, 20);
+	sha1_end(&s, digest);
+	memset(pad, 0, sizeof(pad));
+	memset(inner, 0, sizeof(inner));
+}
+
+/* ---- the key of a name and a passphrase -------------------------------------------------------- */
+
+/* PBKDF2 with HMAC-SHA1, 4096 rounds, 32 bytes: two blocks of 20, of the second the first 12. */
+void
+lx_wpa_pmk(const unsigned char *passphrase, unsigned passphrase_length, const unsigned char *name, unsigned name_length,
+    unsigned char pmk[32])
+{
+	for (unsigned block = 1; block <= 2; block++) {
+		const uint8_t number[4] = { 0, 0, 0, (uint8_t)block };
+		const uint8_t *first[2] = { name, number };
+		const unsigned first_lengths[2] = { name_length, 4 };
+		uint8_t u[20], sum[20];
+
+		hmac_sha1(passphrase, passphrase_length, first, first_lengths, 2, u);
+		memcpy(sum, u, 20);
+		for (unsigned round = 1; round < 4096; round++) {
+			const uint8_t *again[1] = { u };
+			const unsigned again_lengths[1] = { 20 };
+
+			hmac_sha1(passphrase, passphrase_length, again, again_lengths, 1, u);
+			for (unsigned i = 0; i < 20; i++) {
+				sum[i] ^= u[i];
+			}
+		}
+		memcpy(pmk + 20 * (block - 1), sum, block == 1 ? 20 : 12);
+		memset(u, 0, sizeof(u));
+		memset(sum, 0, sizeof(sum));
+	}
+}
+
+/* The standard's PRF: HMAC-SHA1 of (label, a zero byte, data, a counter byte), block after block. */
+static void
+prf(const uint8_t *key, unsigned key_length, const char *label, const uint8_t *data, unsigned data_length, uint8_t *out,
+    unsigned out_length)
+{
+	uint8_t zero = 0, counter = 0, digest[20];
+	const uint8_t *pieces[4] = { (const uint8_t *)label, &zero, data, &counter };
+	const unsigned lengths[4] = { (unsigned)strlen(label), 1, data_length, 1 };
+
+	for (unsigned done = 0; done < out_length; done += 20, counter++) {
+		hmac_sha1(key, key_length, pieces, lengths, 4, digest);
+		memcpy(out + done, digest, out_length - done < 20 ? out_length - done : 20);
+	}
+	memset(digest, 0, sizeof(digest));
+}
+
+/* ---- AES-128, decryption only, and the unwrapping of a key --------------------------------------- */
+
+static uint8_t sbox[256], inverse_sbox[256];
+
+static uint8_t
+times(uint8_t a, uint8_t b)			/* in GF(2^8) modulo x^8 + x^4 + x^3 + x + 1 */
+{
+	uint8_t product = 0;
+
+	for (; b != 0; b >>= 1) {
+		if (b & 1) {
+			product ^= a;
+		}
+		a = (uint8_t)(a << 1 ^ (a & 0x80 ? 0x1b : 0));
+	}
+	return (product);
+}
+
+/* FIPS 197, 5.1.1: a byte's inverse in the field, then the affine map. */
+static void
+aes_tables(void)
+{
+	if (sbox[0] != 0) {
+		return;
+	}
+	for (unsigned x = 0; x < 256; x++) {
+		uint8_t inverse = 0, s;
+
+		for (unsigned y = 1; y < 256 && x != 0; y++) {
+			if (times((uint8_t)x, (uint8_t)y) == 1) {
+				inverse = (uint8_t)y;
+				break;
+			}
+		}
+		s = inverse;
+		for (unsigned i = 1; i < 5; i++) {
+			s ^= (uint8_t)(inverse << i | inverse >> (8 - i));
+		}
+		s ^= 0x63;
+		sbox[x] = s;
+		inverse_sbox[s] = (uint8_t)x;
+	}
+}
+
+static void
+aes_keys(const uint8_t key[16], uint8_t round_keys[176])
+{
+	uint8_t constant = 1;
+
+	aes_tables();
+	memcpy(round_keys, key, 16);
+	for (unsigned i = 16; i < 176; i += 4) {
+		uint8_t word[4];
+
+		memcpy(word, round_keys + i - 4, 4);
+		if (i % 16 == 0) {
+			uint8_t first = word[0];
+
+			word[0] = sbox[word[1]] ^ constant;
+			word[1] = sbox[word[2]];
+			word[2] = sbox[word[3]];
+			word[3] = sbox[first];
+			constant = times(constant, 2);
+		}
+		for (unsigned j = 0; j < 4; j++) {
+			round_keys[i + j] = round_keys[i - 16 + j] ^ word[j];
+		}
+	}
+}
+
+/* FIPS 197, 5.3: the inverse cipher on one block (bytes in column order: byte r of column c is s[4c + r]). */
+static void
+aes_decrypt(const uint8_t round_keys[176], uint8_t s[16])
+{
+	for (unsigned i = 0; i < 16; i++) {
+		s[i] ^= round_keys[160 + i];
+	}
+	for (int round = 9; round >= 0; round--) {
+		uint8_t t[16];
+
+		for (unsigned c = 0; c < 4; c++) {		/* the rows shifted back, and the bytes substituted back */
+			for (unsigned r = 0; r < 4; r++) {
+				t[4 * ((c + r) % 4) + r] = inverse_sbox[s[4 * c + r]];
+			}
+		}
+		for (unsigned i = 0; i < 16; i++) {
+			t[i] ^= round_keys[16 * round + i];
+		}
+		if (round == 0) {
+			memcpy(s, t, 16);
+			memset(t, 0, sizeof(t));	/* (the last block is part of the key being unwrapped: not left on the stack) */
+			break;
+		}
+		for (unsigned c = 0; c < 4; c++) {		/* the columns mixed back */
+			const uint8_t *a = t + 4 * c;
+
+			s[4 * c + 0] = times(a[0], 14) ^ times(a[1], 11) ^ times(a[2], 13) ^ times(a[3], 9);
+			s[4 * c + 1] = times(a[0], 9) ^ times(a[1], 14) ^ times(a[2], 11) ^ times(a[3], 13);
+			s[4 * c + 2] = times(a[0], 13) ^ times(a[1], 9) ^ times(a[2], 14) ^ times(a[3], 11);
+			s[4 * c + 3] = times(a[0], 11) ^ times(a[1], 13) ^ times(a[2], 9) ^ times(a[3], 14);
+		}
+	}
+}
+
+/*
+ * RFC 3394, 2.2.2: `wrapped` is 8 bytes longer than what comes out, which goes to `plain`. 0, or -1
+ * if the length is not one a wrapped key has or the check value does not come out.
+ */
+static int
+aes_unwrap(const uint8_t kek[16], const uint8_t *wrapped, unsigned length, uint8_t *plain)
+{
+	unsigned n = length / 8 - 1;
+	uint8_t round_keys[176], a[8], block[16];
+	int good = 0;
+
+	if (length % 8 != 0 || length < 24) {
+		return (-1);
+	}
+	aes_keys(kek, round_keys);
+	memcpy(a, wrapped, 8);
+	memcpy(plain, wrapped + 8, 8 * n);
+	for (int j = 5; j >= 0; j--) {
+		for (unsigned i = n; i >= 1; i--) {
+			uint64_t t = (uint64_t)n * (unsigned)j + i;
+
+			memcpy(block, a, 8);
+			for (unsigned k = 0; k < 8; k++) {
+				block[7 - k] ^= (uint8_t)(t >> (8 * k));
+			}
+			memcpy(block + 8, plain + 8 * (i - 1), 8);
+			aes_decrypt(round_keys, block);
+			memcpy(a, block, 8);
+			memcpy(plain + 8 * (i - 1), block + 8, 8);
+		}
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		good |= a[i] ^ 0xa6;
+	}
+	memset(round_keys, 0, sizeof(round_keys));
+	memset(block, 0, sizeof(block));
+	memset(a, 0, sizeof(a));
+	return (good == 0 ? 0 : -1);
+}
+
+/* ---- the handshake -------------------------------------------------------------------------------- */
+
+/*
+ * A key message, after the four bytes every EAPOL frame begins with (version, type 3, length):
+ *   4 the kind of descriptor (2: RSN)     5 what the message is (bits below)     7 key length
+ *   9 replay counter (8)     17 nonce (32)     49 IV (16)     65 RSC (8)     73 reserved (8)
+ *   81 MIC (16)     97 length of the key data     99 key data
+ */
+#define AT_KIND		4
+#define AT_INFO		5
+#define AT_REPLAY	9
+#define AT_NONCE	17
+#define AT_RSC		65
+#define AT_MIC		81
+#define AT_DATA_LENGTH	97
+#define AT_DATA		99
+#define MESSAGE_MOST	640
+
+#define INFO_VERSION	0x0007			/* 2: HMAC-SHA1 for the MIC, the AES key wrap for the key data */
+#define INFO_PAIRWISE	0x0008
+#define INFO_INSTALL	0x0040
+#define INFO_ACK	0x0080
+#define INFO_MIC	0x0100
+#define INFO_SECURE	0x0200
+#define INFO_ENCRYPTED	0x1000
+
+static void
+mic_of(const struct lx_wpa *wpa, const uint8_t *message, unsigned length, uint8_t mic[16])
+{
+	const uint8_t zeros[16] = { 0 };
+	const uint8_t *pieces[3] = { message, zeros, message + AT_MIC + 16 };
+	const unsigned lengths[3] = { AT_MIC, 16, length - AT_MIC - 16 };
+	uint8_t digest[20];
+
+	hmac_sha1(wpa->kck, 16, pieces, lengths, 3, digest);
+	memcpy(mic, digest, 16);
+}
+
+/* The keys of the handshake and the pairwise key, from the PMK, both addresses and both nonces. */
+static void
+derive(struct lx_wpa *wpa)
+{
+	uint8_t data[76], keys[48];
+	int own_first = memcmp(wpa->own, wpa->peer, 6) < 0, own_nonce_first = memcmp(wpa->own_nonce, wpa->peer_nonce, 32) < 0;
+
+	memcpy(data, own_first ? wpa->own : wpa->peer, 6);
+	memcpy(data + 6, own_first ? wpa->peer : wpa->own, 6);
+	memcpy(data + 12, own_nonce_first ? wpa->own_nonce : wpa->peer_nonce, 32);
+	memcpy(data + 44, own_nonce_first ? wpa->peer_nonce : wpa->own_nonce, 32);
+	prf(wpa->pmk, 32, "Pairwise key expansion", data, sizeof(data), keys, sizeof(keys));
+	memcpy(wpa->kck, keys, 16);
+	memcpy(wpa->kek, keys + 16, 16);
+	memcpy(wpa->pairwise, keys + 32, 16);
+	memset(keys, 0, sizeof(keys));
+	wpa->have_keys = 1;
+}
+
+/* Our message in answer to `message`: the same counter, our bits, our nonce and key data if any, signed. */
+static void
+answer(const struct lx_wpa *wpa, const uint8_t *message, unsigned info, const uint8_t *nonce, const uint8_t *data,
+    unsigned data_length, uint8_t *reply, unsigned *reply_length)
+{
+	unsigned length = AT_DATA + data_length;
+
+	memset(reply, 0, length);
+	reply[0] = message[0];
+	reply[1] = 3;
+	reply[2] = (uint8_t)((length - 4) >> 8);
+	reply[3] = (uint8_t)(length - 4);
+	reply[AT_KIND] = 2;
+	reply[AT_INFO] = (uint8_t)(info >> 8);
+	reply[AT_INFO + 1] = (uint8_t)info;
+	memcpy(reply + AT_REPLAY, message + AT_REPLAY, 8);
+	if (nonce != NULL) {
+		memcpy(reply + AT_NONCE, nonce, 32);
+	}
+	reply[AT_DATA_LENGTH] = (uint8_t)(data_length >> 8);
+	reply[AT_DATA_LENGTH + 1] = (uint8_t)data_length;
+	if (data_length != 0) {
+		memcpy(reply + AT_DATA, data, data_length);
+	}
+	mic_of(wpa, reply, length, reply + AT_MIC);
+	*reply_length = length;
+}
+
+/* The group key among what message 3 (or a group message) carries: an element 0xdd of the suite 00-0f-ac, kind 1. */
+static int
+group_key(struct lx_wpa *wpa, const uint8_t *data, unsigned length, const uint8_t *counter)
+{
+	for (unsigned at = 0; at + 2 <= length && at + 2 + data[at + 1] <= length; at += 2 + data[at + 1]) {
+		const uint8_t *e = data + at;
+
+		if (e[0] == 0xdd && e[1] == 0) {
+			break;				/* (padding from here on) */
+		}
+		/*
+		 * Only a CCMP group key is joined (protection() in lx_80211.c), so the key is 16 bytes -- the length key_set() copies --
+		 * and its number is 1 to 3 (IEEE 802.11-2020, 12.7.2: number 0 is the pairwise key's): a KDE of another length or number
+		 * is not installed with stale bytes of `group` filling it out.
+		 */
+		if (e[0] == 0xdd && e[1] >= 6 + 5 && e[2] == 0x00 && e[3] == 0x0f && e[4] == 0xac && e[5] == 1 &&
+		    e[1] - 6u == 16 && (e[6] & 3) != 0) {
+			wpa->group_index = e[6] & 3;
+			wpa->group_length = e[1] - 6u;
+			memcpy(wpa->group, e + 8, wpa->group_length);
+			memcpy(wpa->group_counter, counter, 8);
+			return (0);
+		}
+	}
+	return (-1);
+}
+
+int
+lx_wpa_message(struct lx_wpa *wpa, const unsigned char *message, unsigned length, unsigned char *reply, unsigned *reply_length,
+    const char **why)
+{
+	uint8_t mic[16], data[MESSAGE_MOST];
+	unsigned info, body, data_length, difference = 0;
+	const char *nothing;
+
+	why = why != NULL ? why : &nothing;
+	*why = "";
+	*reply_length = 0;
+	if (length < 4 || message[1] != 3) {
+		return (LX_WPA_NOTHING);
+	}
+	body = (unsigned)message[2] << 8 | message[3];
+	if (length < AT_DATA || 4 + body > length || 4 + body < AT_DATA || 4 + body > MESSAGE_MOST) {
+		*why = "its length is not a key message's";
+		return (LX_WPA_BAD);
+	}
+	length = 4 + body;
+	info = (unsigned)message[AT_INFO] << 8 | message[AT_INFO + 1];
+	data_length = (unsigned)message[AT_DATA_LENGTH] << 8 | message[AT_DATA_LENGTH + 1];
+	if (message[AT_KIND] != 2) {
+		*why = "it is not an RSN key message (WPA of the first kind?)";
+		return (LX_WPA_BAD);
+	}
+	if ((info & INFO_VERSION) != 2) {
+		*why = "its key descriptor is not version 2 (the network wants another kind of key management)";
+		return (LX_WPA_BAD);
+	}
+	if (AT_DATA + data_length > length) {
+		*why = "its key data is longer than the message";
+		return (LX_WPA_BAD);
+	}
+
+	/*
+	 * message 1: the access point's nonce, unsigned. Message 1 starts the four-way handshake and nothing else (IEEE 802.11i,
+	 * 8.5.3: the supplicant takes it in the states before the pairwise key is installed): once a signed message has been
+	 * accepted (replay_known) the keys are proven and in use, and an unsigned frame -- anyone in range can send one -- must not
+	 * re-derive and overwrite the KCK, KEK and TK. It is left alone, as every frame that is not for us to answer is.
+	 */
+	if ((info & (INFO_PAIRWISE | INFO_ACK | INFO_MIC)) == (INFO_PAIRWISE | INFO_ACK)) {
+		if (wpa->replay_known) {
+			*why = "it is a message 1 after the keys were proven (an unsigned frame does not change them)";
+			return (LX_WPA_NOTHING);
+		}
+		memcpy(wpa->peer_nonce, message + AT_NONCE, 32);
+		derive(wpa);
+		answer(wpa, message, 2 | INFO_PAIRWISE | INFO_MIC, wpa->own_nonce, wpa->rsn, wpa->rsn_length, reply, reply_length);
+		return (LX_WPA_ANSWER);
+	}
+
+	/* everything else is signed, by an access point that has shown it has the key */
+	if (!(info & INFO_MIC) || !(info & INFO_ACK)) {
+		return (LX_WPA_NOTHING);
+	}
+	if (!wpa->have_keys) {
+		*why = "it is signed, and there has been no message 1 to make the keys from";
+		return (LX_WPA_BAD);
+	}
+	mic_of(wpa, message, length, mic);
+	for (unsigned i = 0; i < 16; i++) {
+		difference |= mic[i] ^ message[AT_MIC + i];
+	}
+	if (difference != 0) {
+		*why = "its signature is not right (a wrong passphrase gives this)";
+		return (LX_WPA_BAD);
+	}
+	if (wpa->replay_known && memcmp(message + AT_REPLAY, wpa->replay, 8) <= 0) {
+		*why = "its counter is not beyond the last one's (a message played again)";
+		return (LX_WPA_BAD);
+	}
+	if ((info & INFO_PAIRWISE) && memcmp(message + AT_NONCE, wpa->peer_nonce, 32) != 0) {
+		*why = "its nonce is not message 1's";
+		return (LX_WPA_BAD);
+	}
+	if (!(info & INFO_ENCRYPTED) || aes_unwrap(wpa->kek, message + AT_DATA, data_length, data) != 0) {
+		memset(data, 0, sizeof(data));	/* (a failed unwrap leaves partial plaintext of the key data in it) */
+		*why = "its key data does not unwrap";
+		return (LX_WPA_BAD);
+	}
+	if (group_key(wpa, data, data_length - 8, message + AT_RSC) != 0) {
+		memset(data, 0, sizeof(data));
+		*why = "there is no group key in it";
+		return (LX_WPA_BAD);
+	}
+	memset(data, 0, sizeof(data));
+	memcpy(wpa->replay, message + AT_REPLAY, 8);
+	wpa->replay_known = 1;
+
+	/* message 3 of the four, or message 1 of a new group key */
+	if (info & INFO_PAIRWISE) {
+		answer(wpa, message, 2 | INFO_PAIRWISE | INFO_MIC | INFO_SECURE, NULL, NULL, 0, reply, reply_length);
+		return (LX_WPA_KEYS);
+	}
+	answer(wpa, message, 2 | INFO_MIC | INFO_SECURE, NULL, NULL, 0, reply, reply_length);
+	return (LX_WPA_GROUP);
+}
diff --git a/bsd/dev/hakios.lx_wpa.h b/bsd/dev/hakios.lx_wpa.h
new file mode 100644
index 0000000..f5ff673
--- /dev/null
+++ b/bsd/dev/hakios.lx_wpa.h
@@ -0,0 +1,49 @@
+/*
+ * WPA2 with a passphrase, as a station sees it: the key a name and a passphrase make, and the
+ * four-way handshake in which an access point and a station prove that key to each other and
+ * arrive at the keys their frames are ciphered with (IEEE 802.11-2020, 12.7; RSN, AKM "PSK",
+ * key descriptor version 2: HMAC-SHA1 and the AES key wrap). lx_wpa.c is the arithmetic and
+ * nothing else -- no radio, no kernel --, so that it runs on the machine the kernel is built on
+ * (tools/wpa-test) as it runs in the kernel.
+ */
+#ifndef _LX_WPA_H_
+#define _LX_WPA_H_
+
+/* The key ("PMK") of a network's name and passphrase: 32 bytes. Slow on purpose: 8192 rounds of HMAC-SHA1. */
+void lx_wpa_pmk(const unsigned char *passphrase, unsigned passphrase_length, const unsigned char *name, unsigned name_length,
+    unsigned char pmk[32]);
+
+struct lx_wpa {
+	unsigned char pmk[32];
+	unsigned char own[6], peer[6];		/* the station's address and the access point's */
+	unsigned char own_nonce[32];		/* 32 bytes nobody can guess, fresh for every handshake */
+	const unsigned char *rsn;		/* the station's RSN element as its association request had it ... */
+	unsigned rsn_length;			/* ... which goes into message 2 */
+	/* from here on: lx_wpa.c's */
+	unsigned char peer_nonce[32];
+	unsigned char kck[16], kek[16];		/* the keys the handshake's own messages are signed and ciphered with */
+	unsigned char replay[8];		/* the counter of the last message accepted */
+	int have_keys, replay_known;
+	/* what comes out of it */
+	unsigned char pairwise[16];		/* the key for frames between the two ("TK", CCMP) */
+	unsigned char group[32];		/* the key the access point sends to everybody with ("GTK") ... */
+	unsigned group_length, group_index;	/* ... its length, and its number (1 to 3) */
+	unsigned char group_counter[8];		/* ... and the packet number its frames have got to ("RSC") */
+};
+
+/*
+ * What a message of the handshake (an EAPOL frame: what follows the Ethernet header of a frame
+ * of type 0x888e) calls for. `reply` has room for LX_WPA_REPLY_MOST bytes.
+ */
+#define LX_WPA_REPLY_MOST	256
+enum {
+	LX_WPA_BAD = -1,		/* not a message that can be answered: *why says what was wrong with it */
+	LX_WPA_NOTHING = 0,		/* not for us to answer (not a key message) */
+	LX_WPA_ANSWER = 1,		/* message 1: send the reply (message 2) */
+	LX_WPA_KEYS = 2,		/* message 3: send the reply (message 4), then both keys are to be used */
+	LX_WPA_GROUP = 3,		/* a new group key later on: send the reply, then use the new group key */
+};
+int lx_wpa_message(struct lx_wpa *wpa, const unsigned char *message, unsigned length, unsigned char *reply,
+    unsigned *reply_length, const char **why);
+
+#endif
diff --git a/bsd/dev/hakios.net.c b/bsd/dev/hakios.net.c
new file mode 100644
index 0000000..58d4e08
--- /dev/null
+++ b/bsd/dev/hakios.net.c
@@ -0,0 +1,1500 @@
+/*
+ * en0: a network interface that is Ethernet as far as the rest of the kernel and Darwin can tell.
+ *
+ * Darwin expects its interfaces from IONetworkingFamily, which this kernel does not have; the BSD
+ * half of the kernel does not need it. The interface is made with the kernel's own interface
+ * KPI, the way bsd/net/if_fake.c makes its "feth": family Ethernet, the stock Ethernet framing
+ * and demultiplexing, one function that is given a frame to send and one call to hand a frame
+ * that has arrived to the stack. What Darwin's user space makes of an interface that has no
+ * IOKit object behind it is another matter: see userland/src/net_test.m.
+ *
+ * What carries the frames is a link driver's business; sys/hakios.net.h is all that the two
+ * know of each other. The first link is QEMU's virtio network device (hakios.virtio_net.c).
+ * There can be two interfaces: en0 for the Wi-Fi (or virtio), en1 for the modem's packets
+ * through the IPA (hakios.cell.c); each has its link, its state and its thread.
+ */
+#include <stdarg.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <net/bpf.h>
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <net/if_ether.h>
+#include <net/if_media.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <netinet/in.h>
+#include <netinet/in_systm.h>
+#include <netinet/ip.h>
+#include <netinet/ip_var.h>
+#include <netinet/tcp.h>
+#include <netinet/tcp_var.h>
+#include <netinet/udp.h>
+#include <netinet/udp_var.h>
+#include <pexpert/pexpert.h>
+#include <sys/kern_event.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/proc.h>
+#include <sys/hakios.net.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+extern void HakiosWLANStart(const char *interface, const uint8_t *address);  /* drivers/wifi/hakios.wlan.cpp */
+extern void HakiosWLANSetLink(bool up);
+
+static LCK_GRP_DECLARE(net_lck_grp, "hakios-net");
+
+/* One interface: enN on its link. */
+struct net_if {
+	unsigned        unit;
+	const struct hakios_net_link *link;
+	bool            up;             /* the link says frames can pass */
+	ifnet_t         ifp;
+	lck_mtx_t       tx_lock;        /* one frame at a time to the link */
+	/* What has gone through: said once a minute while anything moves. */
+	struct {
+		uint64_t sent, received, sent_bytes, received_bytes, dropped_out, dropped_in;
+	} count;
+};
+static struct net_if net_ifs[HAKIOS_NET_UNITS];
+
+static inline struct net_if *
+net_if_of(ifnet_t ifp)
+{
+	return ifnet_softc(ifp);
+}
+
+/* The interface on unit `unit`, once attached; NULL before. */
+static struct net_if *
+net_if_unit(unsigned unit)
+{
+	return unit < HAKIOS_NET_UNITS && net_ifs[unit].ifp != NULL ? &net_ifs[unit] : NULL;
+}
+
+/*
+ * Boot-arg net_trace=N: a line in the log for each of the first N frames, either way.
+ * Boot-arg net_names=1: a line for every name asked of a DNS server (IPv4 or IPv6, and which server), for every
+ * answer that comes back (its code and first addresses) and for every TCP connection begun from here -- which is how
+ * to see what a system that has just been given a network does with it (up to NAMES_MAX lines).
+ */
+#define NAMES_MAX       3000
+static uint32_t net_trace, net_names;
+
+static void
+ipv4_text(struct in_addr a, char *text, size_t room)
+{
+	const uint8_t *b = (const uint8_t *)&a.s_addr;
+
+	snprintf(text, room, "%u.%u.%u.%u", b[0], b[1], b[2], b[3]);
+}
+
+/*
+ * A DNS message's name at `p` (labels, or a pointer to some earlier in the message): where it ends in the message, NULL
+ * if it is malformed; its text in `name` if one is given (truncated to fit).
+ */
+static const uint8_t *
+dns_name(const uint8_t *message, const uint8_t *p, const uint8_t *end, char *name, size_t room)
+{
+	const uint8_t *after = NULL;
+	unsigned jumps = 0;
+	size_t n = 0;
+
+	while (p >= message && p < end) {
+		uint8_t length = *p;
+
+		if (length == 0) {
+			if (name != NULL && room != 0) {
+				name[n ? n - 1 : 0] = 0;
+			}
+			return after != NULL ? after : p + 1;
+		}
+		if ((length & 0xc0) == 0xc0) {
+			if (p + 2 > end || ++jumps > 16) {
+				return NULL;
+			}
+			if (after == NULL) {
+				after = p + 2;
+			}
+			p = message + ((length & 0x3f) << 8 | p[1]);
+			continue;
+		}
+		if (length >= 64 || p + 1 + length > end) {
+			return NULL;
+		}
+		if (name != NULL && n + length + 2 < room) {
+			memcpy(name + n, p + 1, length);
+			n += length;
+			name[n++] = '.';
+		}
+		p += 1 + length;
+	}
+	return NULL;
+}
+
+/*
+ * A DNS response: its code, how many answers it has, the first `room` IPv4 addresses among them, and the question's
+ * name if `name` is given. False if it is not a response.
+ */
+static bool
+dns_answer(const uint8_t *m, size_t length, unsigned *rcode, unsigned *answers, struct in_addr *a, unsigned room,
+    unsigned *a_count, char *name, size_t name_room)
+{
+	const uint8_t *end = m + length, *p;
+	unsigned an;
+
+	*a_count = 0;
+	if (name != NULL && name_room != 0) {
+		name[0] = 0;
+	}
+	if (length < 12 || !(m[2] & 0x80)) {
+		return false;
+	}
+	*rcode = m[3] & 15;
+	*answers = an = (unsigned)(m[6] << 8 | m[7]);
+	if ((m[4] << 8 | m[5]) == 0 || (p = dns_name(m, m + 12, end, name, name_room)) == NULL) {
+		return true;
+	}
+	p += 4;
+	for (unsigned i = 0; i < an && p != NULL && p < end; i++) {
+		unsigned type, data;
+
+		p = dns_name(m, p, end, NULL, 0);
+		if (p == NULL || p + 10 > end) {
+			break;
+		}
+		type = (unsigned)(p[0] << 8 | p[1]);
+		data = (unsigned)(p[8] << 8 | p[9]);
+		p += 10;
+		if (p + data > end) {
+			break;
+		}
+		if (type == 1 && data == 4 && *a_count < room) {
+			memcpy(&a[(*a_count)++].s_addr, p, 4);
+		}
+		p += data;
+	}
+	return true;
+}
+
+static uint32_t net_names_said;         /* (net_names: the lines said so far, both ways) */
+static bool net_names_console;          /* ("wifi names": the lines on the USB console too, as they come) */
+
+extern void loader_log_line(const char *line);
+
+/* one of net_names's lines: into the kernel's log, and onto the USB console after "wifi names" */
+static void __printflike(1, 2)
+names_say(const char *format, ...)
+{
+	char line[256];
+	va_list ap;
+
+	va_start(ap, format);
+	vsnprintf(line, sizeof(line), format, ap);
+	va_end(ap);
+	net_names_said++;
+	printf("%s", line);
+	if (net_names_console) {
+		loader_log_line(line);
+	}
+}
+
+/* an IPv6 address, shortly: its eight groups in hex */
+static void
+ipv6_text(const uint8_t *a, char *text, size_t room)
+{
+	snprintf(text, room, "%x:%x:%x:%x:%x:%x:%x:%x", a[0] << 8 | a[1], a[2] << 8 | a[3], a[4] << 8 | a[5], a[6] << 8 | a[7],
+	    a[8] << 8 | a[9], a[10] << 8 | a[11], a[12] << 8 | a[13], a[14] << 8 | a[15]);
+}
+
+/* net_names: a question to a DNS server, or the start of a TCP connection, on its way out (IPv4 or IPv6) */
+static void
+names_out(const uint8_t *ip, const uint8_t *end, bool v6)
+{
+	const uint8_t *l4 = v6 ? ip + 40 : ip + 4 * (ip[0] & 0xf);
+	unsigned protocol = v6 ? ip[6] : ip[9];
+	char to[48];
+
+	if (l4 + 14 > end || (protocol != IPPROTO_UDP && protocol != IPPROTO_TCP)) {
+		return;
+	}
+	if (v6) {
+		ipv6_text(ip + 24, to, sizeof(to));
+	} else {
+		snprintf(to, sizeof(to), "%u.%u.%u.%u", ip[16], ip[17], ip[18], ip[19]);
+	}
+	if (protocol == IPPROTO_UDP && (l4[2] << 8 | l4[3]) == 53 && l4 + 8 + 12 < end) {
+		const uint8_t *dns = l4 + 8, *after;
+		char name[128];
+
+		after = dns_name(dns, dns + 12, end, name, sizeof(name));
+		names_say("net: asks %s for the name %s (type %u)\n", to, after != NULL ? name : "?",
+		    after != NULL && after + 2 <= end ? after[0] << 8 | after[1] : 0);
+	} else if (protocol == IPPROTO_TCP && (l4[13] & 0x12) == 0x02) {
+		names_say("net: connects to %s port %u%s\n", to, l4[2] << 8 | l4[3], v6 ? " (IPv6)" : "");
+	}
+}
+
+/* net_names: a DNS server's answer, on its way in */
+static void
+names_in(const uint8_t *dns, const uint8_t *end, const char *from)
+{
+	struct in_addr a[2];
+	unsigned rcode, answers, count;
+	char name[128], first[16] = "", second[20] = "";
+
+	if (!dns_answer(dns, (size_t)(end - dns), &rcode, &answers, a, 2, &count, name, sizeof(name))) {
+		return;
+	}
+	if (count > 0) {
+		ipv4_text(a[0], first, sizeof(first));
+	}
+	if (count > 1) {
+		second[0] = ' ';
+		ipv4_text(a[1], second + 1, sizeof(second) - 1);
+	}
+	names_say("net: %s answers for %s: code %u, %u answer%s%s%s%s\n", from, name[0] ? name : "?", rcode, answers,
+	    answers == 1 ? "" : "s", count ? "; IPv4 " : "", first, second);
+}
+
+static void
+trace_frame(const char *way, const uint8_t *frame, size_t length, size_t whole)
+{
+	static uint32_t said;
+	const uint8_t *end = frame + length, *ip = frame + ETHER_HDR_LEN, *l4;
+	uint16_t type;
+	bool ports;
+
+	if (length < ETHER_HDR_LEN + 28 || (said >= net_trace && (!net_names || net_names_said >= NAMES_MAX))) {
+		return;
+	}
+	type = (uint16_t)(frame[12] << 8 | frame[13]);
+	l4 = ip + 4 * (ip[0] & 0xf);
+	ports = type == ETHERTYPE_IP && (ip[9] == IPPROTO_TCP || ip[9] == IPPROTO_UDP) && l4 + 4 <= end;
+	if (net_names && net_names_said < NAMES_MAX && way[0] == 'o' && (type == ETHERTYPE_IP || type == ETHERTYPE_IPV6)) {
+		names_out(ip, end, type == ETHERTYPE_IPV6);
+	}
+	if (said >= net_trace) {
+		return;
+	}
+	said++;
+	if (type == ETHERTYPE_IP) {
+		printf("net: %s %zu bytes: IPv4 %s %u.%u.%u.%u:%u -> %u.%u.%u.%u:%u%s\n", way, whole, ip[9] == IPPROTO_TCP ? "TCP" :
+		    ip[9] == IPPROTO_UDP ? "UDP" : ip[9] == IPPROTO_ICMP ? "ICMP" : "protocol?", ip[12], ip[13], ip[14], ip[15],
+		    ports ? l4[0] << 8 | l4[1] : 0, ip[16], ip[17], ip[18], ip[19], ports ? l4[2] << 8 | l4[3] : 0,
+		    ip[9] == IPPROTO_TCP && ports && l4 + 14 <= end ? (l4[13] & 2 ? " SYN" : l4[13] & 1 ? " FIN" : l4[13] & 4 ? " RST" : "") : "");
+	} else {
+		printf("net: %s %zu bytes: %s (type %#x) to %02x:%02x:%02x:%02x:%02x:%02x\n", way, whole, type == ETHERTYPE_ARP ? "ARP" :
+		    type == ETHERTYPE_IPV6 ? "IPv6" : "?", type, frame[0], frame[1], frame[2], frame[3], frame[4], frame[5]);
+	}
+}
+
+/* ... of a frame on its way out: the start of it is enough */
+static void
+trace_packet(mbuf_t packet, size_t length)
+{
+	uint8_t start[192];
+	size_t have = length < sizeof(start) ? length : sizeof(start);
+
+	if ((net_trace || net_names) && mbuf_copydata(packet, 0, have, start) == 0) {
+		trace_frame("out", start, have, length);
+	}
+}
+
+/*
+ * What has come in and gone out on en0, for the USB console's "wifi stat": frames by size (do the big ones of a
+ * download arrive at all), the biggest each way, those too big to hand up, by kind; and what DHCP gave as the router
+ * and the DNS servers (configd's resolver is given those; "wifi dns" asks the first itself).
+ */
+#define NET_SIZES       4
+static const uint32_t net_size_top[NET_SIZES] = { 128, 576, 1200, HAKIOS_NET_FRAME_MAX };
+static struct {
+	uint64_t in[NET_SIZES], out[NET_SIZES];
+	uint32_t in_biggest, out_biggest;
+	uint64_t in_too_big;
+	uint32_t in_too_big_last;
+	uint64_t in_ipv4, in_ipv6, in_arp, in_other, in_tcp, in_udp, in_dns;
+	struct in_addr dns[2], router;
+	unsigned dns_count;
+} net_seen;
+
+static unsigned
+net_size_class(size_t length)
+{
+	unsigned i = 0;
+
+	while (i + 1 < NET_SIZES && length > net_size_top[i]) {
+		i++;
+	}
+	return i;
+}
+
+/* DHCP's offer or acknowledgement (UDP 67 to 68): the router and the DNS servers among its options */
+static void
+net_seen_dhcp(const uint8_t *bootp, const uint8_t *end)
+{
+	const uint8_t *o = bootp + 240;
+	struct in_addr dns[2] = { { 0 }, { 0 } }, router = { 0 };
+	unsigned count = 0;
+
+	if (o > end || bootp[236] != 99 || bootp[237] != 130 || bootp[238] != 83 || bootp[239] != 99) {
+		return;                 /* (no options: not DHCP's) */
+	}
+	while (o < end && *o != 255) {
+		if (*o == 0) {
+			o++;
+			continue;
+		}
+		if (o + 2 > end || o + 2 + o[1] > end) {
+			break;
+		}
+		if (o[0] == 6) {
+			for (unsigned i = 0; i + 4 <= o[1] && count < 2; i += 4) {
+				memcpy(&dns[count++].s_addr, o + 2 + i, 4);
+			}
+		} else if (o[0] == 3 && o[1] >= 4) {
+			memcpy(&router.s_addr, o + 2, 4);
+		}
+		o += 2 + o[1];
+	}
+	if (count != 0 && (count != net_seen.dns_count || memcmp(dns, net_seen.dns, sizeof(dns)) != 0)) {
+		char first[16], second[16];
+
+		ipv4_text(dns[0], first, sizeof(first));
+		ipv4_text(dns[1], second, sizeof(second));
+		printf("net: DHCP gives the DNS server%s %s%s%s\n", count > 1 ? "s" : "", first, count > 1 ? " and " : "",
+		    count > 1 ? second : "");
+		memcpy(net_seen.dns, dns, sizeof(dns));
+		net_seen.dns_count = count;
+	}
+	if (router.s_addr != 0) {
+		net_seen.router = router;
+	}
+}
+
+/* a frame that has come in on en0, before it is handed up: counted, and looked at */
+static void
+net_seen_in(const uint8_t *frame, size_t length)
+{
+	const uint8_t *end = frame + length, *ip = frame + ETHER_HDR_LEN, *l4;
+	uint16_t type;
+
+	if (length > HAKIOS_NET_FRAME_MAX) {
+		net_seen.in_too_big++;
+		net_seen.in_too_big_last = (uint32_t)length;
+		if (net_seen.in_too_big <= 8) {
+			printf("net: a frame of %zu bytes came in, more than %u: dropped\n", length, HAKIOS_NET_FRAME_MAX);
+		}
+		return;
+	}
+	net_seen.in[net_size_class(length)]++;
+	if (length > net_seen.in_biggest) {
+		net_seen.in_biggest = (uint32_t)length;
+	}
+	if (length < ETHER_HDR_LEN + 20) {
+		net_seen.in_other++;
+		return;
+	}
+	type = (uint16_t)(frame[12] << 8 | frame[13]);
+	if (type == ETHERTYPE_ARP) {
+		net_seen.in_arp++;
+	} else if (type == ETHERTYPE_IPV6 && length >= ETHER_HDR_LEN + 48) {
+		net_seen.in_ipv6++;
+		l4 = ip + 40;
+		if (ip[6] == IPPROTO_TCP) {
+			net_seen.in_tcp++;
+		} else if (ip[6] == IPPROTO_UDP) {
+			net_seen.in_udp++;
+			if ((l4[0] << 8 | l4[1]) == 53) {
+				char from[48];
+
+				net_seen.in_dns++;
+				if (net_names && net_names_said < NAMES_MAX) {
+					ipv6_text(ip + 8, from, sizeof(from));
+					names_in(l4 + 8, end, from);
+				}
+			}
+		}
+	} else if (type == ETHERTYPE_IP) {
+		net_seen.in_ipv4++;
+		l4 = ip + 4 * (ip[0] & 0xf);
+		if (ip[9] == IPPROTO_TCP) {
+			net_seen.in_tcp++;
+		} else if (ip[9] == IPPROTO_UDP && l4 + 8 <= end) {
+			unsigned from_port = (unsigned)(l4[0] << 8 | l4[1]), to_port = (unsigned)(l4[2] << 8 | l4[3]);
+
+			net_seen.in_udp++;
+			if (from_port == 67 && to_port == 68) {
+				net_seen_dhcp(l4 + 8, end);
+			} else if (from_port == 53) {
+				char from[16];
+
+				net_seen.in_dns++;
+				if (net_names && net_names_said < NAMES_MAX) {
+					snprintf(from, sizeof(from), "%u.%u.%u.%u", ip[12], ip[13], ip[14], ip[15]);
+					names_in(l4 + 8, end, from);
+				}
+			}
+		}
+	} else {
+		net_seen.in_other++;
+	}
+}
+
+/* ---- the interface -------------------------------------------------------------------------------- */
+
+/* The stack has a frame to send (a chain of mbufs that starts with the Ethernet header). */
+static errno_t
+net_output(ifnet_t ifp, mbuf_t packet)
+{
+	struct net_if *n = net_if_of(ifp);
+	size_t length = mbuf_pkthdr_len(packet);
+	bool sent = false;
+
+	if (length <= HAKIOS_NET_FRAME_MAX && n->up) {
+		bpf_tap_out(ifp, DLT_EN10MB, packet, NULL, 0);
+		trace_packet(packet, length);
+		lck_mtx_lock(&n->tx_lock);
+		sent = n->link->transmit(packet, length);
+		lck_mtx_unlock(&n->tx_lock);
+	} else if (n->count.dropped_out < 8) {
+		printf("net: en%u drop TX %zu bytes (link %s)\n", n->unit, length, n->up ? "up" : "down");
+	}
+	if (sent) {
+		if (n->unit == 0) {
+			net_seen.out[net_size_class(length)]++;
+			if (length > net_seen.out_biggest) {
+				net_seen.out_biggest = (uint32_t)length;
+			}
+		}
+		n->count.sent++;
+		n->count.sent_bytes += length;
+		ifnet_stat_increment_out(ifp, 1, (uint32_t)length, 0);
+	} else {
+		n->count.dropped_out++;
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+	}
+	mbuf_freem(packet);
+	return 0;
+}
+
+/* A frame has arrived on unit `unit`. */
+void
+hakios_net_input_unit(unsigned unit, const uint8_t *frame, size_t length)
+{
+	struct net_if *n = net_if_unit(unit);
+	struct ifnet_stat_increment_param stats = { .packets_in = 1, .bytes_in = (uint32_t)length };
+	unsigned int chunks = 1;
+	mbuf_t packet = NULL;
+	char *header;
+
+	if (n == NULL) {
+		return;
+	}
+	if (unit == 0) {
+		net_seen_in(frame, length);
+	}
+	trace_frame("in ", frame, length, length);
+	if (length < ETHER_HDR_LEN || length > HAKIOS_NET_FRAME_MAX || mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &packet) != 0) {
+		n->count.dropped_in++;
+		return;
+	}
+	if (mbuf_copyback(packet, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(packet);
+		n->count.dropped_in++;
+		return;
+	}
+	/* as every Ethernet driver hands a frame up: the header noted and stepped over */
+	header = mbuf_data(packet);
+	mbuf_pkthdr_setrcvif(packet, n->ifp);
+	mbuf_pkthdr_setheader(packet, header);
+	mbuf_pkthdr_adjustlen(packet, -ETHER_HDR_LEN);
+	mbuf_setdata(packet, header + ETHER_HDR_LEN, length - ETHER_HDR_LEN);
+	bpf_tap_in(n->ifp, DLT_EN10MB, packet, header, ETHER_HDR_LEN);
+	n->count.received++;
+	n->count.received_bytes += length;
+	ifnet_input(n->ifp, packet, &stats);
+}
+
+void
+hakios_net_input(const uint8_t *frame, size_t length)
+{
+	hakios_net_input_unit(0, frame, length);
+}
+
+static unsigned net_ioctls_said;
+
+static errno_t
+net_ioctl(ifnet_t ifp, u_long command, void *data)
+{
+	struct net_if *n = net_if_of(ifp);
+	/* (a radio says it is one here too: IO80211.framework lists the interfaces whose media is 802.11) */
+	const int media[] = { (n->link->wireless ? IFM_IEEE80211 : IFM_ETHER) | IFM_AUTO };
+	struct ifreq *request = data;
+	struct ifmediareq *media_request = data;
+	user_addr_t list;
+	errno_t error = 0;
+
+	if (n->link->wireless && net_ioctls_said < 80) {
+		char who[32] = "?";
+
+		/* (while Darwin's Wi-Fi side is being got to talk to this: who asks the interface what) */
+		proc_selfname(who, sizeof(who));
+		if (strcmp(who, "configd") != 0) {
+			net_ioctls_said++;
+			printf("net: en0 is asked %#lx by %s\n", command, who);
+		}
+	}
+	switch (command) {
+	case SIOCSIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		break;
+	case SIOCSIFFLAGS:
+		/*
+		 * configd's IPConfiguration (net_test dhcp en0, scsc26) sent this with data == NULL:
+		 * FAR 0x10 is ifr_flags. A null request is EFAULT; IFF_UP already follows the link.
+		 */
+		if (request == NULL) {
+			break;
+		}
+		ifnet_set_flags(ifp, request->ifr_flags, IFF_UP);
+		ifnet_set_flags(ifp, (ifnet_flags(ifp) & IFF_UP) ? IFF_RUNNING : 0, IFF_RUNNING);
+		break;
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64:
+		/* what configd asks to learn whether the cable is in */
+		list = command == SIOCGIFMEDIA64 ? ((struct ifmediareq64 *)media_request)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)media_request)->ifmu_ulist);
+		media_request->ifm_active = media_request->ifm_current = media[0];
+		media_request->ifm_mask = 0;
+		media_request->ifm_status = IFM_AVALID | (n->up ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && media_request->ifm_count > 0) {
+			error = copyout(media, list, sizeof(media));
+		}
+		media_request->ifm_count = 1;
+		break;
+	case SIOCGIFDEVMTU:
+		request->ifr_devmtu.ifdm_current = ifnet_mtu(ifp);
+		request->ifr_devmtu.ifdm_max = ETHERMTU;
+		request->ifr_devmtu.ifdm_min = IF_MINMTU;
+		break;
+	case SIOCSIFMTU:
+		error = request->ifr_mtu > ETHERMTU || request->ifr_mtu < IF_MINMTU ? EINVAL : ifnet_set_mtu(ifp, request->ifr_mtu);
+		break;
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		break;                          /* the link hands us everything anyway */
+	default:
+		/* what Darwin's Wi-Fi side asks of a radio's interface: drivers/wifi/hakios.apple80211.c */
+		error = n->link->wireless ? hakios_apple80211_ioctl(command, data) : EOPNOTSUPP;
+		break;
+	}
+	return error;
+}
+
+/* Tell whoever listens for kernel events (configd does) that the link is up, or down. */
+static void
+net_link_event(ifnet_t ifp, uint32_t code)
+{
+	_Alignas(struct kern_event_msg) char message[sizeof(struct kern_event_msg) + sizeof(struct net_event_data)] = { 0 };
+	struct kern_event_msg *header = (struct kern_event_msg *)message;
+	struct net_event_data *about = (struct net_event_data *)(header + 1);
+
+	header->total_size = sizeof(message);
+	header->vendor_code = KEV_VENDOR_APPLE;
+	header->kev_class = KEV_NETWORK_CLASS;
+	header->kev_subclass = KEV_DL_SUBCLASS;
+	header->event_code = code;
+	about->if_family = ifnet_family(ifp);
+	about->if_unit = ifnet_unit(ifp);
+	strlcpy(about->if_name, ifnet_name(ifp), IFNAMSIZ);
+	ifnet_event(ifp, header);
+}
+
+void
+hakios_net_link_state_unit(unsigned unit, bool up)
+{
+	struct net_if *n = net_if_unit(unit);
+
+	if (n == NULL || up == n->up) {
+		return;
+	}
+	n->up = up;
+	ifnet_set_flags(n->ifp, up ? (IFF_UP | IFF_RUNNING) : 0, IFF_UP | IFF_RUNNING);
+	printf("net: en%u's link (%s) is %s\n", n->unit, n->link->name, up ? "up" : "down");
+	net_link_event(n->ifp, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF);
+	if (n->link->wireless) {
+		HakiosWLANSetLink(up);
+	}
+}
+
+void
+hakios_net_link_state(bool up)
+{
+	hakios_net_link_state_unit(0, up);
+}
+
+/* The interface's own thread: for a link that wants to be asked, and for the minute's line in the log. */
+static void
+net_thread(void *parameter, __unused wait_result_t result)
+{
+	struct net_if *n = parameter;
+	uint64_t said = 0, total;
+	unsigned quiet = 0;
+
+	for (unsigned tick = 1;; tick++) {
+		quiet = n->link->poll != NULL && n->link->poll() ? 0 : quiet + 1;
+		/* about once a minute, if anything has moved since */
+		total = n->count.sent + n->count.received + n->count.dropped_out + n->count.dropped_in;
+		if (tick % 8192 == 0 && total != said) {
+			said = total;
+			printf("net: en%u so far %llu frames sent (%llu bytes), %llu received (%llu bytes); dropped: %llu out, %llu in\n",
+			    n->unit, n->count.sent, n->count.sent_bytes, n->count.received, n->count.received_bytes,
+			    n->count.dropped_out, n->count.dropped_in);
+		}
+		delay_for_interval(quiet < 100 ? 2 : 10, NSEC_PER_MSEC);
+	}
+}
+
+bool
+hakios_net_attach(const struct hakios_net_link *link)
+{
+	unsigned unit = link->unit;
+	struct net_if *n = unit < HAKIOS_NET_UNITS ? &net_ifs[unit] : NULL;
+	char uniqueid[16];
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		/*
+		 * The simple model: every frame straight to net_output(). And no Skywalk "nexus" made for
+		 * the interface by itself: sockets are all that is asked of it so far.
+		 */
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = uniqueid,
+		.uniqueid_len = 11,
+		.name = "en",
+		.unit = unit,
+		.softc = n,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = link->wireless ? IFNET_SUBFAMILY_WIFI : IFNET_SUBFAMILY_ANY,
+		.type = IFT_ETHER,              /* 0x47 IEEE80211 on scsc34: DHCP did not complete; keep Ethernet framing */
+		.output = net_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = net_ioctl,
+		.broadcast_addr = etherbroadcastaddr,
+		.broadcast_len = ETHER_ADDR_LEN,
+	};
+	const uint8_t *address = link->address;
+	ifnet_t ifp = NULL;
+	thread_t thread;
+	errno_t error;
+
+	if (n == NULL) {
+		printf("net: there is no unit %u for %s\n", unit, link->name);
+		return false;
+	}
+	if (n->link != NULL) {
+		printf("net: en%u is on %s already; %s is not attached\n", unit, n->link->name, link->name);
+		return false;
+	}
+	snprintf(uniqueid, sizeof(uniqueid), "hakios-en%u", unit);
+	n->unit = unit;
+	n->link = link;
+	n->up = link->up;
+	lck_mtx_init(&n->tx_lock, &net_lck_grp, LCK_ATTR_NULL);
+	error = ifnet_allocate_extended(&init, &ifp);
+	if (error != 0) {
+		printf("net: the interface en%u cannot be made: error %d\n", unit, error);
+		n->link = NULL;
+		return false;
+	}
+	ifnet_set_capabilities_enabled(ifp, 0, -1);
+	ifnet_set_addrlen(ifp, ETHER_ADDR_LEN);
+	ifnet_set_baudrate(ifp, link->wireless ? 72ull * 1000 * 1000 : 100ull * 1000 * 1000);
+	ifnet_set_mtu(ifp, ETHERMTU);
+	ifnet_set_flags(ifp, IFF_BROADCAST | IFF_MULTICAST | IFF_SIMPLEX, 0xffff);
+	ifnet_set_hdrlen(ifp, ETHER_HDR_LEN);
+	ifnet_set_offload(ifp, 0);
+	error = ifnet_attach(ifp, NULL);
+	if (error != 0) {
+		printf("net: the interface en%u cannot be attached: error %d\n", unit, error);
+		ifnet_release(ifp);
+		n->link = NULL;
+		return false;
+	}
+	ifnet_set_lladdr(ifp, address, ETHER_ADDR_LEN);
+	bpfattach(ifp, DLT_EN10MB, ETHER_HDR_LEN);
+	n->ifp = ifp;
+	if (n->up) {
+		net_link_event(ifp, KEV_DL_LINK_ON);
+	}
+	if (link->wireless) {
+		/* (a radio's address is the phone's own: not for the log; and Darwin's Wi-Fi side finds the interface by a service) */
+		printf("net: en%u attached on %s (a radio), link %s\n", unit, link->name, n->up ? "up" : "down");
+		HakiosWLANStart(uniqueid + 7, address);
+	} else {
+		printf("net: en%u attached on %s, address %02x:%02x:%02x:%02x:%02x:%02x, link %s\n", unit, link->name, address[0],
+		    address[1], address[2], address[3], address[4], address[5], n->up ? "up" : "down");
+	}
+	if (kernel_thread_start(net_thread, n, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	return true;
+}
+
+void
+hakios_net_init(void)
+{
+	PE_parse_boot_argn("net_trace", &net_trace, sizeof(net_trace));
+	PE_parse_boot_argn("net_names", &net_names, sizeof(net_names));
+	hakios_virtio_net_init();
+}
+
+/*
+ * ---- the USB console's "wifi ip", "wifi ping", "wifi dns", "wifi tcp" and "wifi stat" (drivers/core/hakios.dwc3.c) ----
+ * What en0 was given (configd's DHCP, once the radio has joined and said its link is up), and whether the network
+ * answers: four ICMP echo requests from an ICMP datagram socket of the kernel's own (the kind ping uses without root),
+ * a second for each answer, of any size up to 8000 bytes (more than a frame: fragments both ways); with no address, the
+ * default route's gateway. A DNS question of the kernel's own (UDP, to the server DHCP gave); a TCP connection and an
+ * HTTP GET, and how many bytes came back and how fast (the data path's big frames, in); and what en0 has counted:
+ * frames by size and kind, and the IP, UDP and TCP layers' own counts (bad checksums among them).
+ */
+#include <net/route.h>
+#include <netinet/ip_icmp.h>
+#include <sys/kpi_socket.h>
+#include <sys/socket.h>
+
+extern void loader_log_line(const char *line);
+extern kern_return_t thread_terminate(thread_t thread);
+
+static void
+console_say(const char *format, ...)
+{
+	char line[400];         /* ("wifi stat"'s lines are long) */
+	va_list ap;
+
+	va_start(ap, format);
+	vsnprintf(line, sizeof(line), format, ap);
+	va_end(ap);
+	loader_log_line(line);
+}
+
+/* en0's first IPv4 address and mask; false without */
+static bool
+en0_ipv4(struct in_addr *address, struct in_addr *mask)
+{
+	ifnet_t ifp = NULL;
+	ifaddr_t *list = NULL;
+	bool found = false;
+
+	if (ifnet_find_by_name("en0", &ifp) != 0 || ifp == NULL) {
+		return false;
+	}
+	if (ifnet_get_address_list_family(ifp, &list, AF_INET) == 0 && list != NULL) {
+		for (unsigned i = 0; list[i] != NULL && !found; i++) {
+			struct sockaddr_in a = { 0 }, m = { 0 };
+
+			if (ifaddr_address(list[i], (struct sockaddr *)&a, sizeof(a)) == 0 && a.sin_family == AF_INET) {
+				*address = a.sin_addr;
+				mask->s_addr = ifaddr_netmask(list[i], (struct sockaddr *)&m, sizeof(m)) == 0 ? m.sin_addr.s_addr : 0;
+				found = true;
+			}
+		}
+		ifnet_free_address_list(list);
+	}
+	ifnet_release(ifp);
+	return found;
+}
+
+/* the default route's gateway, if there is one */
+static bool
+default_gateway(struct in_addr *gateway, char *interface, size_t room)
+{
+	struct sockaddr_in any = { .sin_len = sizeof(any), .sin_family = AF_INET };
+	struct rtentry *rt = rtalloc1((struct sockaddr *)&any, 0, 0);
+	bool found = false;
+
+	if (rt == NULL) {
+		return false;
+	}
+	RT_LOCK(rt);
+	if ((rt->rt_flags & RTF_GATEWAY) != 0 && rt->rt_gateway != NULL && rt->rt_gateway->sa_family == AF_INET) {
+		*gateway = ((struct sockaddr_in *)(void *)rt->rt_gateway)->sin_addr;
+		if (rt->rt_ifp != NULL) {
+			snprintf(interface, room, "%s%u", ifnet_name(rt->rt_ifp), ifnet_unit(rt->rt_ifp));
+		} else {
+			snprintf(interface, room, "?");
+		}
+		found = true;
+	}
+	RT_UNLOCK(rt);
+	rtfree(rt);
+	return found;
+}
+
+void
+hakios_net_console_ip(void)
+{
+	struct in_addr address, mask, gateway;
+	char a[16], m[16], g[16], via[IFNAMSIZ + 4];
+	struct net_if *n = net_if_unit(0);
+
+	if (n == NULL) {
+		console_say("usb: wifi ip: there is no en0 (the radio's driver did not get to brcmfmac=7)\n");
+		return;
+	}
+	if (!en0_ipv4(&address, &mask)) {
+		console_say("usb: wifi ip: en0's link is %s; no IPv4 address yet (configd's DHCP, once the link is up)\n",
+		    n->up ? "up" : "down");
+		return;
+	}
+	ipv4_text(address, a, sizeof(a));
+	ipv4_text(mask, m, sizeof(m));
+	if (default_gateway(&gateway, via, sizeof(via))) {
+		ipv4_text(gateway, g, sizeof(g));
+	} else {
+		snprintf(g, sizeof(g), "none");
+		via[0] = 0;
+	}
+	console_say("usb: wifi ip: en0's link is %s; address %s, mask %s; the default route's gateway %s%s%s\n",
+	    n->up ? "up" : "down", a, m, g, via[0] ? " on " : "", via);
+}
+
+static uint16_t
+icmp_sum(const uint8_t *p, size_t length)
+{
+	uint32_t sum = 0;
+
+	for (size_t i = 0; i + 1 < length; i += 2) {
+		sum += (uint32_t)(p[i] << 8 | p[i + 1]);
+	}
+	if (length & 1) {
+		sum += (uint32_t)p[length - 1] << 8;
+	}
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	return htons((uint16_t)~sum);
+}
+
+/*
+ * The console's jobs that take time -- ping, dns, tcp -- run on a thread of their own, one at a time; what each is to
+ * do is here while it runs.
+ */
+static volatile bool console_busy;
+static struct {
+	struct in_addr to;              /* (0: look the name up first) */
+	uint32_t size;
+	uint16_t port;
+	char name[96];
+	char path[96];
+} job;
+
+static bool
+console_job_start(thread_continue_t body, const char *what)
+{
+	thread_t thread;
+
+	if (console_busy) {
+		console_say("usb: wifi %s: another of ping, dns and tcp is under way\n", what);
+		return false;
+	}
+	console_busy = true;
+	if (kernel_thread_start(body, NULL, &thread) != KERN_SUCCESS) {
+		console_busy = false;
+		console_say("usb: wifi %s: no thread for it\n", what);
+		return false;
+	}
+	thread_set_thread_name(thread, "net-console");
+	thread_deallocate(thread);
+	return true;
+}
+
+static void
+console_job_end(void)
+{
+	console_busy = false;
+	thread_terminate(current_thread());
+}
+
+/* the next word of *line (up to a space or the end): its start and length; *line moved past it and the spaces after */
+static size_t
+next_word(const char **line, const char **start)
+{
+	const char *p = *line;
+	size_t n = 0;
+
+	while (*p == ' ') {
+		p++;
+	}
+	*start = p;
+	while (p[n] != 0 && p[n] != ' ') {
+		n++;
+	}
+	p += n;
+	while (*p == ' ') {
+		p++;
+	}
+	*line = p;
+	return n;
+}
+
+static bool
+ipv4_parse(const char *s, size_t length, struct in_addr *address)
+{
+	unsigned part[4] = { 0 }, n = 0;
+	bool digit = false;
+	uint8_t *b = (uint8_t *)&address->s_addr;
+
+	for (size_t i = 0; i < length; i++) {
+		if (s[i] >= '0' && s[i] <= '9') {
+			part[n] = part[n] * 10 + (unsigned)(s[i] - '0');
+			if (part[n] > 255) {
+				return false;
+			}
+			digit = true;
+		} else if (s[i] == '.' && digit && n < 3) {
+			n++;
+			digit = false;
+		} else {
+			return false;
+		}
+	}
+	if (n != 3 || !digit) {
+		return false;
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		b[i] = (uint8_t)part[i];
+	}
+	return true;
+}
+
+static bool
+number_parse(const char *s, size_t length, uint32_t least, uint32_t most, uint32_t *value)
+{
+	uint32_t v = 0;
+
+	if (length == 0 || length > 9) {
+		return false;
+	}
+	for (size_t i = 0; i < length; i++) {
+		if (s[i] < '0' || s[i] > '9') {
+			return false;
+		}
+		v = v * 10 + (uint32_t)(s[i] - '0');
+	}
+	if (v < least || v > most) {
+		return false;
+	}
+	*value = v;
+	return true;
+}
+
+static uint64_t
+ms_since(uint64_t start)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* ---- wifi ping [A.B.C.D] [SIZE] -------------------------------------------------------------------------------- */
+
+#define PING_MOST       8000            /* (more than one frame takes: the stack cuts it into fragments, and puts the answer together) */
+
+static void
+ping_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	struct sockaddr_in where = { .sin_len = sizeof(where), .sin_family = AF_INET, .sin_addr = job.to };
+	struct timeval wait = { .tv_sec = 1, .tv_usec = 0 };
+	size_t size = job.size, room = job.size + 128;
+	unsigned answered = 0, seq;
+	uint8_t *packet = kalloc_data(size, Z_WAITOK | Z_ZERO), *reply = kalloc_data(room, Z_WAITOK);
+	socket_t so = NULL;
+	char t[16];
+	errno_t error;
+
+	ipv4_text(job.to, t, sizeof(t));
+	if (packet == NULL || reply == NULL) {
+		console_say("usb: wifi ping %s: no memory for %zu bytes\n", t, size);
+		goto out;
+	}
+	if ((error = sock_socket_internal(PF_INET, SOCK_DGRAM, IPPROTO_ICMP, NULL, NULL, &so)) != 0) {
+		console_say("usb: wifi ping %s: no ICMP socket: %d\n", t, error);
+		goto out;
+	}
+	(void)sock_setsockopt(so, SOL_SOCKET, SO_RCVTIMEO, &wait, sizeof(wait));
+	for (seq = 1; seq <= 4; seq++) {
+		struct icmp *icp = (struct icmp *)(void *)packet;
+		struct iovec iov = { .iov_base = packet, .iov_len = size };
+		struct msghdr msg = { .msg_name = &where, .msg_namelen = sizeof(where), .msg_iov = &iov, .msg_iovlen = 1 };
+		uint64_t t0 = mach_absolute_time(), ms;
+		size_t done = 0;
+		bool got = false;
+
+		bzero(packet, size);
+		icp->icmp_type = ICMP_ECHO;
+		icp->icmp_id = htons(0x4853);
+		icp->icmp_seq = htons((uint16_t)seq);
+		for (size_t i = 8; i < size; i++) {
+			packet[i] = (uint8_t)i;
+		}
+		icp->icmp_cksum = icmp_sum(packet, size);
+		if ((error = sock_send(so, &msg, 0, &done)) != 0) {
+			console_say("usb: wifi ping %s: %u: not sent: %d%s\n", t, seq, error,
+			    error == ENETUNREACH || error == EHOSTUNREACH ? " (no route: no address yet?)" : "");
+			delay_for_interval(1000, NSEC_PER_MSEC);
+			continue;
+		}
+		do {
+			struct iovec in = { .iov_base = reply, .iov_len = room };
+			struct msghdr m = { .msg_iov = &in, .msg_iovlen = 1 };
+			size_t hl;
+
+			done = 0;
+			if (sock_receive(so, &m, 0, &done) != 0) {
+				break;  /* the second is up */
+			}
+			hl = done > 0 && (reply[0] >> 4) == 4 ? (size_t)(reply[0] & 15) * 4 : 0;
+			if (done >= hl + 8) {
+				const struct icmp *r = (const struct icmp *)(const void *)(reply + hl);
+
+				if (r->icmp_type == ICMP_ECHOREPLY && r->icmp_id == htons(0x4853) && r->icmp_seq == htons((uint16_t)seq)) {
+					bool same = done - hl == size && memcmp(reply + hl + 8, packet + 8, size - 8) == 0;
+					uint64_t us;
+
+					absolutetime_to_nanoseconds(mach_absolute_time() - t0, &us);
+					us /= NSEC_PER_USEC;
+					console_say("usb: wifi ping %s: %u: %zu bytes back in %llu.%03llu ms%s\n", t, seq, done - hl,
+					    us / 1000, us % 1000, same ? "" : " (NOT WHAT WAS SENT)");
+					got = true;
+					answered++;
+				}
+			}
+			ms = ms_since(t0);
+		} while (!got && ms < 1000);
+		if (!got) {
+			console_say("usb: wifi ping %s: %u: no answer in 1 s\n", t, seq);
+		} else {
+			delay_for_interval(200, NSEC_PER_MSEC);
+		}
+	}
+	console_say("usb: wifi ping %s: %u of 4 answered (%zu bytes each)\n", t, answered, size);
+	sock_close(so);
+out:
+	if (packet != NULL) {
+		kfree_data(packet, size);
+	}
+	if (reply != NULL) {
+		kfree_data(reply, room);
+	}
+	console_job_end();
+}
+
+void
+hakios_net_console_ping(const char *arg)
+{
+	const char *word;
+	size_t length;
+	char via[IFNAMSIZ + 4];
+
+	job.to.s_addr = 0;
+	job.size = 64;
+	while (*arg != 0) {
+		length = next_word(&arg, &word);
+		if (ipv4_parse(word, length, &job.to)) {
+			continue;
+		}
+		if (!number_parse(word, length, 28, PING_MOST, &job.size)) {
+			console_say("usb: wifi ping [A.B.C.D] [SIZE]: an IPv4 address and the ICMP message's size, 28 to %u bytes "
+			    "(64 if not given)\n", PING_MOST);
+			return;
+		}
+	}
+	if (job.to.s_addr == 0 && !default_gateway(&job.to, via, sizeof(via))) {
+		console_say("usb: wifi ping: no default route yet (wifi ip); or give an address: wifi ping A.B.C.D\n");
+		return;
+	}
+	(void)console_job_start(ping_runs, "ping");
+}
+
+/* ---- wifi dns NAME [A.B.C.D] ----------------------------------------------------------------------------------- */
+
+/* the DNS server DHCP gave, else the default route's gateway; false without either */
+static bool
+dns_server(struct in_addr *server)
+{
+	char via[IFNAMSIZ + 4];
+
+	if (net_seen.dns_count != 0) {
+		*server = net_seen.dns[0];
+		return true;
+	}
+	return default_gateway(server, via, sizeof(via));
+}
+
+/*
+ * One question, for the IPv4 addresses of `name`, to `server` on UDP port 53 (three tries, 2 s each): 0 and the
+ * answer's code, its number of answers and up to `room` addresses; or an errno (ETIMEDOUT: no answer).
+ */
+static errno_t
+dns_ask(const char *name, struct in_addr server, struct in_addr *a, unsigned room, unsigned *count, unsigned *rcode,
+    unsigned *answers, uint64_t *ms)
+{
+	struct sockaddr_in where = { .sin_len = sizeof(where), .sin_family = AF_INET, .sin_port = htons(53), .sin_addr = server };
+	struct timeval wait = { .tv_sec = 2, .tv_usec = 0 };
+	uint16_t id = (uint16_t)(mach_absolute_time() & 0xffff);
+	uint8_t question[300], answer[1500];
+	const char *p = name;
+	socket_t so = NULL;
+	size_t n = 12;
+	errno_t error;
+
+	bzero(question, 12);
+	question[0] = (uint8_t)(id >> 8);
+	question[1] = (uint8_t)id;
+	question[2] = 0x01;             /* recursion wanted */
+	question[5] = 1;                /* one question */
+	while (*p != 0) {
+		size_t length = 0;
+
+		while (p[length] != 0 && p[length] != '.') {
+			length++;
+		}
+		if (length == 0 || length > 63 || n + 1 + length + 5 > sizeof(question)) {
+			return EINVAL;
+		}
+		question[n++] = (uint8_t)length;
+		memcpy(question + n, p, length);
+		n += length;
+		p += length;
+		if (*p == '.') {
+			p++;
+		}
+	}
+	if (n == 12) {
+		return EINVAL;
+	}
+	question[n++] = 0;
+	question[n++] = 0;
+	question[n++] = 1;              /* A */
+	question[n++] = 0;
+	question[n++] = 1;              /* IN */
+	if ((error = sock_socket_internal(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so)) != 0) {
+		return error;
+	}
+	(void)sock_setsockopt(so, SOL_SOCKET, SO_RCVTIMEO, &wait, sizeof(wait));
+	error = ETIMEDOUT;
+	for (unsigned attempt = 0; attempt < 3 && error == ETIMEDOUT; attempt++) {
+		struct iovec iov = { .iov_base = question, .iov_len = n };
+		struct msghdr msg = { .msg_name = &where, .msg_namelen = sizeof(where), .msg_iov = &iov, .msg_iovlen = 1 };
+		uint64_t t0 = mach_absolute_time();
+		size_t done = 0;
+		errno_t e;
+
+		if ((e = sock_send(so, &msg, 0, &done)) != 0) {
+			error = e;
+			break;
+		}
+		for (;;) {
+			struct iovec in = { .iov_base = answer, .iov_len = sizeof(answer) };
+			struct msghdr m = { .msg_iov = &in, .msg_iovlen = 1 };
+
+			done = 0;
+			if (sock_receive(so, &m, 0, &done) != 0) {
+				break;          /* two seconds: ask again */
+			}
+			if (done >= 12 && answer[0] == question[0] && answer[1] == question[1] &&
+			    dns_answer(answer, done, rcode, answers, a, room, count, NULL, 0)) {
+				*ms = ms_since(t0);
+				error = 0;
+				break;
+			}
+		}
+	}
+	sock_close(so);
+	return error;
+}
+
+static void
+dns_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	struct in_addr a[4];
+	unsigned count = 0, rcode = 0, answers = 0;
+	uint64_t ms = 0;
+	char s[16], list[4 * 17] = "";
+	errno_t error;
+
+	ipv4_text(job.to, s, sizeof(s));
+	error = dns_ask(job.name, job.to, a, 4, &count, &rcode, &answers, &ms);
+	if (error != 0) {
+		console_say("usb: wifi dns %s: %s %s: %d\n", job.name, error == ETIMEDOUT ? "no answer in 6 s from" : "not asked of", s,
+		    error);
+	} else {
+		for (unsigned i = 0; i < count; i++) {
+			size_t used = strlen(list);
+
+			ipv4_text(a[i], list + used + (used ? 1 : 0), sizeof(list) - used - 1);
+			if (used) {
+				list[used] = ' ';
+			}
+		}
+		console_say("usb: wifi dns %s: %s answers in %llu ms: code %u%s, %u answer%s%s%s\n", job.name, s, ms, rcode,
+		    rcode == 3 ? " (no such name)" : rcode ? " (an error)" : "", answers, answers == 1 ? "" : "s", count ? ": " : "",
+		    list);
+	}
+	console_job_end();
+}
+
+void
+hakios_net_console_dns(const char *arg)
+{
+	const char *word;
+	size_t length;
+
+	length = next_word(&arg, &word);
+	if (length == 0 || length >= sizeof(job.name)) {
+		console_say("usb: wifi dns NAME [A.B.C.D]: NAME's IPv4 addresses, asked of the DNS server given (by default the one "
+		    "DHCP gave, else the gateway)\n");
+		return;
+	}
+	memcpy(job.name, word, length);
+	job.name[length] = 0;
+	length = next_word(&arg, &word);
+	if (length != 0 ? !ipv4_parse(word, length, &job.to) : !dns_server(&job.to)) {
+		console_say("usb: wifi dns %s: %s\n", job.name, length ? "the server is to be an IPv4 address" :
+		    "no DNS server known yet, and no default route (wifi ip)");
+		return;
+	}
+	(void)console_job_start(dns_runs, "dns");
+}
+
+/* ---- wifi tcp HOST [PORT [PATH]] -------------------------------------------------------------------------------- */
+
+#define TCP_MOST_MS     60000
+
+static void
+tcp_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	struct sockaddr_in where = { .sin_len = sizeof(where), .sin_family = AF_INET, .sin_port = htons(job.port) };
+	struct timeval connect_wait = { .tv_sec = 10, .tv_usec = 0 }, wait = { .tv_sec = 5, .tv_usec = 0 };
+	struct tcpstat before = tcpstat;
+	char t[16], request[300], status[100] = "", *buffer = NULL;
+	uint64_t t0, connected_ms, ms, bytes = 0, reads = 0;
+	const char *ended = "the server closed it";
+	socket_t so = NULL;
+	size_t done;
+	errno_t error;
+
+	if (job.to.s_addr == 0) {
+		struct in_addr server, a[1];
+		unsigned count = 0, rcode = 0, answers = 0;
+
+		if (!dns_server(&server)) {
+			console_say("usb: wifi tcp %s: no DNS server known to look the name up with\n", job.name);
+			goto out;
+		}
+		error = dns_ask(job.name, server, a, 1, &count, &rcode, &answers, &ms);
+		if (error != 0 || count == 0) {
+			console_say("usb: wifi tcp %s: the name not found (error %d, code %u, %u answers)\n", job.name, error, rcode, answers);
+			goto out;
+		}
+		job.to = a[0];
+		ipv4_text(job.to, t, sizeof(t));
+		console_say("usb: wifi tcp %s: is %s (DNS, %llu ms)\n", job.name, t, ms);
+	}
+	ipv4_text(job.to, t, sizeof(t));
+	where.sin_addr = job.to;
+	if ((buffer = kalloc_data(4096, Z_WAITOK)) == NULL ||
+	    (error = sock_socket_internal(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &so)) != 0) {
+		console_say("usb: wifi tcp %s: no memory or no socket\n", t);
+		goto out;
+	}
+	t0 = mach_absolute_time();
+	error = sock_connect(so, (struct sockaddr *)&where, MSG_DONTWAIT);
+	if (error == EINPROGRESS) {
+		error = sock_connectwait(so, &connect_wait);
+	}
+	if (error == 0) {
+		int e = 0, length = sizeof(e);
+
+		(void)sock_getsockopt(so, SOL_SOCKET, SO_ERROR, &e, &length);
+		error = e;
+	}
+	connected_ms = ms_since(t0);
+	if (error != 0) {
+		console_say("usb: wifi tcp %s port %u: no connection after %llu ms: %d%s\n", t, job.port, connected_ms, error,
+		    error == EWOULDBLOCK ? " (no answer to the SYN)" : error == ECONNREFUSED ? " (refused)" : "");
+		goto out;
+	}
+	console_say("usb: wifi tcp %s port %u: connected in %llu ms; GET %s\n", t, job.port, connected_ms, job.path);
+	snprintf(request, sizeof(request), "GET %s HTTP/1.1\r\nHost: %s\r\nUser-Agent: hakios-console\r\nAccept: */*\r\n"
+	    "Connection: close\r\n\r\n", job.path, job.name);
+	{
+		struct iovec iov = { .iov_base = request, .iov_len = strlen(request) };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+
+		done = 0;
+		if ((error = sock_send(so, &msg, 0, &done)) != 0) {
+			console_say("usb: wifi tcp %s: the request not sent: %d\n", t, error);
+			goto out;
+		}
+	}
+	(void)sock_setsockopt(so, SOL_SOCKET, SO_RCVTIMEO, &wait, sizeof(wait));
+	for (;;) {
+		struct iovec in = { .iov_base = buffer, .iov_len = 4096 };
+		struct msghdr m = { .msg_iov = &in, .msg_iovlen = 1 };
+
+		done = 0;
+		error = sock_receive(so, &m, 0, &done);
+		if (error != 0) {
+			ended = error == EWOULDBLOCK ? "NOTHING CAME FOR 5 s" : "an error";
+			break;
+		}
+		if (done == 0) {
+			break;
+		}
+		if (bytes == 0) {
+			size_t i = 0;
+
+			while (i < done && i < sizeof(status) - 1 && buffer[i] != '\r' && buffer[i] != '\n') {
+				status[i] = buffer[i] >= 0x20 && buffer[i] < 0x7f ? buffer[i] : '?';
+				i++;
+			}
+			status[i] = 0;
+		}
+		bytes += done;
+		reads++;
+		if (ms_since(t0) > TCP_MOST_MS) {
+			ended = "stopped after 60 s";
+			break;
+		}
+	}
+	ms = ms_since(t0);
+	console_say("usb: wifi tcp %s: \"%s\": %llu bytes in %llu ms (%llu KB/s, %llu reads); %s (%d)\n", t, status, bytes, ms,
+	    ms ? bytes / ms : 0, reads, ended, error);
+	console_say("usb: wifi tcp %s: meanwhile TCP had %u packets in order (%u bytes), %u with a bad checksum, %u duplicate, "
+	    "%u out of order; sent %u again, %u retransmit timeouts\n", t, tcpstat.tcps_rcvpack - before.tcps_rcvpack,
+	    tcpstat.tcps_rcvbyte - before.tcps_rcvbyte, tcpstat.tcps_rcvbadsum - before.tcps_rcvbadsum,
+	    tcpstat.tcps_rcvduppack - before.tcps_rcvduppack, tcpstat.tcps_rcvoopack - before.tcps_rcvoopack,
+	    tcpstat.tcps_sndrexmitpack - before.tcps_sndrexmitpack, tcpstat.tcps_rexmttimeo - before.tcps_rexmttimeo);
+out:
+	if (so != NULL) {
+		sock_close(so);
+	}
+	if (buffer != NULL) {
+		kfree_data(buffer, 4096);
+	}
+	console_job_end();
+}
+
+void
+hakios_net_console_tcp(const char *arg)
+{
+	const char *word;
+	size_t length;
+	uint32_t port = 80;
+
+	length = next_word(&arg, &word);
+	if (length == 0 || length >= sizeof(job.name)) {
+		goto usage;
+	}
+	memcpy(job.name, word, length);
+	job.name[length] = 0;
+	if (!ipv4_parse(word, length, &job.to)) {
+		job.to.s_addr = 0;      /* a name: DNS first */
+	}
+	length = next_word(&arg, &word);
+	if (length != 0 && !number_parse(word, length, 1, 65535, &port)) {
+		goto usage;
+	}
+	job.port = (uint16_t)port;
+	length = next_word(&arg, &word);
+	if (length >= sizeof(job.path) || (length != 0 && word[0] != '/')) {
+		goto usage;
+	}
+	memcpy(job.path, length ? word : "/", length ? length : 1);
+	job.path[length ? length : 1] = 0;
+	(void)console_job_start(tcp_runs, "tcp");
+	return;
+usage:
+	console_say("usb: wifi tcp HOST [PORT [PATH]]: a TCP connection to HOST (A.B.C.D, or a name for DNS), port 80 by "
+	    "default, an HTTP GET of PATH (/), and the bytes that come back\n");
+}
+
+/* ---- wifi names [off] ------------------------------------------------------------------------------------------- */
+
+/*
+ * What boot-arg net_names=1 says -- every name asked of a DNS server and its answer, every TCP connection begun --
+ * on the USB console as well as in the kernel's log, from now on (and the count of NAMES_MAX lines begun again): to
+ * watch what Safari or any other program does with the network while one uses it. "off" stops it.
+ */
+void
+hakios_net_console_names(const char *arg)
+{
+	if (strcmp(arg, "off") == 0) {
+		net_names_console = false;
+		console_say("usb: wifi names: off (the kernel's log keeps them while boot-arg net_names=1)\n");
+		return;
+	}
+	net_names = 1;
+	net_names_said = 0;
+	net_names_console = true;
+	console_say("usb: wifi names: every DNS question and answer and every TCP connection begun, here as they come "
+	    "(wifi names off to stop)\n");
+}
+
+/* ---- wifi stat ---------------------------------------------------------------------------------------------------- */
+
+void
+hakios_net_console_stat(void)
+{
+	struct net_if *n = net_if_unit(0);
+	struct ifnet_stats_param s = { 0 };
+	char first[16], second[16], line[160] = "";
+
+	if (n == NULL) {
+		console_say("usb: wifi stat: there is no en0\n");
+		return;
+	}
+	(void)ifnet_stat(n->ifp, &s);
+	console_say("usb: wifi stat: en0 link %s; sent %llu frames (%llu bytes), received %llu (%llu bytes); dropped %llu out, %llu in\n",
+	    n->up ? "up" : "down", n->count.sent, n->count.sent_bytes, n->count.received, n->count.received_bytes,
+	    n->count.dropped_out, n->count.dropped_in);
+	console_say("usb: wifi stat: en0 in by size: %llu <= 128, %llu <= 576, %llu <= 1200, %llu <= 1514, %llu bigger (the last %u); "
+	    "the biggest %u\n", net_seen.in[0], net_seen.in[1], net_seen.in[2], net_seen.in[3], net_seen.in_too_big,
+	    net_seen.in_too_big_last, net_seen.in_biggest);
+	console_say("usb: wifi stat: en0 out by size: %llu <= 128, %llu <= 576, %llu <= 1200, %llu <= 1514; the biggest %u\n",
+	    net_seen.out[0], net_seen.out[1], net_seen.out[2], net_seen.out[3], net_seen.out_biggest);
+	console_say("usb: wifi stat: en0 in by kind: %llu IPv4, %llu IPv6, %llu ARP, %llu other; %llu TCP, %llu UDP, %llu from DNS servers\n",
+	    net_seen.in_ipv4, net_seen.in_ipv6, net_seen.in_arp, net_seen.in_other, net_seen.in_tcp, net_seen.in_udp,
+	    net_seen.in_dns);
+	console_say("usb: wifi stat: the interface's own count: %llu packets in (%llu bytes, %llu errors), %llu out (%llu bytes, "
+	    "%llu errors), %llu dropped, %llu of no protocol\n", s.packets_in, s.bytes_in, s.errors_in, s.packets_out,
+	    s.bytes_out, s.errors_out, s.dropped, s.no_protocol);
+	console_say("usb: wifi stat: IP: %u in, %u bad checksum, %u too short or bad length, %u fragments (%u put together), "
+	    "%u delivered\n", ipstat.ips_total, ipstat.ips_badsum, ipstat.ips_tooshort + ipstat.ips_badlen, ipstat.ips_fragments,
+	    ipstat.ips_reassembled, ipstat.ips_delivered);
+	console_say("usb: wifi stat: UDP: %u in, %u bad checksum, %u to no socket\n", udpstat.udps_ipackets, udpstat.udps_badsum,
+	    udpstat.udps_noport);
+	console_say("usb: wifi stat: TCP: %u connections tried, %u made, %u dropped; in: %u packets in order (%u bytes), %u bad "
+	    "checksum, %u duplicate, %u out of order; out: %u packets, %u sent again, %u retransmit timeouts\n",
+	    tcpstat.tcps_connattempt, tcpstat.tcps_connects, tcpstat.tcps_conndrops + tcpstat.tcps_drops, tcpstat.tcps_rcvpack,
+	    tcpstat.tcps_rcvbyte, tcpstat.tcps_rcvbadsum, tcpstat.tcps_rcvduppack, tcpstat.tcps_rcvoopack, tcpstat.tcps_sndtotal,
+	    tcpstat.tcps_sndrexmitpack, tcpstat.tcps_rexmttimeo);
+	ipv4_text(net_seen.dns[0], first, sizeof(first));
+	ipv4_text(net_seen.dns[1], second, sizeof(second));
+	if (n->link->counts != NULL) {
+		n->link->counts(line, sizeof(line));
+	}
+	console_say("usb: wifi stat: DHCP's DNS server%s: %s%s%s; %s\n", net_seen.dns_count > 1 ? "s" : "",
+	    net_seen.dns_count ? first : "none seen", net_seen.dns_count > 1 ? " " : "", net_seen.dns_count > 1 ? second : "",
+	    line[0] ? line : "(the link says nothing of itself)");
+}
diff --git a/bsd/dev/hakios.sta.c b/bsd/dev/hakios.sta.c
new file mode 100644
index 0000000..3bbe9b2
--- /dev/null
+++ b/bsd/dev/hakios.sta.c
@@ -0,0 +1,625 @@
+/*
+ * Darwin-on-hakios: what stands between the two sides of the station boundary
+ * (sys/hakios.sta.h).
+ *
+ * Whoever wants a network asks from wherever it happens to be: an ioctl of wifid's, the thread
+ * that brings the radio up. The station side wants to be called by one thread, one call at a
+ * time, and a scan or a join takes seconds. So what is asked for is noted here and done by a
+ * thread of this file's; the asker returns at once and hears the outcome as an event. One
+ * request of each kind can wait: a second scan asked for while the first has not begun
+ * replaces it, as does a second join.
+ *
+ * What the last scan heard is kept here, so that it can be read without entering the station
+ * side, and so is the list of channels.
+ *
+ * The network the kernel was given in a file is a standing request: joined at the start, and
+ * again whenever the radio is turned back on (Settings' switch), until somebody asks for
+ * another network -- as Darwin itself rejoins the networks it knows. If that other network cannot
+ * be joined (a wrong passphrase), the standing one is joined again.
+ */
+#include <stdarg.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/hakios.input.h>
+#include <sys/hakios.sta.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <sys/vnode.h>
+
+extern void thread_set_thread_name(thread_t thread, const char *name);
+extern void loader_log_line(const char *line);
+extern kern_return_t thread_terminate(thread_t thread);
+extern vnode_t rootvnode;
+
+#define HEARD_MOST      128
+#define CHANNELS_MOST   96
+
+static LCK_GRP_DECLARE(sta_lock_group, "hakios-sta");
+static LCK_MTX_DECLARE(sta_lock, &sta_lock_group);
+
+static const struct hakios_sta_ops *sta_ops;   /* the station side, while there is one */
+static bool sta_thread_made;
+static bool sta_calls;                          /* the thread is in a call of the station side's */
+static unsigned sta_reads;                      /* ... and so many others are in its state() */
+static bool sta_on;                             /* the radio's power, as last asked for */
+
+/* what has been asked for and not begun */
+static bool asked_power, asked_power_on, asked_scan, asked_join, asked_leave;
+static struct hakios_sta_scan asked_scan_what;
+static struct hakios_sta_join asked_join_what;
+static struct hakios_sta_join standing;        /* the network joined whenever the radio comes on (ssid_length 0: none) */
+static struct hakios_sta_join fallback;        /* ... as it was before a join that has not come through yet */
+static bool auto_join_pending;                 /* scan first, then standing, once after power/attach */
+
+#define NETWORK_PATH    "/private/var/xc5/hakios-wifi"   /* XCover5: in the drop zone (mkdrop.py hakios-wifi=FILE) */
+
+static void
+network_save(const struct hakios_sta_join *what)
+{
+	vfs_context_t ctx;
+	vnode_t vnode = NULLVP;
+	char body[160];
+	int n, left = 0, error;
+
+	if (what == NULL || what->ssid_length == 0 || rootvnode == NULLVP) {
+		return;
+	}
+	n = 0;
+	memcpy(body, what->ssid, what->ssid_length);
+	n += what->ssid_length;
+	body[n++] = '\n';
+	if (what->passphrase_length != 0 && what->passphrase_length <= 63) {
+		memcpy(body + n, what->passphrase, what->passphrase_length);
+		n += what->passphrase_length;
+	} else {
+		static const char hex[] = "0123456789abcdef";
+		unsigned i;
+
+		for (i = 0; i < 32; i++) {
+			body[n++] = hex[what->pmk[i] >> 4];
+			body[n++] = hex[what->pmk[i] & 0xf];
+		}
+	}
+	body[n++] = '\n';
+	ctx = vfs_context_kernel();
+	error = vnode_open(NETWORK_PATH, O_WRONLY | O_CREAT | O_TRUNC, 0600, 0, &vnode, ctx);
+	if (error != 0) {
+		hakios_wifi_tell("wifi: standing network not saved (open %d)\n", error);
+		return;
+	}
+	error = vn_rdwr(UIO_WRITE, vnode, body, n, 0, UIO_SYSSPACE, IO_SYNC, vfs_context_ucred(ctx), &left,
+	    vfs_context_proc(ctx));
+	(void)vnode_close(vnode, FWASWRITTEN, ctx);
+	memset_s(body, sizeof(body), 0, sizeof(body));
+	hakios_wifi_tell("wifi: standing network %s (%u-byte name)\n", error == 0 && left == 0 ? "saved" : "not written",
+	    what->ssid_length);
+}
+
+static bool
+network_load(struct hakios_sta_join *what)
+{
+	vfs_context_t ctx;
+	vnode_t vnode = NULLVP;
+	char body[160];
+	int n, left = 0, i;
+	char *nl, *nl2;
+
+	if (what == NULL || rootvnode == NULLVP) {
+		return false;
+	}
+	bzero(what, sizeof(*what));
+	ctx = vfs_context_kernel();
+	if (vnode_lookup(NETWORK_PATH, 0, &vnode, ctx) != 0) {
+		return false;
+	}
+	n = (int)sizeof(body) - 1;
+	if (vn_rdwr(UIO_READ, vnode, body, n, 0, UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &left, vfs_context_proc(ctx)) != 0) {
+		vnode_put(vnode);
+		return false;
+	}
+	vnode_put(vnode);
+	n -= left;
+	body[n < 0 ? 0 : n] = 0;
+	nl = strchr(body, '\n');
+	if (nl == NULL || nl == body || (unsigned)(nl - body) > 32) {
+		memset_s(body, sizeof(body), 0, sizeof(body));
+		return false;
+	}
+	what->ssid_length = (uint8_t)(nl - body);
+	memcpy(what->ssid, body, what->ssid_length);
+	nl2 = strchr(nl + 1, '\n');
+	n = (int)((nl2 != NULL ? nl2 : body + strlen(body)) - (nl + 1));
+	if (n >= 8 && n <= 63) {
+		what->security = HAKIOS_STA_WPA2_PSK;
+		what->passphrase_length = (uint8_t)n;
+		memcpy(what->passphrase, nl + 1, (unsigned)n);
+	} else if (n == 64) {
+		what->security = HAKIOS_STA_WPA2_PSK;
+		for (i = 0; i < 32; i++) {
+			unsigned hi = (unsigned char)nl[1 + 2 * i], lo = (unsigned char)nl[2 + 2 * i];
+
+			hi = hi >= 'a' ? hi - 'a' + 10 : hi >= 'A' ? hi - 'A' + 10 : hi - '0';
+			lo = lo >= 'a' ? lo - 'a' + 10 : lo >= 'A' ? lo - 'A' + 10 : lo - '0';
+			what->pmk[i] = (uint8_t)((hi << 4) | lo);
+		}
+	} else if (n == 0) {
+		what->security = HAKIOS_STA_OPEN;
+	} else {
+		bzero(what, sizeof(*what));
+		memset_s(body, sizeof(body), 0, sizeof(body));
+		return false;
+	}
+	memset_s(body, sizeof(body), 0, sizeof(body));
+	hakios_wifi_tell("wifi: standing network loaded (%u-byte name)\n", what->ssid_length);
+	return true;
+}
+
+static struct hakios_sta_bss *heard;           /* by the last scan that came to an end */
+static unsigned heard_count;
+static struct hakios_sta_channel channels[CHANNELS_MOST];
+static unsigned channel_count;
+
+static void
+heard_one(const struct hakios_sta_bss *bss, __unused void *context)
+{
+	/* (only the thread writes the list, and it reads the count without the lock) */
+	if (heard_count < HEARD_MOST) {
+		lck_mtx_lock(&sta_lock);
+		heard[heard_count++] = *bss;
+		lck_mtx_unlock(&sta_lock);
+	}
+}
+
+static void
+sta_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	static struct hakios_sta_scan scan;
+	static struct hakios_sta_join join;
+
+	for (;;) {
+		const struct hakios_sta_ops *ops;
+		bool power = false, power_on = false, leave = false, do_join = false, do_scan = false;
+		int error = 0;
+
+		lck_mtx_lock(&sta_lock);
+		while (sta_ops == NULL || !(asked_power || asked_leave || asked_join || asked_scan)) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_ops, THREAD_UNINT);
+		}
+		ops = sta_ops;
+		/* one thing at a time, in the order that makes sense when several wait */
+		if (asked_power) {
+			power = true;
+			power_on = asked_power_on;
+			asked_power = false;
+		} else if (asked_leave) {
+			leave = true;
+			asked_leave = false;
+		} else if (asked_join) {
+			do_join = true;
+			join = asked_join_what;
+			bzero(&asked_join_what, sizeof(asked_join_what));
+			asked_join = false;
+		} else {
+			do_scan = true;
+			scan = asked_scan_what;
+			asked_scan = false;
+		}
+		sta_calls = true;
+		lck_mtx_unlock(&sta_lock);
+
+		if (power) {
+			struct hakios_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+			bool was_joined = false;
+
+			if (state != NULL) {
+				ops->state(state);
+				was_joined = state->phase == HAKIOS_STA_JOINED;
+				kfree_data(state, sizeof(*state));
+			}
+			error = ops->power(power_on);
+			if (!power_on && was_joined) {
+				hakios_apple80211_event(HAKIOS_STA_LINK, 0);
+			}
+			hakios_apple80211_event(HAKIOS_STA_POWER, error == 0 ? power_on : !power_on);
+			lck_mtx_lock(&sta_lock);
+			if (error == 0 && power_on && standing.ssid_length != 0 && !asked_join && !asked_scan) {
+				auto_join_pending = true;
+				bzero(&asked_scan_what, sizeof(asked_scan_what));
+				asked_scan = true;
+			}
+			lck_mtx_unlock(&sta_lock);
+		} else if (leave) {
+			ops->leave();
+			hakios_apple80211_event(HAKIOS_STA_LINK, 0);
+		} else if (do_join) {
+			error = ops->join(&join);
+			if (error == 0) {
+				lck_mtx_lock(&sta_lock);
+				standing = join;
+				lck_mtx_unlock(&sta_lock);
+				network_save(&join);
+			}
+			bzero(&join, sizeof(join));
+			hakios_apple80211_event(HAKIOS_STA_JOIN_DONE, error);
+			if (error == 0) {
+				hakios_apple80211_event(HAKIOS_STA_LINK, 1);
+			}
+			/* a join that did not come through (a wrong passphrase) leaves things as they were: the standing network again */
+			lck_mtx_lock(&sta_lock);
+			if (error != 0 && fallback.ssid_length != 0 && !asked_join && !asked_leave && !asked_power) {
+				standing = asked_join_what = fallback;
+				asked_join = true;
+			}
+			bzero(&fallback, sizeof(fallback));
+			lck_mtx_unlock(&sta_lock);
+		} else if (do_scan) {
+			error = ops->scan(&scan);
+			lck_mtx_lock(&sta_lock);
+			heard_count = 0;
+			lck_mtx_unlock(&sta_lock);
+			ops->heard(heard_one, NULL);
+			hakios_apple80211_event(HAKIOS_STA_SCAN_DONE, error);
+			lck_mtx_lock(&sta_lock);
+			if (auto_join_pending) {
+				auto_join_pending = false;
+				if (standing.ssid_length != 0 && !asked_join && !asked_leave && !asked_power) {
+					asked_join_what = standing;
+					asked_join = true;
+				}
+			}
+			lck_mtx_unlock(&sta_lock);
+		}
+
+		lck_mtx_lock(&sta_lock);
+		sta_calls = false;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+/* ---- the station side ---------------------------------------------------------------------------------- */
+
+void
+hakios_sta_attach(const struct hakios_sta_ops *ops)
+{
+	thread_t thread;
+
+	if (ops == NULL) {
+		lck_mtx_lock(&sta_lock);
+		sta_ops = NULL;
+		asked_power = asked_scan = asked_join = asked_leave = false;
+		while (sta_calls || sta_reads != 0) {
+			lck_mtx_sleep(&sta_lock, LCK_SLEEP_DEFAULT, (event_t)&sta_calls, THREAD_UNINT);
+		}
+		heard_count = channel_count = 0;
+		lck_mtx_unlock(&sta_lock);
+		return;
+	}
+	if (heard == NULL) {
+		heard = kalloc_data(HEARD_MOST * sizeof(*heard), Z_WAITOK | Z_ZERO);
+	}
+	if (heard == NULL) {
+		hakios_wifi_tell("wifi: no memory for what a scan hears: nobody can ask the radio for a network\n");
+		return;
+	}
+	if (!sta_thread_made) {
+		if (kernel_thread_start(sta_runs, NULL, &thread) != KERN_SUCCESS) {
+			hakios_wifi_tell("wifi: no thread for the station: nobody can ask the radio for a network\n");
+			return;
+		}
+		thread_set_thread_name(thread, "wifi-station");
+		thread_deallocate(thread);
+		sta_thread_made = true;
+	}
+	channel_count = ops->channels(channels, CHANNELS_MOST);
+	{
+		struct hakios_sta_join saved;
+
+		bzero(&saved, sizeof(saved));
+		(void)network_load(&saved);
+		lck_mtx_lock(&sta_lock);
+		sta_ops = ops;
+		sta_on = true;
+		if (standing.ssid_length == 0 && saved.ssid_length != 0 && !asked_join) {
+			standing = saved;
+			auto_join_pending = true;
+			bzero(&asked_scan_what, sizeof(asked_scan_what));
+			asked_scan = true;
+		}
+		lck_mtx_unlock(&sta_lock);
+		memset_s(&saved, sizeof(saved), 0, sizeof(saved));
+	}
+	thread_wakeup((event_t)&sta_ops);
+	hakios_apple80211_event(HAKIOS_STA_POWER, 1);
+}
+
+/*
+ * XCover5 (a50wifi1): the station is attached (en0, so configd sees Wi-Fi) before the radio can scan; the standing
+ * network's scan then failed (ENXIO), its join found nothing ("not in the last scan") and was not tried again, though
+ * the radio's own first scan heard it a second later. The radio says here when it can take calls, and again now and
+ * then while it is not joined: the standing network is scanned for and joined, as after power-on.
+ */
+void
+hakios_sta_radio_ready(void)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops != NULL && sta_on && !asked_join && !asked_scan && !asked_leave && !asked_power) {
+		if (standing.ssid_length == 0 && fallback.ssid_length != 0) {
+			standing = fallback;
+		}
+		if (standing.ssid_length != 0) {
+			auto_join_pending = true;
+			bzero(&asked_scan_what, sizeof(asked_scan_what));
+			asked_scan = true;
+		}
+	}
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+}
+
+void
+hakios_sta_lost(int error)
+{
+	hakios_apple80211_event(HAKIOS_STA_LINK, error != 0 ? error : ECONNRESET);
+}
+
+/* ---- who wants a network ------------------------------------------------------------------------------- */
+
+bool
+hakios_sta_present(void)
+{
+	return sta_ops != NULL;
+}
+
+bool
+hakios_sta_powered(void)
+{
+	return sta_ops != NULL && sta_on;
+}
+
+bool
+hakios_sta_busy(void)
+{
+	bool busy;
+
+	lck_mtx_lock(&sta_lock);
+	busy = sta_ops != NULL && (sta_calls || asked_power || asked_leave || asked_join || asked_scan);
+	lck_mtx_unlock(&sta_lock);
+	return busy;
+}
+
+int
+hakios_sta_ask_power(bool on)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	sta_on = on;
+	asked_power = true;
+	asked_power_on = on;
+	if (!on) {
+		asked_scan = asked_join = asked_leave = false;
+	}
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+hakios_sta_ask_scan(const struct hakios_sta_scan *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	asked_scan_what = *what;
+	asked_scan = true;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+hakios_sta_ask_join_standing(const struct hakios_sta_join *what)
+{
+	int error = hakios_sta_ask_join(what);
+
+	lck_mtx_lock(&sta_lock);
+	if (error == 0) {
+		standing = *what;
+	}
+	lck_mtx_unlock(&sta_lock);
+	return error;
+}
+
+int
+hakios_sta_ask_join(const struct hakios_sta_join *what)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL || !sta_on) {
+		lck_mtx_unlock(&sta_lock);
+		return sta_ops == NULL ? ENXIO : ENETDOWN;
+	}
+	if (standing.ssid_length != 0) {
+		fallback = standing;
+	}
+	bzero(&standing, sizeof(standing));     /* (whoever asks for a network now has the say) */
+	asked_join_what = *what;
+	asked_join = true;
+	asked_leave = false;
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+int
+hakios_sta_ask_leave(void)
+{
+	lck_mtx_lock(&sta_lock);
+	if (sta_ops == NULL) {
+		lck_mtx_unlock(&sta_lock);
+		return ENXIO;
+	}
+	asked_leave = true;
+	asked_join = false;
+	auto_join_pending = false;
+	bzero(&asked_join_what, sizeof(asked_join_what));
+	bzero(&fallback, sizeof(fallback));
+	bzero(&standing, sizeof(standing));
+	lck_mtx_unlock(&sta_lock);
+	thread_wakeup((event_t)&sta_ops);
+	return 0;
+}
+
+bool
+hakios_sta_heard(unsigned index, struct hakios_sta_bss *bss)
+{
+	bool there;
+
+	lck_mtx_lock(&sta_lock);
+	if ((there = index < heard_count)) {
+		*bss = heard[index];
+	}
+	lck_mtx_unlock(&sta_lock);
+	return there;
+}
+
+void
+hakios_sta_state(struct hakios_sta_state *state)
+{
+	const struct hakios_sta_ops *ops;
+
+	bzero(state, sizeof(*state));
+	lck_mtx_lock(&sta_lock);
+	if ((ops = sta_ops) != NULL) {
+		sta_reads++;
+	}
+	lck_mtx_unlock(&sta_lock);
+	if (ops != NULL) {
+		ops->state(state);
+		lck_mtx_lock(&sta_lock);
+		sta_reads--;
+		lck_mtx_unlock(&sta_lock);
+		thread_wakeup((event_t)&sta_calls);
+	}
+}
+
+unsigned
+hakios_sta_channels(struct hakios_sta_channel *out, unsigned most)
+{
+	unsigned count;
+
+	lck_mtx_lock(&sta_lock);
+	count = channel_count < most ? channel_count : most;
+	memcpy(out, channels, count * sizeof(*out));
+	lck_mtx_unlock(&sta_lock);
+	return count;
+}
+
+bool
+hakios_sta_address(uint8_t *address)
+{
+	const struct hakios_sta_ops *ops = sta_ops;
+
+	if (ops != NULL) {
+		memcpy(address, ops->address, 6);
+	}
+	return ops != NULL;
+}
+
+/* ---- the USB console's "wifi scan" ------------------------------------------------------------------------ */
+
+static volatile bool console_scanning;
+
+static void
+console_say(const char *format, ...)
+{
+	char line[200];
+	va_list ap;
+
+	va_start(ap, format);
+	vsnprintf(line, sizeof(line), format, ap);
+	va_end(ap);
+	loader_log_line(line);
+}
+
+/* what is asked of the station and what it heard, as anybody asks: power if it is off, a scan of every channel */
+static void
+console_scan_runs(__unused void *parameter, __unused wait_result_t result)
+{
+	static struct hakios_sta_scan what;
+	static struct hakios_sta_bss bss;
+	unsigned waited, i;
+	int error;
+
+	if (!hakios_sta_present()) {
+		console_say("usb: wifi scan: no station offered (the radio's driver did not get to brcmfmac=7)\n");
+		goto out;
+	}
+	if (!hakios_sta_powered()) {
+		console_say("usb: wifi scan: the radio is off: it is turned on first\n");
+		if ((error = hakios_sta_ask_power(true)) != 0) {
+			console_say("usb: wifi scan: turning it on fails: %d\n", error);
+			goto out;
+		}
+		for (waited = 0; hakios_sta_busy() && waited < 200; waited++) {
+			delay_for_interval(100, NSEC_PER_MSEC);
+		}
+	}
+	bzero(&what, sizeof(what));		/* (no name, every channel, asking) */
+	if ((error = hakios_sta_ask_scan(&what)) != 0) {
+		console_say("usb: wifi scan: the station refuses the scan: %d\n", error);
+		goto out;
+	}
+	console_say("usb: wifi scan: asked; the answer in a few seconds\n");
+	for (waited = 0; hakios_sta_busy() && waited < 300; waited++) {
+		delay_for_interval(100, NSEC_PER_MSEC);
+	}
+	console_say("usb: wifi scan: %s after %u.%u s; heard:\n", hakios_sta_busy() ? "STILL UNDER WAY" : "over", waited / 10,
+	    waited % 10);
+	for (i = 0; hakios_sta_heard(i, &bss); i++) {
+		char name[33];
+		unsigned n;
+
+		for (n = 0; n < bss.ssid_length && n < 32; n++) {
+			name[n] = bss.ssid[n] >= 0x20 && bss.ssid[n] < 0x7f ? (char)bss.ssid[n] : '?';
+		}
+		name[n] = 0;
+		console_say("usb: wifi scan: %2u  %02x:%02x:%02x:%02x:%02x:%02x  %4u MHz  %4d dBm  \"%s\"\n", i, bss.bssid[0],
+		    bss.bssid[1], bss.bssid[2], bss.bssid[3], bss.bssid[4], bss.bssid[5], bss.frequency, bss.rssi,
+		    n != 0 ? name : "(hidden)");
+	}
+	console_say("usb: wifi scan: %u access points\n", i);
+out:
+	console_scanning = false;
+	thread_terminate(current_thread());
+}
+
+void
+hakios_sta_console_scan(void)
+{
+	thread_t thread;
+
+	if (console_scanning) {
+		console_say("usb: wifi scan: one is under way\n");
+		return;
+	}
+	console_scanning = true;
+	if (kernel_thread_start(console_scan_runs, NULL, &thread) != KERN_SUCCESS) {
+		console_scanning = false;
+		console_say("usb: wifi scan: no thread for it\n");
+		return;
+	}
+	thread_set_thread_name(thread, "sta-console-scan");
+	thread_deallocate(thread);
+}
diff --git a/bsd/dev/xc5_drop.c b/bsd/dev/xc5_drop.c
new file mode 100644
index 0000000..d075a86
--- /dev/null
+++ b/bsd/dev/xc5_drop.c
@@ -0,0 +1,633 @@
+/*
+ * XCover5 drop zone: files for the iOS root from the CACHE partition, so the
+ * Mesa libraries reach the phone without reflashing the 12 GB root image.
+ * Copied into the xnu tree as bsd/dev/xc5_drop.c by apply-xcover5.py.
+ *
+ * After wardevsa/ios-a5xelte's herolte_drop.c (patches 0240/0241, the same
+ * kernel family). tools/xcover5/mkdrop.py makes cache.img, flashed by Odin
+ * into CACHE (p34, PIT file name cache.img; Android is not used):
+ *   bytes 0..4095: "XC5DROP1" | u32 version 1 | u32 entry count | u64 bytes | u64 id
+ *   from 4096, back to back, 8-byte aligned:
+ *     u32 path length | u32 mode (0 = directory) | u64 size | path | data
+ * Paths must start with /private/var/xc5/. Once launchd has remounted the
+ * root read-write, a thread writes every entry as root:wheel, unless that
+ * package id is already installed (/private/var/xc5/.drop-id). Boot-arg
+ * xc5drop=0 skips it.
+ *
+ * Also here: xc5_gl_env(), called from exec_extract_strings(), which puts
+ * a library from the drop zone into backboardd (boot-arg xc5gl):
+ *   1  /private/var/xc5/lib/libxc5test.dylib   (Mesa's triangle test)
+ *   2  /private/var/xc5/lib/libxc5eagl.dylib   (CoreAnimation over GLES, HakiOS)
+ *   3  /private/var/xc5/lib/libxc5eagl-b.dylib (CoreAnimation over GLES, Bergamota)
+ * with HERO_LOG_STDERR=1, so the bridges' log reaches the console.
+ * Only the first two launches of a boot get it, so a broken library costs
+ * two backboardd restarts and no more.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(XCOVER5)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/stat.h>
+#include <sys/proc.h>
+#include <sys/mount.h>
+#include <sys/vnode_internal.h>
+#include <sys/namei.h>
+#include <string.h>
+#include <kern/kalloc.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+extern vnode_t rootvnode;
+extern int hz;
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+int xcover5_emmc_read_cache(uint64_t sector, uint32_t count, void *dst);
+void xc5_drop_start(void);
+int xc5_gl_env(const char *path, int pid, const char **extra, int max);
+void xc5_gl_exit(int pid, int rv, uint32_t ns, uint64_t code);
+extern void IOSleep(unsigned int milliseconds);
+/* For the heartbeat: files written, failed, state (1 no package, 2 already
+ * installed, 3 written, 4 root never rw), backboardd launches, insertions. */
+uint32_t xcover5_drop_state[5];
+
+#define XDROP_HEADER    4096u
+#define XDROP_CHUNK     (1u << 20)              /* read 1 MiB at a time */
+#define XDROP_MAX       (192ull << 20)          /* CACHE is 200 MiB */
+#define XDROP_PREFIX    "/private/var/xc5/"
+#define XDROP_DIR       "/private/var/xc5"
+#define XDROP_ID_PATH   "/private/var/xc5/.drop-id"
+#define XDROP_MAX_PATH  255u
+
+struct xdrop_header {
+	char     magic[8];
+	uint32_t version, count;
+	uint64_t bytes, id;
+};
+
+struct xdrop_entry {
+	uint32_t path_len, mode;
+	uint64_t size;
+};
+
+/* Sequential reader over the payload (CACHE byte 4096 on). */
+struct xdrop_reader {
+	uint8_t  *buf;
+	uint64_t  pos;          /* payload offset of buf[0] */
+	uint32_t  have;
+	uint64_t  limit;        /* payload bytes */
+};
+
+static int
+xdrop_fill(struct xdrop_reader *r, uint64_t off)
+{
+	uint64_t first = off & ~511ull;         /* payload byte, sector aligned */
+	uint64_t left = r->limit - first;
+	uint32_t n = (uint32_t)MIN((uint64_t)XDROP_CHUNK, (left + 511) & ~511ull) / 512u;
+	int error = xcover5_emmc_read_cache((XDROP_HEADER + first) / 512u, n, r->buf);
+	r->pos = first;
+	r->have = error ? 0 : n * 512u;
+	return error;
+}
+
+/* Pointer to len bytes at payload offset off (len <= XDROP_CHUNK / 2). */
+static const uint8_t *
+xdrop_at(struct xdrop_reader *r, uint64_t off, uint32_t len)
+{
+	if (off + len > r->limit) {
+		return NULL;
+	}
+	if (off < r->pos || off + len > r->pos + r->have) {
+		if (xdrop_fill(r, off) || off + len > r->pos + r->have) {
+			return NULL;
+		}
+	}
+	return r->buf + (off - r->pos);
+}
+
+static bool
+xdrop_has_dotdot(const char *path)
+{
+	for (const char *p = path; *p; p++) {
+		if (p[0] == '.' && p[1] == '.' && (p == path || p[-1] == '/') &&
+		    (p[2] == '/' || p[2] == '\0')) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static int
+xdrop_mkdir(const char *path, vfs_context_t ctx)
+{
+	struct nameidata nd;
+	NDINIT(&nd, CREATE, OP_MKDIR, LOCKPARENT | AUDITVNPATH1, UIO_SYSSPACE,
+	    CAST_USER_ADDR_T(path), ctx);
+	int error = namei(&nd);
+	if (error) {
+		return error;
+	}
+	vnode_t dvp = nd.ni_dvp, vp = nd.ni_vp;
+	if (vp == NULLVP) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_type, VDIR);
+		VATTR_SET(&va, va_mode, 0755);
+		error = vn_mkdir(dvp, &vp, &nd, &va, ctx);
+	}
+	nameidone(&nd);
+	if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	vnode_put(dvp);
+	return error;
+}
+
+static int
+xdrop_write(const char *path, int mode, const void *data, size_t size, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int resid = 0;
+	int error = vnode_open(path, FWRITE | O_CREAT | O_TRUNC, mode & ALLPERMS, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)data, (int)size, 0, UIO_SYSSPACE, IO_UNIT,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	vnode_close(vp, FWRITE, ctx);
+	return error ? error : (resid ? EIO : 0);
+}
+
+static int
+xdrop_file(struct xdrop_reader *r, const char *path, int mode, uint64_t data, uint64_t size,
+    vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int error = vnode_open(path, FWRITE | O_CREAT | O_TRUNC, mode & ALLPERMS, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	for (uint64_t done = 0; done < size && !error;) {
+		uint32_t n = (uint32_t)MIN(size - done, (uint64_t)(XDROP_CHUNK / 2));
+		const uint8_t *p = xdrop_at(r, data + done, n);
+		int resid = 0;
+		if (p == NULL) {
+			error = EIO;
+			break;
+		}
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)p, (int)n, (off_t)done, UIO_SYSSPACE,
+		    IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!error && resid) {
+			error = EIO;
+		}
+		done += n;
+	}
+	if (!error) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_mode, mode & ALLPERMS);
+		error = vnode_setattr(vp, &va, ctx);
+	}
+	vnode_close(vp, FWRITE, ctx);
+	return error;
+}
+
+/* The whole of a small file (up to max bytes) into buf; its length, or -1. */
+static int
+xdrop_read_small(const char *path, void *buf, int max, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int resid = 0;
+	if (vnode_open(path, FREAD, 0, 0, &vp, ctx) != 0) {
+		return -1;
+	}
+	int error = vn_rdwr(UIO_READ, vp, (caddr_t)buf, max, 0, UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid,
+	    vfs_context_proc(ctx));
+	vnode_close(vp, FREAD, ctx);
+	return error ? -1 : max - resid;
+}
+
+/*
+ * launchd's list of disabled jobs, after herolte (wardevsa/ios-a5xelte, branch herolte: hero-run.c writes
+ * /private/var/db/com.apple.xpc.launchd/disabled.plist; tools/herolte-disabled.list has com.apple.fairplayd.H2
+ * first). Boots 81-83: fairplayd.H2 starts and exits at once, so launchd keeps its port and every FairPlay client
+ * (checkpointd, and through it the Photos app) waits for ever. A disabled job has no port, so the client's lookup
+ * fails at once instead. The package carries the file as /private/var/xc5/launchd-disabled.plist; it is copied over
+ * launchd's own, whose first contents are kept once as /private/var/xc5/launchd-disabled.orig.plist (an empty file
+ * if there was none). launchd reads the list when it starts: it takes effect from the NEXT boot.
+ */
+#define XDROP_LD_SRC    "/private/var/xc5/launchd-disabled.plist"
+#define XDROP_LD_ORIG   "/private/var/xc5/launchd-disabled.orig.plist"
+#define XDROP_LD_DIR    "/private/var/db/com.apple.xpc.launchd"
+#define XDROP_LD_DST    "/private/var/db/com.apple.xpc.launchd/disabled.plist"
+#define XDROP_LD_MAX    65536
+
+static void
+xdrop_launchd_disabled(vfs_context_t ctx)
+{
+	char *buf = kalloc_data(XDROP_LD_MAX, Z_WAITOK);
+	if (buf == NULL) {
+		return;
+	}
+	int n = xdrop_read_small(XDROP_LD_SRC, buf, XDROP_LD_MAX, ctx);
+	if (n > 0 && n < XDROP_LD_MAX) {
+		if (xdrop_read_small(XDROP_LD_ORIG, buf + n, 1, ctx) < 0) {      /* no backup yet */
+			char *old = kalloc_data(XDROP_LD_MAX, Z_WAITOK);
+			int m = old ? xdrop_read_small(XDROP_LD_DST, old, XDROP_LD_MAX, ctx) : -1;
+			int e = xdrop_write(XDROP_LD_ORIG, 0644, old, m > 0 ? (size_t)m : 0, ctx);
+			printf("XC5 DROP: launchd's disabled.plist (%d bytes) kept as %s: %d\n", m, XDROP_LD_ORIG, e);
+			if (old) {
+				kfree_data(old, XDROP_LD_MAX);
+			}
+		}
+		(void)xdrop_mkdir(XDROP_LD_DIR, ctx);
+		int e = xdrop_write(XDROP_LD_DST, 0644, buf, (size_t)n, ctx);
+		printf("XC5 DROP: %s: %d bytes from the package: %d (next boot)\n", XDROP_LD_DST, n, e);
+	}
+	kfree_data(buf, XDROP_LD_MAX);
+}
+
+static uint64_t
+xdrop_installed_id(vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	uint64_t id = 0;
+	int resid = 0;
+	if (vnode_open(XDROP_ID_PATH, FREAD, 0, 0, &vp, ctx) == 0) {
+		if (vn_rdwr(UIO_READ, vp, (caddr_t)&id, sizeof(id), 0, UIO_SYSSPACE, 0,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx)) != 0 || resid != 0) {
+			id = 0;
+		}
+		vnode_close(vp, FREAD, ctx);
+	}
+	return id;
+}
+
+static void
+xdrop_apply(void)
+{
+	struct xdrop_reader r = { .buf = kalloc_data(XDROP_CHUNK, Z_WAITOK) };
+	if (r.buf == NULL) {
+		return;
+	}
+	struct xdrop_header h;
+	if (xcover5_emmc_read_cache(0, XDROP_HEADER / 512u, r.buf) != 0) {
+		printf("XC5 DROP: CACHE not readable\n");
+		goto out;
+	}
+	memcpy(&h, r.buf, sizeof(h));
+	if (memcmp(h.magic, "XC5DROP1", 8) != 0 || h.version != 1 || h.bytes > XDROP_MAX) {
+		printf("XC5 DROP: no drop package in CACHE\n");
+		xcover5_drop_state[2] = 1;
+		goto out;
+	}
+	vfs_context_t ctx = vfs_context_kernel();
+	(void)xdrop_mkdir(XDROP_DIR, ctx);
+	if (xdrop_installed_id(ctx) == h.id) {
+		printf("XC5 DROP: package %llu already installed\n", h.id);
+		xcover5_drop_state[2] = 2;
+		goto out;
+	}
+	r.limit = h.bytes;
+	uint64_t off = 0;
+	unsigned files = 0, failed = 0;
+	char path[XDROP_MAX_PATH + 1];
+	for (uint32_t i = 0; i < h.count; i++) {
+		const uint8_t *p = xdrop_at(&r, off, sizeof(struct xdrop_entry));
+		struct xdrop_entry e;
+		if (p == NULL) {
+			failed++;
+			break;
+		}
+		memcpy(&e, p, sizeof(e));
+		if (e.path_len == 0 || e.path_len > XDROP_MAX_PATH ||
+		    (p = xdrop_at(&r, off + sizeof(e), e.path_len)) == NULL) {
+			failed++;
+			break;
+		}
+		memcpy(path, p, e.path_len);
+		path[e.path_len] = '\0';
+		uint64_t data = off + ((sizeof(e) + e.path_len + 7) & ~7ull);
+		off = data + ((e.size + 7) & ~7ull);
+		int error;
+		if (strncmp(path, XDROP_PREFIX, strlen(XDROP_PREFIX)) != 0 || xdrop_has_dotdot(path)) {
+			error = EPERM;
+		} else if (e.mode == 0) {
+			error = xdrop_mkdir(path, ctx);
+			error = error == EEXIST ? 0 : error;
+		} else {
+			error = xdrop_file(&r, path, (int)e.mode, data, e.size, ctx);
+		}
+		if (error) {
+			failed++;
+			printf("XC5 DROP: %s: error %d\n", path, error);
+		} else {
+			files++;
+		}
+	}
+	if (failed == 0) {
+		xdrop_launchd_disabled(ctx);
+		(void)xdrop_write(XDROP_ID_PATH, 0644, &h.id, sizeof(h.id), ctx);
+	}
+	printf("XC5 DROP: package %llu: %u entries written, %u failed\n", h.id, files, failed);
+	xcover5_drop_state[0] = files;
+	xcover5_drop_state[1] = failed;
+	xcover5_drop_state[2] = 3;
+out:
+	kfree_data(r.buf, XDROP_CHUNK);
+}
+
+/* Wait (up to 3 minutes) for launchd's read-write remount of the root. */
+static void
+xdrop_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	for (int s = 0; s < 180; s++) {
+		if (rootvnode != NULLVP && !vfs_isrdonly(vnode_mount(rootvnode))) {
+			xdrop_apply();
+			return;
+		}
+		(void)tsleep(&chan, PZERO, "xc5drop", hz);
+	}
+	printf("XC5 DROP: root never read-write, nothing written\n");
+	xcover5_drop_state[2] = 4;
+}
+
+void
+xc5_drop_start(void)
+{
+	int on = 1;
+	thread_t thread;
+	(void)PE_parse_boot_argn("xc5drop", &on, sizeof(on));
+	if (on && kernel_thread_start(xdrop_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+#define XGL_TARGET      "/usr/libexec/backboardd"
+#define XGL_MAX_LAUNCHES 2
+
+/*
+ * Boot 51: library inserted into the environment, yet XC5GPU never had a
+ * client: dyld honours DYLD_* only if AMFI allows it (amfi_check_dyld_policy_
+ * self, __mac_syscall("AMFI", 90)), and with no "AMFI" policy it treats the
+ * process as restricted. sweet_amfi.c's "AMFI" policy answers through this:
+ * the backboardd that got the library may insert it (herolte 0246).
+ */
+#define AMFI_DYLD_OUTPUT_ALLOW_AT_PATH                  (1ull << 0)
+#define AMFI_DYLD_OUTPUT_ALLOW_PATH_VARS                (1ull << 1)
+#define AMFI_DYLD_OUTPUT_ALLOW_FAILED_LIBRARY_INSERTION (1ull << 5)
+static int xgl_pid = -1;
+uint64_t xc5_gl_dyld_flags(void);
+
+/*
+ * Boot-arg xc5pbhook=1: PosterBoard gets /private/var/xc5/lib/libxc5pb.dylib
+ * (gpu/eagl/src/xc5_pbhook.c). Boots 56-63: it traps on
+ * !_stateLock_switcherConfiguration in its first-time switcher setup; the
+ * configuration's lazy getter has made one before the setup ran. The library
+ * empties it first. The first XPB_MAX launches of a boot get it; their pids
+ * are allowed DYLD_INSERT_LIBRARIES like backboardd's.
+ */
+/*
+ * Boot-arg xc5media=1: mediaserverd gets /private/var/xc5/lib/libxc5media.dylib
+ * (gpu/eagl/src/xc5_media.c: its capture stack's portrait-filter prewarm is
+ * skipped, as HakiOS's inject_media.c does, so the daemon stays up to decode the
+ * stock wallpaper's HEIC pictures for everybody). Same table, same pid list.
+ */
+#define XPB_MAX         24
+static int xpb_pids[XPB_MAX];
+static int xpb_count;
+
+static const struct {
+	const char *suffix, *bootarg, *lib, *env, *name;
+} xpb_targets[] = {
+	{ "/PosterBoard.app/PosterBoard", "xc5pbhook", "/private/var/xc5/lib/libxc5pb.dylib",
+	  "DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5pb.dylib", "PosterBoard" },
+	{ "/usr/sbin/mediaserverd", "xc5media", "/private/var/xc5/lib/libxc5media.dylib",
+	  "DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5media.dylib", "mediaserverd" },
+	/* xc5poster=1: CollectionsPoster's start sampled (gpu/eagl/src/xc5_poster.c, boots 71-72's check-in timeout) */
+	{ "/CollectionsPoster.appex/CollectionsPoster", "xc5poster", "/private/var/xc5/lib/libxc5poster.dylib",
+	  "DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5poster.dylib", "CollectionsPoster" },
+	/* xc5wall=1: a still picture as the wallpaper (gpu/eagl/src/xc5_sb.c, after herolte's herosb.c) */
+	{ "/SpringBoard.app/SpringBoard", "xc5wall", "/private/var/xc5/lib/libxc5sb.dylib",
+	  "DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5sb.dylib", "SpringBoard" },
+	/* xc5photos=1: the Photos app's main thread sampled (same libxc5poster.dylib); boot 80: it stays a white
+	 * screen with no crash, and its own start was hidden under that screen */
+	{ "/MobileSlideShow.app/MobileSlideShow", "xc5photos", "/private/var/xc5/lib/libxc5poster.dylib",
+	  "DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5poster.dylib", "MobileSlideShow" },
+	/* xc5ckpt=1: checkpointd's FairPlay Mach call gets a time limit (gpu/eagl/src/xc5_ckpt.c, boot 82:
+	 * fairplayd.H2 starts and exits at once, so the call waited forever and so did the Photos app).
+	 * Before the xc5photos entry: one library per process, the first entry that is on wins. */
+	{ "/usr/libexec/checkpointd", "xc5ckpt", "/private/var/xc5/lib/libxc5ckpt.dylib",
+	  "DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5ckpt.dylib:/private/var/xc5/lib/libxc5poster.dylib",
+	  "checkpointd" },
+	/* boot 84: the Photos app's library comes up empty (numberOfSections 0): assetsd's threads sampled */
+	{ "/AssetsLibrary.framework/Support/assetsd", "xc5photos", "/private/var/xc5/lib/libxc5poster.dylib",
+	  "DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5poster.dylib", "assetsd" },
+	/* boot 81: Photos' main thread waits on checkpointd (MCCopyCheckpointValue); its threads sampled too */
+	{ "/usr/libexec/checkpointd", "xc5photos", "/private/var/xc5/lib/libxc5poster.dylib",
+	  "DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5poster.dylib", "checkpointd" },
+	/* xc5mtl=1/2: Metal M3, chronod (the widgets' renderer) asks Metal for a device with
+	 * RedwoodMetal.bundle named on IOAcceleratorES (gpu/metal/xc5_mtl.c; needs xc5metal=1) */
+	{ "/ChronoCore.framework/Support/chronod", "xc5mtl", "/private/var/xc5/lib/libxc5mtl.dylib",
+	  "DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5mtl.dylib", "chronod" },
+	/* xc5net=1: configd learns the kernel's Wi-Fi interface (en0) as a service with a DNS server, so that it becomes
+	 * the primary interface and names resolve (gpu/eagl/src/xc5_net.c; needs xc5wifi=1) */
+	{ "/usr/libexec/configd", "xc5net", "/private/var/xc5/lib/libxc5net.dylib",
+	  "DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5net.dylib", "configd" },
+};
+
+static int
+xpb_pid_allowed(int pid)
+{
+	for (int i = 0; i < xpb_count && i < XPB_MAX; i++) {
+		if (xpb_pids[i] == pid) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static int
+xpb_env(const char *path, int pid, const char **extra, int max)
+{
+	size_t len = path != NULL ? strlen(path) : 0;
+
+	if (max < 1) {
+		return 0;
+	}
+	for (size_t t = 0; t < sizeof(xpb_targets) / sizeof(xpb_targets[0]); t++) {
+		size_t tlen = strlen(xpb_targets[t].suffix);
+		int on = 0;
+		if (len < tlen || strcmp(path + len - tlen, xpb_targets[t].suffix) != 0) {
+			continue;
+		}
+		if (!PE_parse_boot_argn(xpb_targets[t].bootarg, &on, sizeof(on)) || !on) {
+			continue;       /* a later entry for the same program may be on (checkpointd: xc5ckpt, xc5photos) */
+		}
+		if (xpb_count >= XPB_MAX) {
+			printf("XC5 PB: %s (pid %d): no room, stock\n", xpb_targets[t].name, pid);
+			return 0;
+		}
+		vnode_t vp = NULLVP;
+		if (vnode_lookup(xpb_targets[t].lib, 0, &vp, vfs_context_kernel()) != 0) {
+			printf("XC5 PB: %s (pid %d): no %s, stock\n", xpb_targets[t].name, pid, xpb_targets[t].lib);
+			return 0;
+		}
+		vnode_put(vp);
+		xpb_pids[xpb_count++] = pid;
+		extra[0] = xpb_targets[t].env;
+		printf("XC5 PB: %s (pid %d): %s inserted\n", xpb_targets[t].name, pid, xpb_targets[t].lib);
+		return 1;
+	}
+	return 0;
+}
+
+uint64_t
+xc5_gl_dyld_flags(void)
+{
+	int self = proc_selfpid();
+	if ((xgl_pid < 0 || self != xgl_pid) && !xpb_pid_allowed(self)) {
+		return 0;
+	}
+	return AMFI_DYLD_OUTPUT_ALLOW_AT_PATH | AMFI_DYLD_OUTPUT_ALLOW_PATH_VARS |
+	       AMFI_DYLD_OUTPUT_ALLOW_FAILED_LIBRARY_INSERTION;
+}
+
+int
+xc5_gl_env(const char *path, int pid, const char **extra, int max)
+{
+	static int mode = -1, launches;
+	if (mode < 0) {
+		mode = 0;
+		(void)PE_parse_boot_argn("xc5gl", &mode, sizeof(mode));
+	}
+	if (path != NULL && strcmp(path, XGL_TARGET) != 0) {
+		return xpb_env(path, pid, extra, max);
+	}
+	if (mode <= 0 || path == NULL || max < 2) {
+		return 0;
+	}
+	static const char *const libs[] = {
+		"/private/var/xc5/lib/libxc5test.dylib",        /* 1: Mesa's triangle test */
+		"/private/var/xc5/lib/libxc5eagl.dylib",        /* 2: HakiOS's EAGL bridge */
+		"/private/var/xc5/lib/libxc5eagl-b.dylib",      /* 3: Bergamota's EAGL shim */
+	};
+	static const char *const envs[] = {
+		"DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5test.dylib",
+		"DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5eagl.dylib",
+		"DYLD_INSERT_LIBRARIES=/private/var/xc5/lib/libxc5eagl-b.dylib",
+	};
+	if (mode > 3) {
+		return 0;
+	}
+	const char *lib = libs[mode - 1];
+	int launch = ++launches;
+	xcover5_drop_state[3] = (uint32_t)launch;
+	if (launch > XGL_MAX_LAUNCHES) {
+		printf("XC5 GL: backboardd launch %d: stock\n", launch);
+		return 0;
+	}
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(lib, 0, &vp, vfs_context_kernel()) != 0) {
+		printf("XC5 GL: backboardd launch %d: no %s, stock\n", launch, lib);
+		return 0;
+	}
+	vnode_put(vp);
+	extra[0] = envs[mode - 1];
+	/* The bridges' stderr (and Mesa's) goes to the kernel log (gpu/eagl/src/hero_log.c). */
+	extra[1] = "HERO_LOG_STDERR=1";
+	xgl_pid = pid;
+	printf("XC5 GL: backboardd launch %d (pid %d): %s inserted\n", launch, pid, lib);
+	xcover5_drop_state[4]++;
+	return 2;
+}
+
+/*
+ * proc_prepareexit() of every process: when a backboardd we inserted a library
+ * into exits, say how, then replay the GPU clients' log (XC5GPU.cpp) slowly
+ * enough to film: 16 lines, then 5 s, and so on. Only for the inserted
+ * launches (two per boot), on the exiting thread.
+ */
+extern char xcover5_gllog_first[24][100];
+extern char xcover5_gllog_ring[40][100];
+extern uint32_t xcover5_gllog_n;
+uint32_t xcover5_gl_exit[4];    /* heartbeat: pid, wait status, reason namespace, reason code */
+
+static void
+xgl_say(const char *line, int *shown)
+{
+	printf("XC5 GLLOG %s\n", line);
+	if (++*shown % 16 == 0) {
+		IOSleep(5000);
+	}
+}
+
+void
+xc5_gl_exit(int pid, int rv, uint32_t ns, uint64_t code)
+{
+	if (xgl_pid < 0 || pid != xgl_pid) {
+		return;
+	}
+	xgl_pid = -1;
+	xcover5_gl_exit[0] = (uint32_t)pid;
+	xcover5_gl_exit[1] = (uint32_t)rv;
+	xcover5_gl_exit[2] = ns;
+	xcover5_gl_exit[3] = (uint32_t)code;
+	printf("XC5 GL: backboardd pid %d exits: status 0x%x (sig %d, exit %d) reason ns %u code 0x%llx; %u log lines\n",
+	    pid, rv, rv & 0x7f, (rv >> 8) & 0xff, ns, code, xcover5_gllog_n);
+	IOSleep(3000);
+	int shown = 0;
+	uint32_t n = xcover5_gllog_n;
+	for (uint32_t i = 0; i < n && i < 24; i++) {
+		xgl_say(xcover5_gllog_first[i], &shown);
+	}
+	if (n > 24 + 40) {
+		printf("XC5 GLLOG ... %u lines skipped ...\n", n - 24 - 40);
+	}
+	for (uint32_t i = n > 24 + 40 ? n - 40 : 24; i < n; i++) {
+		xgl_say(xcover5_gllog_ring[(i - 24) % 40], &shown);
+	}
+	printf("XC5 GLLOG end (pid %d)\n", pid);
+	IOSleep(5000);
+}
+
+/*
+ * How many times (1, 2, ...) a log line of this kind for this name has been asked for. Callers say a line only the
+ * first few times, so a process that is started or crashes every few seconds (locationd) does not fill the RAM log
+ * that PREV BOOT LOG shows (wifi58: ~6000 lines, mostly the same few). xc5logall=1: always 1 (everything said).
+ */
+int xc5_log_count(const char *kind, const char *name);
+int
+xc5_log_count(const char *kind, const char *name)
+{
+	static struct {
+		char key[48];
+		int n;
+	} seen[96];
+	static int used, all = -1;
+	char key[48];
+	if (all < 0) {
+		int v = 0;
+		(void)PE_parse_boot_argn("xc5logall", &v, sizeof(v));
+		all = v != 0;
+	}
+	if (all) {
+		return 1;
+	}
+	snprintf(key, sizeof(key), "%s %s", kind, name);
+	for (int i = 0; i < used; i++) {
+		if (strncmp(seen[i].key, key, sizeof(key)) == 0) {
+			return ++seen[i].n;
+		}
+	}
+	if (used < (int)(sizeof(seen) / sizeof(seen[0]))) {
+		strlcpy(seen[used].key, key, sizeof(seen[used].key));
+		seen[used].n = 1;
+		used++;
+	}
+	return 1;
+}
+#endif /* XCOVER5 */
