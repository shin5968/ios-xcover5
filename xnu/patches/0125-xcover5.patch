+	static int32_t col_lx[2048];
+	uint32_t sw = (uint32_t)((uint64_t)lw * ph / lh);
+	if (sw > pw) {
+		sw = pw;
+	}
+	uint32_t ox = (pw - sw) / 2;
+	uintptr_t src = s->kernelAddress();
+	if (src == 0 || s->memory == NULL || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    (s->bytesPerElement != 0 && s->bytesPerElement != 4) || pw > 2048) {
+		return;
+	}
+	if (w <= 0 || h <= 0) {
+		w = (int32_t)s->width;
+		h = (int32_t)s->height;
+	}
+	if (sx < 0 || sy < 0) {
+		sx = sy = 0;
+	}
+	if (dx < 0 || dy < 0) {
+		dx = dy = 0;
+	}
+	for (uint32_t px = 0; px < sw; px++) {
+		col_lx[px] = (int32_t)((uint64_t)px * lw / sw);
+	}
+	uint64_t len = s->memory->getLength();
+	for (uint32_t py = 0; py < ph; py++) {
+		volatile uint32_t *out = (volatile uint32_t *)(pixels + (uint64_t)py * rowBytes);
+		for (uint32_t px = 0; px < ox; px++) {
+			out[px] = 0;
+			out[pw - 1 - px] = 0;
+		}
+		int32_t ly = (int32_t)((uint64_t)py * lh / ph);
+		int32_t ry = sy + ly - dy;
+		if (ly < dy || ly >= dy + h || ry >= (int32_t)s->height) {
+			continue;
+		}
+		uint64_t rowoff = s->offset + (uint64_t)ry * s->bytesPerRow;
+		for (uint32_t px = 0; px < sw; px++) {
+			int32_t lx = col_lx[px];
+			int32_t rx = sx + lx - dx;
+			if (lx < dx || lx >= dx + w || rx >= (int32_t)s->width) {
+				continue;
+			}
+			uint64_t o = rowoff + (uint64_t)rx * 4;
+			if (o + 4 <= len) {
+				out[ox + px] = *(const uint32_t *)(src + o);
+			}
+		}
+	}
+}
