+{
+	struct mx_stream *st = (struct mx_stream *)(mem + mgmt_in_ref);
+	volatile uint32_t *ri = (volatile uint32_t *)(mem + st->buf.read_index), *wi = (volatile uint32_t *)(mem + st->buf.write_index);
+	unsigned taken = 0;
