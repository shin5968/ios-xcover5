+++ b/bsd/kern/kern_exec.c
@@ -5741,6 +5741,29 @@ exec_extract_strings(struct image_params *imgp)
 		imgp->ip_envc++;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	/* XCover5: a drop-zone library for backboardd (boot-arg xc5gl, xc5_drop.c). */
+	{
+		extern int xc5_gl_env(const char *path, int pid, const char **extra, int max) __attribute__((weak));
+		const char *extra[2];
