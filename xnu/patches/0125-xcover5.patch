+static void
+xcover5_touch_start(void)
+{
+	int ready = 0;
+	thread_t thread;
+	(void)PE_parse_boot_argn("xc5touch", &ready, sizeof(ready));
+	(void)PE_parse_boot_argn("sweetfb_native", &xc5ts_native, sizeof(xc5ts_native));
+	if (!ready) {
+		printf("XC5 TOUCH: off (loader did not start the firmware)\n");
+		return;
+	}
+	xc5ts_spi = ml_io_map(XC5_SPI, 0x1000);
+	xc5ts_pin = ml_io_map(XC5_CMGP_PIN, 0x1000);
+	if (!xc5ts_spi || !xc5ts_pin) {
+		printf("XC5 TOUCH: MMIO mapping failed\n");
+		return;
+	}
+	uint8_t id[8];
+	bool ok = xc5ts_read(0x1f64e, id, 6);
+	printf("XC5 TOUCH: spi_st=%#x id %02x %02x %02x %02x %02x %02x%s\n",
+	    xc5ts_rd(xc5ts_spi, 0x14), id[0], id[1], id[2], id[3], id[4], id[5],
+	    ok ? "" : " (timeout)");
+	if (kernel_thread_start(xc5ts_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
