+int hakios_wifi_tell(const char *format, ...) __printflike(1, 2);
+
+/* a firmware file: the A50 read them from its small image's fw/; here from the drop zone, /private/var/xc5/wifi/ */
+const uint8_t *hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+
+/* a file of a partition (the A50's EFS for the factory Wi-Fi address): none here, always ENOENT */
+int hakios_partition_file(const char *partition, const char *mount, const char *path, uint64_t max, const uint8_t **data,
+    uint64_t *size);
+
+#endif /* _SYS_HAKIOS_INPUT_H_ */
diff --git a/bsd/sys/hakios.macaddr.h b/bsd/sys/hakios.macaddr.h
new file mode 100644
index 0000000..8baed74
--- /dev/null
+++ b/bsd/sys/hakios.macaddr.h
@@ -0,0 +1,69 @@
+/*
+ * Darwin-on-hakios: a radio's own address written as text, as Samsung's Android keeps the Galaxy S9's in
+ * /efs/wifi/.mac.info ("00:12:34:AB:CD:EF" and a newline; bcmdhd's dhd_custom_cis.c, dhd_set_macaddr_from_file(),
+ * reads it with MAC_CUSTOM_FORMAT, and writes a random one with Samsung's prefix 00:12:34 when the file is missing or
+ * all zeroes) and as boot-arg wifi_mac gives it. Nothing but C here, so that tools/brcmfmac-test.py compiles it on the
+ * machine the kernel is built on.
+ *
+ * hakios_macaddr_parse(): six bytes of one or two hexadecimal digits each, separated by ':' (or '-'), spaces and a line's
+ * end around them; nothing else after. An address of all zeroes, a group address (bit 0 of the first byte) and anything
+ * else is refused: 0, and nothing written. 1 when `address` has it.
+ */
+#ifndef _SYS_HAKIOS_MACADDR_H_
+#define _SYS_HAKIOS_MACADDR_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+static inline int
+hakios_macaddr_parse(const char *text, size_t length, uint8_t address[6])
+{
+	uint8_t bytes[6];
+	unsigned count = 0, digits = 0, value = 0, any = 0;
+	size_t i = 0;
+
+	while (i < length && (text[i] == ' ' || text[i] == '\t')) {
+		i++;
+	}
+	for (;; i++) {
+		char c = i < length ? text[i] : 0;
+		int digit = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+
+		if (digit >= 0) {
+			if (digits == 2 || count == 6) {
+				return 0;
+			}
+			value = value << 4 | (unsigned)digit;
+			digits++;
+			continue;
+		}
+		if (digits == 0) {
+			return 0;               /* (a separator with no digits before it, or nothing at all) */
+		}
+		bytes[count++] = (uint8_t)value;
+		any |= value;
+		digits = value = 0;
+		if (count < 6) {
+			if (c != ':' && c != '-') {
+				return 0;
+			}
+			continue;
+		}
+		/* the sixth: only blanks and the line's end may follow, up to the end of the text or a NUL */
+		for (; i < length && text[i] != 0; i++) {
+			if (text[i] != ' ' && text[i] != '\t' && text[i] != '\r' && text[i] != '\n') {
+				return 0;
+			}
+		}
+		break;
+	}
+	if (any == 0 || (bytes[0] & 1) != 0) {
+		return 0;
+	}
+	for (unsigned b = 0; b < 6; b++) {
+		address[b] = bytes[b];
+	}
+	return 1;
+}
+
+#endif
diff --git a/bsd/sys/hakios.net.h b/bsd/sys/hakios.net.h
new file mode 100644
index 0000000..599a3e7
--- /dev/null
+++ b/bsd/sys/hakios.net.h
@@ -0,0 +1,69 @@
+/*
+ * en0, and what stands behind it.
+ *
+ * The network interface Darwin uses here is made in drivers/net/hakios.net.c with the kernel's own
+ * interface KPI: Ethernet as far as the rest of the kernel and user space can tell. What carries
+ * the frames is a "link", a driver of its own that knows nothing about interfaces: QEMU's virtio
+ * network device today (drivers/net/hakios.virtio_net.c), the phone's radio or frames carried over
+ * the boot loader's USB channel tomorrow. This is all the two know of each other.
+ *
+ * A link driver
+ *   - fills in a struct hakios_net_link and calls hakios_net_attach() once, when it is ready
+ *     to carry frames (for a radio: when its firmware is up, not when it has joined a network);
+ *   - hands every frame that arrives to hakios_net_input(): from its own thread, or from
+ *     the poll function the interface's thread calls for it. Not from interrupt context;
+ *   - says with hakios_net_link_state() when frames can pass and when they no longer can
+ *     (the cable, or for a radio: associated and the keys set). configd starts DHCP on that.
+ * A frame is what goes over an Ethernet cable without the checksum at its end: destination,
+ * source, type, payload; at most HAKIOS_NET_FRAME_MAX bytes. A radio whose frames are 802.11
+ * converts in its driver (or has its firmware do it: "Ethernet decap/encap").
+ */
+#ifndef _SYS_HAKIOS_NET_H_
+#define _SYS_HAKIOS_NET_H_
+
+#ifdef KERNEL
+#include <sys/kpi_mbuf.h>
+
+#define HAKIOS_NET_FRAME_MAX   1514
+#define HAKIOS_NET_UNITS       2       /* en0: the radio (or virtio); en1: the modem's packets (hakios.cell.c) */
+
+struct hakios_net_link {
+	const char *    name;           /* for the log */
+	unsigned        unit;           /* which enN this is (0 unless said otherwise) */
+	uint8_t         address[6];     /* the interface's Ethernet address */
+	bool            wireless;       /* the interface is told to be Wi-Fi (its "subfamily"), which is how the
+	                                 * network stack and configd tell a radio from a cable */
+	bool            up;             /* frames can pass from the start (else: wait for hakios_net_link_state()) */
+	/*
+	 * Send one frame: a chain of mbufs, `length` bytes in all, the Ethernet header first. The
+	 * packet stays the caller's: copy it (mbuf_copydata()). Returns false if it had to be dropped.
+	 * Called by one thread at a time, never from interrupt context.
+	 */
+	bool            (*transmit)(mbuf_t packet, size_t length);
+	/*
+	 * Optional. Look whether frames have arrived and call hakios_net_input() for each; returns
+	 * how many there were. The interface's thread calls it every 2 ms while frames are coming and
+	 * every 10 ms when none has for a while. A link that has a thread or an interrupt of its own
+	 * leaves it NULL.
+	 */
+	unsigned        (*poll)(void);
+	/* Optional. A few words of what the link has counted, for the USB console's "wifi stat" (no newline). */
+	void            (*counts)(char *line, size_t room);
+};
+
+/* Make en<unit> on top of that link (the structure must stay). One link per unit, once: false if there is one already. */
+bool hakios_net_attach(const struct hakios_net_link *link);
+/* A frame has arrived (on en0 / on en<unit>). Copied; the buffer is the caller's again on return. */
+void hakios_net_input(const uint8_t *frame, size_t length);
+void hakios_net_input_unit(unsigned unit, const uint8_t *frame, size_t length);
+/* Frames can pass now / can no longer pass (on en0 / on en<unit>). */
+void hakios_net_link_state(bool up);
+void hakios_net_link_state_unit(unsigned unit, bool up);
+
+void hakios_net_init(void);            /* the links there are: each looks for its hardware (or its boot-arg) */
+/* an Apple80211 request (SIOCGA80211, SIOCSA80211) for the interface of a radio: hakios.apple80211.c */
+errno_t hakios_apple80211_ioctl(u_long command, void *data);
+void hakios_virtio_net_init(void);     /* boot-arg virtio_net=1: QEMU's virtio network device */
+#endif /* KERNEL */
+
+#endif /* _SYS_HAKIOS_NET_H_ */
diff --git a/bsd/sys/hakios.sta.h b/bsd/sys/hakios.sta.h
new file mode 100644
index 0000000..664f116
--- /dev/null
+++ b/bsd/sys/hakios.sta.h
@@ -0,0 +1,125 @@
+/*
+ * Darwin-on-hakios: the station boundary.
+ *
+ * On one side whatever does the scanning and the joining with a radio: the station logic over
+ * ath11k on the phone (wifi/lx in the repository). On the other whoever wants a network: the
+ * Apple80211 requests of Darwin's Wi-Fi side, answered in drivers/wifi/hakios.apple80211.c, and the
+ * kernel's own join of the network it was given in a file (drivers/wifi/hakios.wifi.c). Frames do
+ * not pass here, and neither does "the link is up": those go through bsd/sys/hakios.net.h,
+ * which the station side calls itself.
+ *
+ * Between the two stands drivers/wifi/hakios.sta.c: one thread, on which every call into the station
+ * side is made, one at a time, and what the last scan heard, kept for whoever asks.
+ *
+ * Nothing but C's own types here: the station side is not compiled as XNU's code.
+ */
+#ifndef _SYS_HAKIOS_STA_H_
+#define _SYS_HAKIOS_STA_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define HAKIOS_STA_ELEMENTS_MOST       1024
+
+/* One access point, as a scan heard it. */
+struct hakios_sta_bss {
+	uint8_t bssid[6];
+	uint8_t ssid[32], ssid_length;
+	uint16_t frequency;                     /* MHz */
+	int16_t rssi;                           /* dBm */
+	uint16_t beacon_interval;               /* in units of 1024 microseconds */
+	uint16_t capability;                    /* the beacon's capability field */
+	uint32_t age_ms;                        /* how long ago it was last heard */
+	uint16_t elements_length;               /* the beacon's information elements as received: who asks */
+	uint8_t elements[HAKIOS_STA_ELEMENTS_MOST];    /* reads the network's protection out of them itself */
+};
+
+/* What to scan for. All zero: every channel, the radio's own way. */
+struct hakios_sta_scan {
+	uint8_t ssid[32], ssid_length;          /* ask for this network by name (a hidden one answers only then) */
+	uint16_t frequencies[64], frequency_count;      /* only these channels */
+	bool passive;                           /* only listen */
+	uint16_t dwell_ms;                      /* on each channel; 0: the radio's own */
+};
+
+enum { HAKIOS_STA_OPEN, HAKIOS_STA_WPA2_PSK };
+
+struct hakios_sta_join {
+	uint8_t ssid[32], ssid_length;
+	uint8_t bssid[6];                       /* all zero: the access point of that name heard best */
+	int security;
+	uint8_t pmk[32];                        /* WPA2 with a passphrase: the key made of the passphrase and the name ... */
+	uint8_t passphrase[64], passphrase_length;      /* ... or, if this is not empty, the passphrase itself */
+};
+
+enum hakios_sta_phase { HAKIOS_STA_OFF, HAKIOS_STA_IDLE, HAKIOS_STA_SCANNING, HAKIOS_STA_JOINING, HAKIOS_STA_JOINED };
+
+struct hakios_sta_state {
+	enum hakios_sta_phase phase;
+	struct hakios_sta_bss bss;             /* the network joined or being joined */
+	int last_error;                         /* why the last join failed or the network was lost (an errno); 0: it was not */
+};
+
+#define HAKIOS_STA_CHANNEL_PASSIVE     1u      /* the radio may only listen there */
+#define HAKIOS_STA_CHANNEL_RADAR       2u      /* ... and has to look out for radar */
+
+struct hakios_sta_channel {
+	uint16_t frequency;                     /* MHz */
+	uint16_t flags;
+};
+
+/*
+ * What the station side supplies. All but state() are called on one thread, one at a time, and
+ * may take as long as the thing takes: scan() returns when the scan is over, join() when frames
+ * can pass or it is known why not. Each gives 0 or an errno.
+ */
+struct hakios_sta_ops {
+	int (*power)(bool on);                  /* off: leave the network, stop the radio; on: start it */
+	int (*scan)(const struct hakios_sta_scan *what);
+	void (*heard)(void (*each)(const struct hakios_sta_bss *bss, void *context), void *context);   /* by the last scan */
+	int (*join)(const struct hakios_sta_join *what);
+	int (*leave)(void);
+	void (*state)(struct hakios_sta_state *state);         /* on any thread; does not sleep */
+	unsigned (*channels)(struct hakios_sta_channel *channels, unsigned most);      /* what the radio may tune to */
+	uint8_t address[6];
+};
+
+/* What happens, said to whoever listens (the Apple80211 side). */
+enum hakios_sta_event {
+	HAKIOS_STA_POWER,                      /* status: 1 on, 0 off */
+	HAKIOS_STA_SCAN_DONE,                  /* status: 0, or the scan's errno */
+	HAKIOS_STA_JOIN_DONE,                  /* status: 0, or the join's errno */
+	HAKIOS_STA_LINK,                       /* status: 1 a network is joined, 0 it has been left when asked,
+	                                         * an errno: it was lost (the access point showed us the door) */
+};
+
+#ifdef KERNEL
+/* ---- the station side ---- */
+void     hakios_sta_attach(const struct hakios_sta_ops *ops);         /* NULL: it is going away (waits for a call under way) */
+void     hakios_sta_lost(int error);                                   /* the network joined is gone by itself */
+void     hakios_sta_radio_ready(void);     /* XCover5: the radio takes calls now (and is not joined): the standing network */
+
+/* ---- who wants a network: each asks and returns; the outcome is an event. 0, or an errno ---- */
+bool     hakios_sta_present(void);
+int      hakios_sta_ask_power(bool on);
+int      hakios_sta_ask_scan(const struct hakios_sta_scan *what);
+int      hakios_sta_ask_join(const struct hakios_sta_join *what);
+/* ... and joined again whenever the radio is turned on, until some other network is asked for */
+int      hakios_sta_ask_join_standing(const struct hakios_sta_join *what);
+int      hakios_sta_ask_leave(void);
+bool     hakios_sta_busy(void);                                        /* something asked for is not over yet */
+bool     hakios_sta_powered(void);
+/* the `index`th access point the last scan heard: true, or false when there are not that many */
+bool     hakios_sta_heard(unsigned index, struct hakios_sta_bss *bss);
+void     hakios_sta_state(struct hakios_sta_state *state);
+unsigned hakios_sta_channels(struct hakios_sta_channel *channels, unsigned most);
+bool     hakios_sta_address(uint8_t *address);
+/* the USB console's "wifi scan": the radio on if it is off, a scan of every channel, what it heard said (on a thread) */
+void     hakios_sta_console_scan(void);
+
+/* ---- the listener: drivers/wifi/hakios.apple80211.c ---- */
+void     hakios_apple80211_event(enum hakios_sta_event event, int status);
+void     hakios_apple80211_summary(void);                              /* what was asked in this run, to the log */
+#endif
+
+#endif
diff --git a/iokit/Kernel/arm/MiniIONetworkStack.cpp b/iokit/Kernel/arm/MiniIONetworkStack.cpp
new file mode 100644
index 0000000..f74bb58
--- /dev/null
+++ b/iokit/Kernel/arm/MiniIONetworkStack.cpp
@@ -0,0 +1,129 @@
+/*
+ * From y2sios (https://github.com/stormtroopxyz/y2sios, kernel/xnu/files/), MIT License,
+ * Copyright (c) 2026 the y2sios contributors; itself after HackiOS by OOSEX GANG (MIT). Taken for the XCover5 port's
+ * Wi-Fi (bsd/dev/xc5_wlbt.c supplies the station side); changes marked XCover5.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated
+ * documentation files (the "Software"), to deal in the Software without restriction, including without limitation the
+ * rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit
+ * persons to whom the Software is furnished to do so, subject to the following conditions: The above copyright notice and
+ * this permission notice shall be included in all copies or substantial portions of the Software. THE SOFTWARE IS
+ * PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
+ * MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT
+ * HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE,
+ * ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+ */
+/*
+ * MiniIONetworkStack: a stand-in for IONetworkStack of Apple's IONetworkingFamily, as seen by
+ * configd's interface namer.
+ *
+ * The real one gives the BSD names (en0, en1, ...) to the IONetworkInterface objects of the
+ * drivers, when the interface namer asks. Here interfaces are made with the BSD interface KPI
+ * (XCover5: bsd/dev/xc5_wlbt.c) and are born with their names, so there is never anything to name.
+ * But the namer wants this object all the same: until it has opened it, it does not say in
+ * configd's store that the registry has gone quiet (the key Plugin:InterfaceNamer, "*QUIET*"),
+ * and gives up only after five minutes ("*TIMEOUT*"). SystemConfiguration's
+ * SCNetworkInterfaceCopyAll() waits for one of the two, and with it whoever asks for the list of
+ * interfaces: wifid as soon as it has a device, and behind wifid SpringBoard.
+ *
+ * So: the service, a user client that can be opened, and a refusal of the naming request.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+extern "C" void MiniIONetworkStackStart(void);       /* XCover5: from MiniDrivers.h */
+
+class IONetworkStack : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkStack);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+bool
+IONetworkStack::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IONetworkStackUserClient");
+	setName("IONetworkStack");
+	registerService();
+	return true;
+}
+
+class IONetworkStackUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject * properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+bool
+IONetworkStackUserClient::start(IOService * provider)
+{
+	char who[32] = "?";
+
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	/* whether the registry is quiet at this moment is what the namer goes on to ask */
+	proc_selfname(who, sizeof(who));
+	IOLog("MiniIONetworkStack: opened by %s; the registry's busy state is %u\n", who,
+	    (unsigned) IOService::getServiceRoot()->getBusyState());
+	return true;
+}
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+/* "Name this interface" (a dictionary: IONetworkStackUserCommand, IOPathMatch, IOInterfaceUnit). */
+IOReturn
+IONetworkStackUserClient::setProperties(OSObject * properties)
+{
+	static unsigned said;
+
+	if (said++ < 4) {
+		IOLog("MiniIONetworkStack: asked to name an interface: there are none of that kind\n");
+	}
+	return kIOReturnUnsupported;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+void
+MiniIONetworkStackStart(void)
+{
+	/* where the real one is: IOService:/IOResources/IONetworkStack */
+	IOService * resources = IOService::getResourceService();
+	IONetworkStack * stack = OSTypeAlloc(IONetworkStack);
+
+	if (resources == NULL || stack == NULL || !stack->init() || !stack->attach(resources)) {
+		OSSafeReleaseNULL(stack);
+		IOLog("MiniIONetworkStack: cannot create the service\n");
+		return;
+	}
+	if (!stack->start(resources)) {
+		stack->detach(resources);
+	}
+	stack->release();
+}
