+/* Draw layer (dx,dy,w,h) of the logical (iPhone X) display, source (sx,sy),
+ * onto the panel scaled to fit its height; nearest neighbour. */
+static void
+xcover5_scaled_blit(uintptr_t pixels, uint32_t rowBytes, uint32_t pw, uint32_t ph,
+    uint32_t lw, uint32_t lh, SweetSurface *s, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
