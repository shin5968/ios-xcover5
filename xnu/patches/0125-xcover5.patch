+#if defined(XCOVER5)
+/*
+ * Galaxy XCover5 touch: Novatek NT36525 (TDDI) on SPI1 = USI_CMGP0 at
+ * 0x11d00000. The loader (shim/xcover5) sets up clocks, USI mode and pins,
+ * downloads the firmware Samsung ships in vendor/firmware (appended to the
+ * BOOT payload) and adds xc5touch=1 when the firmware reports ready. Here
+ * the event buffer (NT36672A map, 0x21c00) is polled every 10 ms: one byte
+ * status then 6 bytes per finger (id << 3 | state, x/y in 12 bits). The
+ * panel is 720x1480; the HID digitizer takes 1080x1920 for the whole
+ * presented display (iPhone X size scaled to 683x1480 at x 18, or the
+ * panel itself with sweetfb_native=1).
+ */
+#define XC5_SPI         0x11d00000u
+#define XC5_CMGP_PIN    0x11c30000u     /* gpm3 DAT at 0x64: CS */
+#define XC5_EVENT_BUF   0x21c00u
+#define XC5_FINGERS     10
+static vm_offset_t xc5ts_spi, xc5ts_pin;
+static int xc5ts_sleep, xc5ts_native;
+static bool xc5ts_down[XC5_FINGERS];
+static uint16_t xc5ts_x[XC5_FINGERS], xc5ts_y[XC5_FINGERS];
+/* Polls a finger has been missing; boot 15: releasing on the first miss
+ * turned every swipe into a tap (down, then up 10 ms later). */
+static uint8_t xc5ts_miss[XC5_FINGERS];
+static unsigned xc5ts_seen[XC5_FINGERS];
+#define XC5_RELEASE_MISSES 5
+
+static inline uint32_t
+xc5ts_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+xc5ts_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static void
+xc5ts_cs(int level)
+{
+	uint32_t d = xc5ts_rd(xc5ts_pin, 0x64);
+	xc5ts_wr(xc5ts_pin, 0x64, level ? (d | 1u) : (d & ~1u));
+	delay(2);
+}
+
+/* One byte full duplex, polled (FIFO levels: TX [14:6], RX [23:15]). */
+static int
+xc5ts_xfer(uint8_t tx)
+{
+	for (int i = 0; i < 100000; i++) {
+		if (((xc5ts_rd(xc5ts_spi, 0x14) >> 6) & 0x1ffu) < 64) {
+			xc5ts_wr(xc5ts_spi, 0x18, tx);
+			for (int j = 0; j < 100000; j++) {
+				if ((xc5ts_rd(xc5ts_spi, 0x14) >> 15) & 0x1ffu) {
+					return (int)(xc5ts_rd(xc5ts_spi, 0x1c) & 0xffu);
+				}
+			}
+			return -1;
+		}
+	}
+	return -1;
+}
+
+/* Page select FF a[23:15] a[14:7], then a[6:0], one dummy byte, data. */
+static bool
+xc5ts_read(uint32_t addr, uint8_t *buf, int n)
+{
+	bool ok = true;
+	xc5ts_cs(0);
+	ok &= xc5ts_xfer(0xff) >= 0;
+	ok &= xc5ts_xfer((uint8_t)(addr >> 15)) >= 0;
+	ok &= xc5ts_xfer((uint8_t)(addr >> 7)) >= 0;
+	xc5ts_cs(1);
+	xc5ts_cs(0);
+	ok &= xc5ts_xfer((uint8_t)(addr & 0x7fu)) >= 0;
+	ok &= xc5ts_xfer(0) >= 0;
+	for (int i = 0; i < n; i++) {
+		int v = xc5ts_xfer(0);
+		ok &= v >= 0;
+		buf[i] = (uint8_t)v;
+	}
+	xc5ts_cs(1);
+	return ok;
+}
+
+/* Panel pixel -> HID digitizer 1080x1920 of the presented display. */
+static void
+xc5ts_map(unsigned px, unsigned py, int *x, int *y)
+{
+	if (xc5ts_native) {
+		*x = (int)(px * 1080u / 720u);
+	} else {
+		int lx = (int)px - 18;               /* 683 px wide, centered */
+		lx = lx < 0 ? 0 : (lx > 682 ? 682 : lx);
+		*x = lx * 1080 / 683;
+	}
+	*y = (int)(py * 1920u / 1480u);
+}
