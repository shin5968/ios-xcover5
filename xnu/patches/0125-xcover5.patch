+bool
+IOAcceleratorES::serializeProperties(OSSerialize *s) const
+{
+	if (xc5_metal_caller_allowed()) {
+		return IOService::serializeProperties(s);
+	}
+	OSDictionary *dict = dictionaryWithProperties();
+	if (dict == NULL) {
+		return false;
+	}
+	dict->removeObject(kXC5MetalNameKey);
+	dict->removeObject(kXC5MetalClassKey);
+	bool ok = dict->serialize(s);
+	dict->release();
+	return ok;
+}
+
+IOReturn
+IOAcceleratorES::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	char who[MAXCOMLEN + 1];
+
+	proc_selfname(who, sizeof(who));
+	if (dict == NULL || dict->getCount() == 0) {
+		return kIOReturnBadArgument;
+	}
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return kIOReturnNoMemory;
+	}
+	OSSymbol *key;
+	IOReturn ret = kIOReturnSuccess;
+	while ((key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+		if (!key->isEqualTo(kXC5MetalNameKey) && !key->isEqualTo(kXC5MetalClassKey)) {
+			printf("XC5 metal: %s: refused key %s\n", who, key->getCStringNoCopy());
+			ret = kIOReturnUnsupported;
+		} else if (OSDynamicCast(OSString, dict->getObject(key)) == NULL) {
+			printf("XC5 metal: %s: %s is not a string\n", who, key->getCStringNoCopy());
+			ret = kIOReturnBadArgument;
+		}
+	}
+	it->release();
+	if (ret != kIOReturnSuccess) {
+		return ret;
+	}
+	it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return kIOReturnNoMemory;
+	}
+	while ((key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+		OSString *value = OSDynamicCast(OSString, dict->getObject(key));
+		if (value->getLength() == 0) {
+			removeProperty(key);
+			printf("XC5 metal: %s removed by %s\n", key->getCStringNoCopy(), who);
+		} else {
+			setProperty(key, value);
+			printf("XC5 metal: %s = %s, set by %s\n", key->getCStringNoCopy(),
+			    value->getCStringNoCopy(), who);
+		}
+	}
+	it->release();
+	return kIOReturnSuccess;
+}
+
+static void
+publish_accelerator(IOService *provider)
+{
+	int metal = 0;
+	if (!PE_parse_boot_argn("xc5metal", &metal, sizeof(metal)) || metal == 0) {
+		return;
+	}
+	IOAcceleratorES *acc = OSTypeAlloc(IOAcceleratorES);
+	if (acc != NULL && acc->init() && acc->attach(provider)) {
+		acc->setName("sgx");
+		/* the drop zone's bundle (gpu/metal/build-metal.sh), seen only by xc5metalfor's processes */
+		/* xc5mtldrv=viva: viva-gpu's VivaMTLDriver (gpu/viva, drop zone /private/var/xc5/viva) instead of RedwoodMetal */
+		char drv[16] = "";
+		(void)PE_parse_boot_arg_str("xc5mtldrv", drv, sizeof(drv));
+		if (strcmp(drv, "viva") == 0) {
+			acc->setProperty(kXC5MetalNameKey, "../../../private/var/xc5/viva/VivaMTLDriver");
+			acc->setProperty(kXC5MetalClassKey, "VMDevice");
+		} else {
+			acc->setProperty(kXC5MetalNameKey, "../../../private/var/xc5/metal/RedwoodMetal");
+			acc->setProperty(kXC5MetalClassKey, "RedwoodMetalDevice");
+		}
+		acc->registerService();
+		char list[128] = "chronod";
+		(void)PE_parse_boot_argn("xc5metalfor", list, sizeof(list));
+		printf("XC5 metal: IOAcceleratorES published (xc5metal=%d) for %s\n", metal, list);
+	}
+	OSSafeReleaseNULL(acc);
+}
+
+bool
+XC5GPU::start(IOService *provider)
+{
+	int mode = 0;
+	(void)PE_parse_boot_argn("xc5gpu", &mode, sizeof(mode));
+	if (mode < 4 || !IOService::start(provider)) {
+		return false;
+	}
+	map_lock = IOLockAlloc();
+	job_lock = IOLockAlloc();
+	if (map_lock == NULL || job_lock == NULL || !gpu_up()) {
+		xcover5_gpusvc[0] = 2;
+		return false;
+	}
+	xcover5_gpusvc[0] = 1;
+	setProperty(kIOUserClientClassKey, "XC5GPUUserClient");
+	setProperty("GPU", "Mali-G52 MP1");
+	registerService();
+	IOLog("XC5GPU: registered\n");
+	publish_accelerator(this);
+	thread_t thread;
+	if (kernel_thread_start(selftest, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	return true;
+}
+
+bool
+XC5GPUUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fLock = IOLockAlloc();
+	fBOs = (struct gpu_bo *)IOMallocZeroData(MAX_BOS * sizeof(*fBOs));
+	xcover5_gpusvc[1]++;
+	return fLock != NULL && fBOs != NULL && up_state == 1;
+}
+
+IOReturn
+XC5GPUUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+XC5GPUUserClient::free(void)
+{
+	if (fBOs != NULL) {
+		for (unsigned i = 0; i < MAX_BOS; i++) {
+			bo_free(&fBOs[i]);
+		}
+		IOFreeData(fBOs, MAX_BOS * sizeof(*fBOs));
+		fBOs = NULL;
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+XC5GPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	uint64_t out[9] = { 0 };
+	uint32_t outCount = 0;
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t in0 = args->scalarInputCount > 0 ? args->scalarInput[0] : 0;
+	uint64_t in1 = args->scalarInputCount > 1 ? args->scalarInput[1] : 0;
+	struct gpu_bo *bo = in0 && in0 <= MAX_BOS ? &fBOs[in0 - 1] : NULL;
+
+	IOLockLock(fLock);
+	switch (selector) {
+	case kSelGetParam:
+		out[0] = gpu_param(in0);
+		outCount = 1;
+		break;
+	case kSelCreateBO:
+	case kSelSurfaceBO: {
+		unsigned i = 0;
+		while (i < MAX_BOS && bo_used(&fBOs[i])) {
+			i++;
+		}
+		if (i == MAX_BOS) {
+			ret = kIOReturnNoResources;
+			break;
+		}
+		struct gpu_bo *n = &fBOs[i];
+		if (selector == kSelCreateBO ? !bo_create(n, in0) : !bo_import_surface(n, (uint32_t)in0)) {
+			ret = selector == kSelCreateBO ? kIOReturnNoMemory : kIOReturnNotFound;
+			break;
+		}
+		out[0] = i + 1;
+		out[1] = n->va;
+		out[2] = (uint64_t)n->pages * 0x1000;
+		outCount = 3;
+		if (n->surface != NULL) {
+			SweetSurface *s = n->surface;
+			out[3] = s->bytesPerRow;
+			out[4] = s->width;
+			out[5] = s->height;
+			out[6] = s->pixelFormat;
+			out[7] = s->offset;
+			out[8] = s->planeCount;
+			outCount = 9;
+		}
+		break;
+	}
+	case kSelFreeBO:
+		if (bo == NULL || !bo_used(bo)) {
+			ret = kIOReturnBadArgument;
+		} else {
+			bo_free(bo);
+		}
+		break;
+	case kSelMapBO:
+		if (bo == NULL || !bo_used(bo)) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		if (bo->umap == NULL) {
+			/* A surface keeps the cache mode its other mappings use. */
+			bo->umap = bo_memory(bo)->createMappingInTask(fTask, 0,
+			    kIOMapAnywhere | (bo->surface ? bo->surface->mapCache : kIOMapWriteCombineCache));
+		}
+		if (bo->umap == NULL) {
+			ret = kIOReturnNoMemory;
+		} else {
+			out[0] = bo->umap->getAddress();
+			outCount = 1;
+		}
+		break;
+	case kSelSubmit:
+		out[0] = gpu_submit(in1 ? 1 : 0, in0, &out[1]);
+		outCount = 2;
+		break;
+	case kSelLog:
+		if (args->structureInput != NULL && args->structureInputSize > 0) {
+			char line[256];
+			size_t n = args->structureInputSize < sizeof(line) - 1 ?
+			    (size_t)args->structureInputSize : sizeof(line) - 1;
+			memcpy(line, args->structureInput, n);
+			line[n] = 0;
+			IOLog("XC5GPU client: %s\n", line);
+			/* The last few, for the heartbeat (the console scrolls them away). */
+			strlcpy(xcover5_gpusvc_lines[xcover5_gpusvc_line++ % 4], line,
+			    sizeof(xcover5_gpusvc_lines[0]));
+			{
+				uint32_t k = xcover5_gllog_n++;
+				char *slot = k < XC5_GLLOG_FIRST ? xcover5_gllog_first[k] :
+				    xcover5_gllog_ring[(k - XC5_GLLOG_FIRST) % XC5_GLLOG_RING];
+				strlcpy(slot, line, sizeof(xcover5_gllog_ring[0]));
+			}
+		}
+		break;
+	case kSelSyncBO:
+		if (bo == NULL || !bo_used(bo)) {
+			ret = kIOReturnBadArgument;
+		} else if (bo->surface != NULL && bo->surface->kernelAddress() != 0) {
+			cache_clean(bo->surface->kernelAddress(), bo->surface->allocSize);
+		}
+		break;
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	IOLockUnlock(fLock);
+
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = i < outCount ? out[i] : 0;
+	}
+	static uint32_t logged;
+	if (selector < 32 && !(logged & (1u << selector))) {
+		logged |= 1u << selector;
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("XC5GPU: %s sel %u in %u -> 0x%x\n", name, selector, args->scalarInputCount, ret);
+	}
+	return ret;
+}
+
+/*
+ * A WRITE_VALUE job (32-bit 0xc0ffee01) through the same buffer and submit
+ * paths a client uses: xcover5_gpusvc[5] = 1 passed, 2 failed.
+ */
+static void
+selftest(__unused void *arg, __unused wait_result_t wr)
+{
+	struct gpu_bo bo;
+	bzero(&bo, sizeof(bo));
+	if (!bo_create(&bo, 0x10000)) {
+		IOLog("XC5GPU SELFTEST: buffer failed\n");
+		xcover5_gpusvc[5] = 2;
+		return;
+	}
+	IOMemoryMap *map = bo.mem->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache);
+	volatile uint32_t *job = map ? (volatile uint32_t *)map->getVirtualAddress() : NULL;
+	if (job == NULL) {
+		IOLog("XC5GPU SELFTEST: mapping failed\n");
+		bo_free(&bo);
+		xcover5_gpusvc[5] = 2;
+		return;
+	}
+	job[4] = (2u << 1) | 1u | (1u << 16);   /* WRITE_VALUE, 64-bit pointers, index 1 */
+	job[8] = (uint32_t)(bo.va + 0x800);
+	job[9] = (uint32_t)((bo.va + 0x800) >> 32);
+	job[10] = 6;                            /* 32-bit immediate */
+	job[12] = 0xc0ffee01u;
+	volatile uint32_t *output = job + 0x800 / 4;
+	*output = 0;
+	/*
+	 * Boot 47: DATA_INVALID_FAULT (js_status 0x58, no MMU fault): the GPU read
+	 * a zero header, so these writes had not reached memory. A kernel_task
+	 * mapping of this buffer can come back cacheable whatever was asked for;
+	 * clean it to the point of coherency like hakios-a32 does.
+	 */
+	cache_clean((uintptr_t)job, 0x1000);
+	uint64_t us = 0;
+	uint32_t status = gpu_submit(1, bo.va, &us);
+	cache_clean((uintptr_t)job, 0x1000);
+	bool ok = status == 0 && *output == 0xc0ffee01u;
+	xcover5_gpusvc[5] = ok ? 1 : 2;
+	xcover5_gpusvc[6] = (uint32_t)us;
+	IOLog("XC5GPU SELFTEST: buffer at GPU VA %#llx, status %#x in %llu us, word %#x -> %s\n",
+	    bo.va, status, us, *output, ok ? "OK" : "FAILED");
+	map->release();
+	bo_free(&bo);
+}
+#endif /* XCOVER5 */
diff --git a/iokit/Kernel/arm/hakios.wlan.cpp b/iokit/Kernel/arm/hakios.wlan.cpp
new file mode 100644
index 0000000..62a0c4f
--- /dev/null
+++ b/iokit/Kernel/arm/hakios.wlan.cpp
@@ -0,0 +1,254 @@
+/*
+ * HakiosWLAN: the registry entries by which Darwin finds the Wi-Fi interface.
+ *
+ * en0 is made with the BSD interface KPI (drivers/net/hakios.net.c) and has no IOKit object behind
+ * it of its own; Darwin looks for two, as IO80211Family would have made them:
+ *
+ *   - wifid's device is whatever service has the property IO80211InterfaceRole =
+ *     "Infrastructure", and IO80211.framework binds to an interface through a service whose
+ *     IOInterfaceName is the interface's name. The service has no user client, on purpose:
+ *     the framework's attempt to open one fails, it says "Falling back to IOCTL path", and
+ *     from then on every request is an ioctl on a socket, which drivers/wifi/hakios.apple80211.c
+ *     answers.
+ *   - SystemConfiguration (SCNetworkInterfaceCopyAll) lists the network interfaces it finds as
+ *     objects of the class IONetworkInterface, and calls one a Wi-Fi interface when its parent
+ *     is of the class IO80211Controller; type, unit, name and built-in-ness are properties of
+ *     the interface, the hardware address one of the controller. configd makes a network
+ *     service (DHCP and the rest) for an interface it has listed, and only an interface with a
+ *     service can be the one the system routes through -- which wifid waits for after a join
+ *     ("failed to become routable interface") before Settings ticks the network.
+ *
+ *   - MobileGestalt, which lsd asks for the Wi-Fi address of every bundle it registers, looks the
+ *     address up as the property local-mac-address of the device tree's "wlan" node, as a phone
+ *     has it; without that it waits, up to 5 s every time, for a service of the class
+ *     IONetworkController under that node. With neither, each such question cost 5 s, and a
+ *     LaunchServices database rebuilt in full (a first boot on an empty data volume) takes hours,
+ *     SpringBoard waiting. (Found by the ios-sapphire port, patches 0157 and 0158, which carries
+ *     this file on: github.com/Angelpro09xd/ios-sapphire, APSL 2.0.)
+ *
+ * So: a controller of the class IO80211Controller -- an IOEthernetController and so an
+ * IONetworkController, as in IO80211Family -- under the "wlan" node (the platform when there is
+ * none), the radio's address on that node as local-mac-address, and below the controller one
+ * object that is both, an IONetworkInterface with wifid's properties. The classes are ours, named
+ * as IO80211Family and IONetworkingFamily name theirs; none has anything but properties.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+
+#ifndef kIOMessageServicePropertyChange
+#define kIOMessageServicePropertyChange  ((unsigned)0xe00001d0) /* iokit_common_msg(0x1d0) */
+#endif
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+
+extern "C" void HakiosWLANStart(const char * interface, const uint8_t * address);
+extern "C" void HakiosWLANSetLink(bool up);
+
+class IONetworkController : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkController);
+};
+
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+
+class IOEthernetController : public IONetworkController
+{
+	OSDeclareDefaultStructors(IOEthernetController);
+};
+
+OSDefineMetaClassAndStructors(IOEthernetController, IONetworkController);
+
+class IO80211Controller : public IOEthernetController
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+
+OSDefineMetaClassAndStructors(IO80211Controller, IOEthernetController);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class IOEthernetInterface : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(IOEthernetInterface);
+};
+
+OSDefineMetaClassAndStructors(IOEthernetInterface, IONetworkInterface);
+
+class IO80211Interface : public IOEthernetInterface
+{
+	OSDeclareDefaultStructors(IO80211Interface);
+};
+
+OSDefineMetaClassAndStructors(IO80211Interface, IOEthernetInterface);
+
+class HakiosWLAN : public IO80211Interface
+{
+	OSDeclareDefaultStructors(HakiosWLAN);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(HakiosWLAN, IO80211Interface);
+
+/* There is none (see the top); that somebody asked shows that the service was found. */
+IOReturn
+HakiosWLAN::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties, IOUserClient ** handler)
+{
+	static unsigned said;
+
+	if (said++ < 8) {
+		IOLog("HakiosWLAN: a user client of type %u is asked for: there is none\n", (unsigned) type);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* attach, start, register: the service, or NULL */
+static IOService *
+publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+static IO80211Controller * g_controller;
+static HakiosWLAN * g_wlan;
+
+/*
+ * configd only starts DHCP for an IONetworkInterface whose controller reports an active link
+ * (hakios.wlan.cpp header: "failed to become routable interface"). BSD IFF_UP alone is not enough:
+ * scsc20 had link up, RX, and no TX at all.
+ */
+extern "C" boolean_t ml_get_interrupts_enabled(void);
+
+void
+HakiosWLANSetLink(bool up)
+{
+	UInt32 status = up ? 0x1u | 0x2u : 0x1u;        /* kIONetworkLinkValid | Active */
+	OSNumber * number;
+	bool notify;
+
+	/*
+	 * scsc21 panicked on the way back to the loader: "Console I/O from interrupt-disabled context"
+	 * (serial_console.c:168) from IOLog/messageClients here. setProperty only; notify when IRQs are on.
+	 */
+	/* setProperty/messageClients also print; skip the whole update if IRQs are off (loader return). */
+	if (ml_get_interrupts_enabled() == 0) {
+		return;
+	}
+	notify = true;
+	if (g_controller != NULL && (number = OSNumber::withNumber((unsigned long long) status, 32)) != NULL) {
+		g_controller->setProperty("IOLinkStatus", number);
+		number->release();
+		if (notify) {
+			g_controller->messageClients(kIOMessageServicePropertyChange);
+		}
+	}
+	if (g_wlan != NULL && (number = OSNumber::withNumber(up ? 1ull : 0ull, 32)) != NULL) {
+		g_wlan->setProperty("IOInterfaceState", number);
+		number->release();
+		if (notify) {
+			g_wlan->messageClients(kIOMessageServicePropertyChange);
+		}
+	}
+}
+
+/* Once, when the interface of a radio exists. */
+void
+HakiosWLANStart(const char * interface, const uint8_t * address)
+{
+	IOService * platform = IOService::getPlatform();
+	OSDictionary * match = IOService::nameMatching("wlan");
+	IOService * node = match != NULL ? IOService::copyMatchingService(match) : NULL;   /* the device tree's */
+	IO80211Controller * controller = OSTypeAlloc(IO80211Controller);
+	HakiosWLAN * wlan = OSTypeAlloc(HakiosWLAN);
+	OSData * mac;
+	OSNumber * number;
+
+	if (platform == NULL || controller == NULL || wlan == NULL || !controller->init() || !wlan->init()) {
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		OSSafeReleaseNULL(node);
+		OSSafeReleaseNULL(match);
+		IOLog("HakiosWLAN: cannot create the services\n");
+		return;
+	}
+	if ((mac = OSData::withBytes(address, 6)) != NULL) {
+		controller->setProperty("IOMACAddress", mac);
+		if (node != NULL) {
+			node->setProperty("local-mac-address", mac);     /* where MobileGestalt reads it first */
+		}
+		mac->release();
+	}
+	controller->setProperty("IOBuiltin", true);
+	OSSafeReleaseNULL(match);
+	controller = (IO80211Controller *) publish(controller, node != NULL ? node : platform, "HakiosWLANController");
+	OSSafeReleaseNULL(node);
+	if (controller == NULL) {
+		wlan->release();
+		IOLog("HakiosWLAN: the controller did not start\n");
+		return;
+	}
+	g_controller = controller;
+
+	wlan->setProperty("IOInterfaceName", interface);
+	wlan->setProperty("BSD Name", interface);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	if ((number = OSNumber::withNumber(0x47ULL, 32)) != NULL) {     /* IFT_IEEE80211: configd's Wi-Fi, not Ethernet */
+		wlan->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber((unsigned long long) (interface[2] - '0'), 32)) != NULL) {
+		wlan->setProperty("IOInterfaceUnit", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber(1500ULL, 32)) != NULL) {
+		wlan->setProperty("IOMaxTransferUnit", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {
+		wlan->setProperty("IOMediaAddressLength", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber(14ULL, 32)) != NULL) {
+		wlan->setProperty("IOMediaHeaderLength", number);
+		number->release();
+	}
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	{
+		OSDictionary * data = OSDictionary::withCapacity(1);
+
+		if (data != NULL) {
+			wlan->setProperty("IONetworkData", data);
+			data->release();
+		}
+	}
+	if (publish(wlan, controller, interface) == NULL) {             /* registry name en0, as IONetworkingFamily */
+		IOLog("HakiosWLAN: the service did not start\n");
+	} else {
+		g_wlan = wlan;
+		wlan->release();
+	}
+	controller->release();
+}
