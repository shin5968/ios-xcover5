+
+void
+loader_log_line(const char *line)
+{
+	(void)line;
+}
+
+int
+hakios_wifi_tell(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	return printf("%s", line);
+}
+
+void
+hakios_virtio_net_init(void)
+{
+}
+
+int
+hakios_partition_file(const char *partition, const char *mount, const char *path, uint64_t max, const uint8_t **data,
+    uint64_t *size)
+{
+	(void)partition;
+	(void)mount;
+	(void)path;
+	(void)max;
+	if (data != NULL) {
+		*data = NULL;
+	}
+	if (size != NULL) {
+		*size = 0;
+	}
+	return ENOENT;
+}
+
+/* the A50's fw/ names, and the drop zone's (tools/xcover5/dev/wlbtfw.sh makes them, mkdrop.py puts them in wifi/) */
+static const struct {
+	const char *a50, *drop;
+} names[] = {
+	{ "mx140.bin", "mx140.bin" },
+	{ "scsc_ka.bin", "ka.bin" },
+	{ "mx140_wlan.hcf", "wlan.hcf" },
+	{ "mx140_wlan_sw.hcf", "wlan_sw.hcf" },
+	{ "scsc_country.bin", "country.bin" },
+	{ "mac.info", "mac.info" },
+	{ "mx140_bt.hcf", "bt.hcf" },
+};
+
+#define KEPT_MOST 8
+static struct {
+	char name[24];
+	uint8_t *data;
+	uint64_t size;
+} kept[KEPT_MOST];
+static unsigned kept_n;
+static LCK_GRP_DECLARE(glue_grp, "xc5-hakios-glue");
+static LCK_MTX_DECLARE(glue_mtx, &glue_grp);
+
+/* A file of the drop zone, whole, into a new buffer: its length, or -1 (no such file, or larger than max). */
+static int64_t
+read_whole(const char *path, uint8_t **out, uint64_t max)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int64_t done = 0;
+	uint8_t *buf;
+
+	*out = NULL;
+	if (vnode_open(path, FREAD, 0, 0, &vp, ctx) != 0) {
+		return -1;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	if (vnode_getattr(vp, &va, ctx) != 0 || va.va_data_size == 0 || va.va_data_size > max) {
+		vnode_close(vp, FREAD, ctx);
+		return -1;
+	}
+	buf = kalloc_data((vm_size_t)va.va_data_size, Z_WAITOK);
+	if (buf == NULL) {
+		vnode_close(vp, FREAD, ctx);
+		return -1;
+	}
+	while ((uint64_t)done < va.va_data_size) {
+		int resid = 0, n = (int)MIN((uint64_t)(1u << 20), va.va_data_size - (uint64_t)done);
+		if (vn_rdwr(UIO_READ, vp, (caddr_t)(buf + done), n, (off_t)done, UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid,
+		    vfs_context_proc(ctx)) != 0 || resid == n) {
+			break;
+		}
+		done += n - resid;
+	}
+	vnode_close(vp, FREAD, ctx);
+	if ((uint64_t)done != va.va_data_size) {
+		kfree_data(buf, (vm_size_t)va.va_data_size);
+		return -1;
+	}
+	*out = buf;
+	return done;
+}
+
+const uint8_t *
+hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out)
+{
+	const char *drop = NULL;
+	char path[96];
+	uint8_t *data = NULL;
+	int64_t n = -1;
+
+	(void)dir;
+	if (disk_out != NULL) {
+		*disk_out = 0;
+	}
+	if (size != NULL) {
+		*size = 0;
+	}
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (strcmp(names[i].a50, name) == 0) {
+			drop = names[i].drop;
+		}
+	}
+	if (drop == NULL) {
+		printf("XC5 SCSC: firmware file %s has no place in the drop\n", name);
+		return NULL;
+	}
+	lck_mtx_lock(&glue_mtx);
+	for (unsigned i = 0; i < kept_n; i++) {
+		if (strcmp(kept[i].name, drop) == 0) {
+			if (size != NULL) {
+				*size = kept[i].size;
+			}
+			lck_mtx_unlock(&glue_mtx);
+			return kept[i].data;
+		}
+	}
+	lck_mtx_unlock(&glue_mtx);
+	snprintf(path, sizeof(path), "/private/var/xc5/wifi/%s", drop);
+	/* the firmware itself may come with a drop that is being written now (first boot after a flash): waited for */
+	for (int s = 0; s < (strcmp(drop, "mx140.bin") == 0 ? 120 : 1) && n < 0; s++) {
+		n = read_whole(path, &data, 8u << 20);
+		if (n < 0 && strcmp(drop, "mx140.bin") == 0) {
+			delay(1000000);
+		}
+	}
+	if (n < 0) {
+		printf("XC5 SCSC: no %s\n", path);
+		return NULL;
+	}
+	printf("XC5 SCSC: %s: %lld bytes (the A50's fw/%s)\n", path, n, name);
+	lck_mtx_lock(&glue_mtx);
+	if (kept_n < KEPT_MOST) {
+		strlcpy(kept[kept_n].name, drop, sizeof(kept[kept_n].name));
+		kept[kept_n].data = data;
+		kept[kept_n].size = (uint64_t)n;
+		kept_n++;
+	}
+	lck_mtx_unlock(&glue_mtx);
+	if (size != NULL) {
+		*size = (uint64_t)n;
+	}
+	return data;
+}
+#endif /* XCOVER5 */
diff --git a/bsd/dev/xc5_pmic.c b/bsd/dev/xc5_pmic.c
new file mode 100644
index 0000000..a8f4786
--- /dev/null
+++ b/bsd/dev/xc5_pmic.c
@@ -0,0 +1,521 @@
+/*
+ * XCover5: the S2MPU12 PMIC through the Exynos 850's ACPM (the always-on power processor owns the PMIC's
+ * SPEEDY bus; the AP asks it in a shared-SRAM queue). First user: the power key, which is the PMIC's own
+ * (dtbo s2mpu12mfd@1f, s2mpu12-keys "pmic-keys: KEY_POWER"), not a GPIO like the volume and XCover keys.
+ *
+ * Numbers from the phone's device tree (research/bootdtb_0.dts, dtbo o_0.dts):
+ *   acpm_ipc    mailbox 0x11900000 (0x1000), SRAM 0x02039000 (0x30000), initdata-base 0x7000
+ *   s2mpu12mfd  acpm-ipc-channel 2, i2c-speedy-address, reg 0x1f, interrupt SPI 0x38 (not used: polled)
+ * The protocol, after two ports that read Samsung's GPL drivers for it and wrote their own:
+ *   y2sios (Exynos 990, MIT: kernel/xnu/files/bsd/dev/redwood_exynos_acpm.c) -- the channel table at
+ *     initdata+8, the AP's count at initdata+24, 72-byte descriptors (rx = our requests at +16/+20/+24,
+ *     tx = its answers at +40/+44/+48, length +52, element size +56, type +12), the doorbell INTGR0 bit
+ *     16 + channel, answers pending in INTSR1, cleared in INTCR1, matched by a sequence in word 0 [21:16];
+ *   Scion (Exynos 9810, docs in drivers/soc/exynos/hakios.exynos_acpm.c) -- the PMIC channel's words:
+ *     word 0 = block << 8 | register (block: 0 top, 1 PMIC, 2 RTC), word 1 = function (0 read, 1 write,
+ *     2 update) | value << 8 | mask << 16; the answer's word 1: value [15:8], status [31:24] (0 good).
+ * No line of either is copied. The PMIC is only read, except one write: the RTC's RUDR latch (rtc_sync).
+ *
+ * Boot-args:
+ *   xc5rtc=0    do not set the calendar from the PMIC's RTC (default: set it at start-up, rtc_sync below)
+ *   xc5pmic=1  find the channel, dump the PMIC block's registers 0x00-0x2f and the RTC block's 0x00-0x1f once,
+ *               then every 100 ms read the PMIC block's 0x00-0x2f and print each register that changes (press
+ *               the power key: the one that follows it is the key's register) -- for 10 minutes
+ *   xc5pmic=2   the power key: read register xc5pwrreg (PMIC block) every 30 ms; bit xc5pwrbit set (or clear
+ *               with xc5pwrlow=1) is "pressed", handed to the keys driver as its Power (bsd/dev/a5xelte_keys.c)
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_time.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define ACPM_MBOX_PA    0x11900000UL
+#define ACPM_SRAM_PA    0x02039000UL
+#define ACPM_SRAM_SIZE  0x30000u
+#define ACPM_INITDATA   0x7000u
+
+#define INTGR0          0x08
+#define INTCR1          0x20
+#define INTSR1          0x28
+
+#define CH_PMIC         2
+#define TYPE_BUFFER     2
+#define SEQ_SHIFT       16
+#define SEQ_MASK        (0x3fu << SEQ_SHIFT)
+
+#define BLK_PMIC        1
+#define BLK_RTC         2
+
+/* the keys driver ORs this into its Power (bsd/dev/a5xelte_keys.c, XCOVER5) */
+volatile int xc5_pwrkey_down;
+uint64_t xcover5_pmic_state[4];         /* [0] mode, [1] reads, [2] failed, [3] power presses */
+
+static volatile uint8_t *mbox, *sram;
+static struct {
+	uint32_t id, len, elem, type, seq;
+	volatile uint8_t *req_front, *req_rear, *req_base;     /* ours -> APM */
+	volatile uint8_t *ans_front, *ans_rear, *ans_base;     /* APM -> ours */
+} ch;
+
+static inline uint32_t
+rd(volatile uint8_t *at)
+{
+	return *(volatile uint32_t *)at;
+}
+
+static inline void
+wr(volatile uint8_t *at, uint32_t v)
+{
+	*(volatile uint32_t *)at = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+in_sram(uint32_t off)
+{
+	return off < ACPM_SRAM_SIZE;
+}
+
+static int
+find_channel(void)
+{
+	uint32_t table = rd(sram + ACPM_INITDATA + 8), count = rd(sram + ACPM_INITDATA + 24);
+	printf("XC5 PMIC: ACPM initdata: channel table %#x, %u channels for the AP\n", table, count);
+	if (!in_sram(table) || count <= CH_PMIC || count > 32) {
+		return -1;
+	}
+	volatile uint8_t *d = sram + table + CH_PMIC * 72;
+	uint32_t rq_rear = rd(d + 16), rq_front = rd(d + 20), rq_base = rd(d + 24);
+	uint32_t an_rear = rd(d + 40), an_front = rd(d + 44), an_base = rd(d + 48);
+	ch.id = rd(d) & 0xff;
+	ch.type = rd(d + 12);
+	ch.len = rd(d + 52);
+	ch.elem = rd(d + 56);
+	printf("XC5 PMIC: channel %u: id %u type %u queue %u x %u, req %#x/%#x/%#x ans %#x/%#x/%#x, polled %u\n",
+	    CH_PMIC, ch.id, ch.type, ch.len, ch.elem, rq_rear, rq_front, rq_base, an_rear, an_front, an_base, rd(d + 68));
+	if (ch.elem < 16 || ch.elem > 64 || ch.len > 64 || !in_sram(rq_rear) || !in_sram(rq_front) ||
+	    !in_sram(rq_base) || !in_sram(an_rear) || !in_sram(an_front) || !in_sram(an_base) ||
+	    rq_rear > ACPM_SRAM_SIZE - 4 || rq_front > ACPM_SRAM_SIZE - 4 || an_rear > ACPM_SRAM_SIZE - 4 ||
+	    an_front > ACPM_SRAM_SIZE - 4 ||
+	    rq_base > ACPM_SRAM_SIZE - ch.elem * (ch.len ? ch.len : 1u) || an_base > ACPM_SRAM_SIZE - ch.elem * (ch.len ? ch.len : 1u)) {
+		return -1;                      /* (both queues have to fit in the mapped SRAM) */
+	}
+	ch.req_rear = sram + rq_rear;
+	ch.req_front = sram + rq_front;
+	ch.req_base = sram + rq_base;
+	ch.ans_rear = sram + an_rear;
+	ch.ans_front = sram + an_front;
+	ch.ans_base = sram + an_base;
+	return 0;
+}
+
+/* One request, its answer in cmd. 0, or -1. */
+static int
+ipc(uint32_t cmd[4])
+{
+	bool buffer = ch.type == TYPE_BUFFER || ch.len < 2;
+	uint32_t front = buffer ? 0 : rd(ch.req_front), next = buffer ? 0 : (front + 1 == ch.len ? 0 : front + 1);
+	if (!buffer && (front >= ch.len || rd(ch.req_rear) >= ch.len || rd(ch.ans_rear) >= ch.len ||
+	    rd(ch.ans_front) >= ch.len)) {
+		return -1;                      /* indices the APM gave that are not in the queue */
+	}
+	if (!buffer) {
+		/* stale answers first: a full answer queue stops the APM */
+		if (rd(ch.ans_rear) != rd(ch.ans_front)) {
+			wr(ch.ans_rear, rd(ch.ans_front));
+			wr(mbox + INTCR1, 1u << ch.id);
+		}
+		if (next == rd(ch.req_rear)) {
+			return -1;
+		}
+	}
+	uint32_t seq = ch.seq = ch.seq >= 63 ? 1 : ch.seq + 1;
+	cmd[0] = (cmd[0] & ~SEQ_MASK) | (seq << SEQ_SHIFT);
+	for (uint32_t i = 0; i < ch.elem / 4; i++) {
+		wr(ch.req_base + ch.elem * front + i * 4, i < 4 ? cmd[i] : 0);
+	}
+	if (!buffer) {
+		wr(ch.req_front, next);
+	}
+	wr(mbox + INTGR0, (1u << ch.id) << 16);
+	uint64_t deadline;
+	clock_interval_to_deadline(100, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		if (rd(mbox + INTSR1) & (1u << ch.id)) {
+			if (buffer) {
+				for (int w = 0; w < 4; w++) {
+					cmd[w] = rd(ch.ans_base + w * 4);
+				}
+				wr(mbox + INTCR1, 1u << ch.id);
+				return 0;
+			}
+			uint32_t rear = rd(ch.ans_rear), last = rd(ch.ans_front);
+			for (uint32_t i = rear; i != last; i = i + 1 == ch.len ? 0 : i + 1) {
+				volatile uint8_t *e = ch.ans_base + ch.elem * i;
+				if (((rd(e) & SEQ_MASK) >> SEQ_SHIFT) == seq) {
+					for (int w = 0; w < 4; w++) {
+						cmd[w] = rd(e + w * 4);
+					}
+					wr(ch.ans_rear, last);          /* one request at a time: the rest is stale */
+					wr(mbox + INTCR1, 1u << ch.id);
+					return 0;
+				}
+			}
+		}
+		delay(20);
+	}
+	return -1;
+}
+
+/* A PMIC register: its value, or -1. */
+static int
+pmic_read(uint32_t block, uint32_t reg)
+{
+	uint32_t cmd[4] = { block << 8 | reg, 0, 0, 0 };
+	xcover5_pmic_state[1]++;
+	if (ipc(cmd) != 0 || (cmd[1] >> 24) != 0) {
+		xcover5_pmic_state[2]++;
+		return -1;
+	}
+	return (int)((cmd[1] >> 8) & 0xff);
+}
+
+/* Write one PMIC register (function 1). 0, or -1. Used only for the RTC's RUDR latch below. */
+static int
+pmic_write(uint32_t block, uint32_t reg, uint32_t value)
+{
+	uint32_t cmd[4] = { block << 8 | reg, 1u | (value & 0xff) << 8, 0, 0 };
+	xcover5_pmic_state[1]++;
+	if (ipc(cmd) != 0 || (cmd[1] >> 24) != 0) {
+		xcover5_pmic_state[2]++;
+		return -1;
+	}
+	return 0;
+}
+
+static void
+dump(const char *what, uint32_t block, uint32_t n)
+{
+	char line[200];
+	size_t len = 0;
+	for (uint32_t r = 0; r < n; r++) {
+		int v = pmic_read(block, r);
+		if (r % 16 == 0) {
+			len = (size_t)snprintf(line, sizeof(line), "XC5 PMIC: %s %02x:", what, r);
+		}
+		len += (size_t)snprintf(line + len, sizeof(line) - len, v < 0 ? " --" : " %02x", v & 0xff);
+		if (r % 16 == 15 || r + 1 == n) {
+			printf("%s\n", line);
+		}
+	}
+}
+
+static int acpm_ready = -1;            /* -1 not tried, 0 no, 1 yes */
+
+static bool
+acpm_open(void)
+{
+	if (acpm_ready < 0) {
+		mbox = (volatile uint8_t *)ml_io_map(ACPM_MBOX_PA, 0x1000);
+		sram = (volatile uint8_t *)ml_io_map(ACPM_SRAM_PA, ACPM_SRAM_SIZE);
+		acpm_ready = find_channel() == 0;
+		if (!acpm_ready) {
+			printf("XC5 PMIC: no usable ACPM channel %u\n", CH_PMIC);
+		}
+	}
+	return acpm_ready == 1;
+}
+
+/*
+ * The date: the S2MPU12's RTC block (2), read at start-up, sets the kernel's calendar (it started at 1970: the lock
+ * screen said 31 December). Layout as Scion documents the S2MPS18's (drivers/power/hakios.s2mps18_rtc.c, from
+ * Samsung's rtc-s2mp.h; the S2MPU12's is checked against the first boot's dump): 0x00 CTRL (bit 0 BCD, bit 1 24 h),
+ * 0x02 UPDATE, 0x03 CAPSEL, 0x04 MSEC, 0x05 SEC, 0x06 MIN, 0x07 HOUR [4:0] (bit 6 PM), 0x08 WEEK, 0x09 DAY,
+ * 0x0A MONTH (1-12), 0x0B YEAR (since 2000), binary. What is read is what was last latched; S-Boot latches on every
+ * boot, early, so the time since then (the generic timer counts from S-Boot) is added. Nothing is written (no RUDR).
+ * Android kept this clock on network time, in UTC. Boot-arg xc5rtc=0 leaves the calendar alone.
+ */
+extern void clock_set_calendar_microtime(clock_sec_t secs, clock_usec_t microsecs);
+
+static uint64_t
+days_secs(uint32_t y, uint32_t mo, uint32_t d, uint32_t h, uint32_t mi, uint32_t s)
+{
+	static const uint16_t before[12] = { 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334 };
+	uint64_t days = 0;
+	for (uint32_t year = 1970; year < y; year++) {
+		days += ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0) ? 366 : 365;
+	}
+	days += before[mo - 1] + (d - 1);
+	if (mo > 2 && ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0)) {
+		days++;
+	}
+	return days * 86400 + (uint64_t)h * 3600 + (uint64_t)mi * 60 + s;
+}
+
+static uint32_t
+bcd(uint32_t v, bool is_bcd)
+{
+	return is_bcd ? (v >> 4) * 10 + (v & 0xf) : v;
+}
+
+/*
+ * Boots rtc1 and rtc2 (videos 165706, 180915): launchd still stamps 1969-12-31, and nothing of rtc_sync could be
+ * read -- at that point of the boot the screen shows the heartbeat block, not the log. So the outcome is kept here
+ * and said again every 20 s for three minutes by rtc_thread, which also sets the calendar again from the same
+ * reading (advanced by the uptime since) whenever it finds the calendar still before 2020.
+ */
+static char rtc_msg[200] = "XC5 RTC: never ran";
+static uint64_t rtc_secs, rtc_up_ns;           /* the date read, and the uptime when it was; 0: none */
+
+static uint64_t
+uptime_ns(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+static void
+rtc_thread(__unused void *arg, __unused wait_result_t wr_unused)
+{
+	for (int i = 0; i < 9; i++) {
+		delay(20 * 1000 * 1000);
+		clock_sec_t now;
+		clock_usec_t us;
+		clock_get_calendar_microtime(&now, &us);
+		printf("%s; calendar now %lu (uptime %llu s)\n", rtc_msg, (unsigned long)now, uptime_ns() / NSEC_PER_SEC);
+		if (rtc_secs != 0 && now < 1577836800ul) {     /* before 2020: set again */
+			uint64_t t = rtc_secs + (uptime_ns() - rtc_up_ns) / NSEC_PER_SEC;
+			clock_set_calendar_microtime((clock_sec_t)t, 0);
+			clock_get_calendar_microtime(&now, &us);
+			printf("XC5 RTC: calendar was before 2020: set again to %llu, reads back %lu\n", t, (unsigned long)now);
+		}
+	}
+}
+
+/*
+ * Set the RTC to t (seconds since 1970, UTC), as Samsung's driver writes the time (s2m_tm_to_data, s2m_rtc_set_time,
+ * read for the facts): SEC 0x05, MIN 0x06, HOUR 0x07 (24-hour value, bit 6 PM when 12 or later), WEEK 0x08 (1 << day
+ * of the week, Sunday 0), DAY 0x09, MONTH 0x0A (1-12), YEAR 0x0B (since 2000), binary; then UPDATE (0x02) |= WUDR
+ * (bit 1) moves them into the counters. 0, or -1.
+ */
+static int
+rtc_write(uint64_t t)
+{
+	uint64_t days = t / 86400, rest = t % 86400;
+	uint32_t wday = (uint32_t)((days + 4) % 7);            /* 1 January 1970 was a Thursday */
+	uint32_t y = 1970;
+	for (;;) {
+		uint32_t len = ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) ? 366 : 365;
+		if (days < len) {
+			break;
+		}
+		days -= len;
+		y++;
+	}
+	static const uint8_t mdays[12] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
+	uint32_t m = 0;
+	for (; m < 12; m++) {
+		uint32_t len = mdays[m] + (m == 1 && ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0));
+		if (days < len) {
+			break;
+		}
+		days -= len;
+	}
+	uint32_t hour = (uint32_t)(rest / 3600), min = (uint32_t)(rest % 3600 / 60), sec = (uint32_t)(rest % 60);
+	uint32_t v[7] = { sec, min, hour | (hour >= 12 ? 0x40u : 0u), 1u << wday, (uint32_t)days + 1, m + 1, y - 2000 };
+	for (uint32_t i = 0; i < 7; i++) {
+		if (pmic_write(BLK_RTC, 0x05 + i, v[i]) != 0) {
+			return -1;
+		}
+	}
+	int u = pmic_read(BLK_RTC, 0x02);
+	if (u < 0 || pmic_write(BLK_RTC, 0x02, (uint32_t)u | 0x02u) != 0) {
+		return -1;
+	}
+	delay(2000);
+	printf("XC5 RTC: written %u-%02u-%02u %02u:%02u:%02u UTC\n", y, m + 1, (uint32_t)days + 1, hour, min, sec);
+	return 0;
+}
+
+static void
+rtc_sync(void)
+{
+	int r[12];
+	uint32_t latch = 1;
+	/*
+	 * Samsung's own S2MPU12 driver (Galaxy A21s, Exynos 850 too: drivers/rtc/rtc-s2mpu12.c, read for these facts)
+	 * latches before every read: UPDATE (0x02) written with its own value | RUDR (bit 0), 1 ms, then SEC..YEAR.
+	 * Without it the registers hold whatever was latched last -- S-Boot's read, or an Android boot days ago.
+	 * The same one write here (xc5rtclatch=0: read only). The layout is that driver's (no CONFIG_RTC_DRV_S2MP):
+	 * MSEC 0x04, SEC 0x05 .. YEAR 0x0B, hour & 0x1f with PM bit 6, year + 2000; the RTC block is I2C address 2.
+	 */
+	(void)PE_parse_boot_argn("xc5rtclatch", &latch, sizeof(latch));
+	if (latch) {
+		int u = pmic_read(BLK_RTC, 0x02);
+		int e = u < 0 ? -1 : pmic_write(BLK_RTC, 0x02, (uint32_t)u | 1u);
+		delay(2000);
+		printf("XC5 RTC: latched (UPDATE %#x | RUDR): %d\n", u, e);
+	}
+	printf("XC5 RTC2: reading RTC block 2 registers 00-0b\n");
+	for (uint32_t i = 0; i < 12; i++) {
+		r[i] = pmic_read(BLK_RTC, i);
+		printf("XC5 RTC2: raw[%02x]=%d\n", i, r[i]);
+		if (r[i] < 0) {
+			snprintf(rtc_msg, sizeof(rtc_msg), "XC5 RTC: register %#x not readable (%llu reads, %llu failed)", i,
+			    xcover5_pmic_state[1], xcover5_pmic_state[2]);
+			printf("%s: calendar left alone\n", rtc_msg);
+			return;
+		}
+	}
+	printf("XC5 RTC: CTRL %02x UPDATE %02x CAPSEL %02x MSEC %02x SEC %02x MIN %02x HOUR %02x WEEK %02x DAY %02x "
+	    "MONTH %02x YEAR %02x\n", r[0], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9], r[10], r[11]);
+	bool b = r[0] & 1;
+	uint32_t sec = bcd(r[5] & 0x7f, b), min = bcd(r[6] & 0x7f, b), hour = bcd(r[7] & 0x1f, b);
+	uint32_t day = bcd(r[9] & 0x3f, b), mon = bcd(r[10] & 0x1f, b), year = 2000 + bcd(r[11] & 0x7f, b);
+	if (!(r[0] & 2) && (r[7] & 0x40) && hour < 12) {
+		hour += 12;                     /* 12-hour mode, PM */
+	}
+	uint64_t up_ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &up_ns);
+	uint64_t up = up_ns / NSEC_PER_SEC, add = latch ? 0 : ((up >= 2 && up < 600) ? up - 1 : 0), t = 0;
+	bool rtc_ok = !(sec > 59 || min > 59 || hour > 23 || day < 1 || day > 31 || mon < 1 || mon > 12 || year < 2024 ||
+	    year > 2099);
+	/*
+	 * rtc3 (video 182822): "2022-01-01 12:01:42 is not a date to trust (CTRL 02 raw 2a 01 4c 01 01 16)" -- the clock
+	 * runs from the device tree's init_time (2022-01-01 12:00), which Samsung's driver puts in a reset RTC; Android
+	 * then set it from the network, and Android no longer runs. (Scion's S9 found the same: 2018-01-01.) So the
+	 * image carries the host's time (xc5epoch=, tools/xcover5/dev/mkimage.sh), as y2sios's and Scion's epoch= does:
+	 * a clock that is invalid or behind it is not believed; the calendar starts at xc5epoch + uptime, and that time
+	 * is written into the RTC (xc5rtcwrite=0: not) so that the next boot, without a new image, reads it back.
+	 */
+	uint64_t epoch = 0;
+	uint32_t wr_rtc = 1;
+	(void)PE_parse_boot_argn("xc5epoch", &epoch, sizeof(epoch));
+	(void)PE_parse_boot_argn("xc5rtcwrite", &wr_rtc, sizeof(wr_rtc));
+	if (rtc_ok) {
+		t = days_secs(year, mon, day, hour, min, sec) + add;
+	}
+	if (!rtc_ok || (epoch != 0 && t < epoch)) {
+		char was[120];
+		snprintf(was, sizeof(was), "%u-%02u-%02u %02u:%02u:%02u (CTRL %02x raw %02x %02x %02x %02x %02x %02x)",
+		    year, mon, day, hour, min, sec, r[0], r[5], r[6], r[7], r[9], r[10], r[11]);
+		if (epoch == 0) {
+			snprintf(rtc_msg, sizeof(rtc_msg), "XC5 RTC: %s is not a date to trust and there is no xc5epoch", was);
+			printf("%s: calendar left alone\n", rtc_msg);
+			return;
+		}
+		t = epoch + up;
+		int w = wr_rtc ? rtc_write(t) : 1;
+		snprintf(rtc_msg, sizeof(rtc_msg), "XC5 RTC: the PMIC's clock said %s, %s xc5epoch %llu: using %llu; "
+		    "RTC %s", was, rtc_ok ? "behind" : "not valid;", epoch, t,
+		    w == 0 ? "written" : w == 1 ? "not written (xc5rtcwrite=0)" : "write FAILED");
+		year = mon = day = hour = min = sec = 0;
+		add = 0;
+	}
+	clock_sec_t before, after; clock_usec_t usec;
+	clock_get_calendar_microtime(&before, &usec);
+	clock_set_calendar_microtime((clock_sec_t)t, 0);
+	clock_get_calendar_microtime(&after, &usec);
+	printf("XC5 RTC2: before=%llu requested=%llu readback=%llu usec=%u\n",
+	    (unsigned long long)before, t, (unsigned long long)after, (unsigned)usec);
+	rtc_secs = t;
+	rtc_up_ns = uptime_ns();
+	if (year != 0) {
+		snprintf(rtc_msg, sizeof(rtc_msg), "XC5 RTC: the PMIC's clock said %u-%02u-%02u %02u:%02u:%02u UTC at uptime "
+		    "%llu s; set %llu, read back %lu", year, mon, day, hour, min, sec, up, t, (unsigned long)after);
+	}
+	printf("%s\n", rtc_msg);
+}
+
+static void
+pmic_thread(__unused void *arg, __unused wait_result_t wr_unused)
+{
+	int mode = (int)xcover5_pmic_state[0];
+	if (!acpm_open()) {
+		return;
+	}
+	int id = pmic_read(0, 0);
+	printf("XC5 PMIC: top block register 0 (chip id?) = %#x\n", id);
+	if (mode == 1) {
+		uint8_t last[0x30];
+		dump("pmic", BLK_PMIC, 0x30);
+		dump("rtc", BLK_RTC, 0x20);
+		for (uint32_t r = 0; r < sizeof(last); r++) {
+			int v = pmic_read(BLK_PMIC, r);
+			last[r] = (uint8_t)(v < 0 ? 0 : v);
+		}
+		printf("XC5 PMIC: watching the PMIC block 0x00-0x2f every 100 ms: press the power key\n");
+		for (int t = 0; t < 6000; t++) {
+			for (uint32_t r = 0; r < sizeof(last); r++) {
+				int v = pmic_read(BLK_PMIC, r);
+				if (v >= 0 && (uint8_t)v != last[r]) {
+					printf("XC5 PMIC: pmic %02x: %02x -> %02x\n", r, last[r], v);
+					last[r] = (uint8_t)v;
+				}
+			}
+			delay(100000);
+		}
+		printf("XC5 PMIC: watch over (%llu reads, %llu failed)\n", xcover5_pmic_state[1], xcover5_pmic_state[2]);
+		return;
+	}
+	uint32_t reg = 0, bit = 0, low = 0;
+	if (!PE_parse_boot_argn("xc5pwrreg", &reg, sizeof(reg)) || !PE_parse_boot_argn("xc5pwrbit", &bit, sizeof(bit))) {
+		printf("XC5 PMIC: xc5pmic=2 needs xc5pwrreg= and xc5pwrbit= (find them with xc5pmic=1)\n");
+		return;
+	}
+	(void)PE_parse_boot_argn("xc5pwrlow", &low, sizeof(low));
+	printf("XC5 PMIC: power key = PMIC register %#x bit %u (%s when pressed), every 30 ms\n", reg, bit,
+	    low ? "clear" : "set");
+	int was = 0;
+	for (;;) {
+		int v = pmic_read(BLK_PMIC, reg);
+		if (v >= 0) {
+			int down = ((v >> bit) & 1) != (int)low;
+			if (down != was) {
+				was = down;
+				xc5_pwrkey_down = down;
+				if (down) {
+					xcover5_pmic_state[3]++;
+				}
+				printf("XC5 PMIC: power key %s\n", down ? "down" : "up");
+			}
+		}
+		delay(30000);
+	}
+}
+
+void xc5_pmic_start(void);
+void
+xc5_pmic_start(void)
+{
+	int mode = 0, rtc = 1;
+	(void)PE_parse_boot_argn("xc5rtc", &rtc, sizeof(rtc));
+	printf("XC5 RTC2: entered xc5rtc=%d\n", rtc);
+	int connected = rtc ? acpm_open() : 0;
+	printf("XC5 RTC2: ACPM=%d enabled=%d\n", connected, rtc);
+	if (rtc && connected) {
+		rtc_sync();             /* before launchd: everything after starts at the right date */
+	} else if (rtc) {
+		snprintf(rtc_msg, sizeof(rtc_msg), "XC5 RTC: ACPM not usable at start-up");
+	}
+	if (rtc) {
+		thread_t rt;
+		if (kernel_thread_start(rtc_thread, NULL, &rt) == KERN_SUCCESS) {
+			thread_deallocate(rt);
+		}
+	}
+	if (!PE_parse_boot_argn("xc5pmic", &mode, sizeof(mode)) || mode == 0) {
+		return;
+	}
+	xcover5_pmic_state[0] = (uint64_t)mode;
+	thread_t thread;
+	if (kernel_thread_start(pmic_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/xc5_scsc.c b/bsd/dev/xc5_scsc.c
new file mode 100644
index 0000000..d3ba2b1
--- /dev/null
+++ b/bsd/dev/xc5_scsc.c
@@ -0,0 +1,3800 @@
+/*
+ * XCover5 (2026-11-27): the Galaxy A50 port's driver (github.com/nespaces/ios-a50-exynos9610,
+ * core/drivers/wifi/hakios.scsc.c at eaccebe, APSL 2.0 as the rest of that port's kernel files; tools/xcover5/a50/
+ * NOTICE.md) for the same SCSC mx140 on the Galaxy XCover5's Exynos 850. What is the Exynos 850's here and not the
+ * 9610's: the PMU's WLBT registers and its power-up (platform_mif_3830.c, mif_reg_S5E3830.h: WLBT_CTRL_S START,
+ * WLBT_OPTION, TOP_OUT PWRRGTON_CP, VGPIO_TX_MONITOR, WLBT_CONFIGURATION, WLBT_STATUS, WLBT_ACTIVE_CLR/EN -- no
+ * MASK_PWR_REQ there), CFG_REQ (SPI 0xE6 at the 850's GIC), WLBT_REMAP at +0x400, the shared DRAM (wifibt_if, 12 MiB
+ * at 0x880000000, kept out of XNU), the DBUS window of 12 MiB and the two PBUS windows Samsung's 3830 driver sets,
+ * no CHIP_VERSION_ID EMA bits, no guard word, and the firmware files from the drop zone (bsd/dev/xc5_hakios_glue.c).
+ * It replaces bsd/dev/xc5_wlbt.c (the XCover5's own driver, in git history). Boot-arg scsc=6.
+ *
+ * The Galaxy A50's Wi-Fi and Bluetooth: Samsung's SCSC S620 ("Leman", Maxwell mx140), a companion chip on the
+ * Exynos 9610's own buses -- not SDIO, not PCIe -- powered and reset through the PMU, talking to the AP through a
+ * mailbox (0x119C0000) and shared DRAM. Boot-arg scsc=N:
+ *   1  a look: the PMU's WLBT registers and the mailbox, read and said; nothing written
+ *   3  power, mx140.bin, the Maxwell manager and the WLAN service; 4 one ADD_VIF; 5 then one passive scan
+ *   6  stays up: en0 and the station (power, passive scan, the networks). A join is WPA2-PSK
+ *      with CCMP, or an open network; other protection is refused
+ *   7  one Bluetooth HCI Reset; 8 BLE scan and experimental iOS HCI command/event transport
+ * Facts: the A50 kernel's drivers/misc/samsung/scsc (GPL-2.0, read for facts, not copied):
+ * mif_reg_S5E9610.h (offsets, bits), platform_mif_9610.c (the sequences); the phone's device tree.
+ */
+#include <kern/startup.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <stdarg.h>
+#include <sys/systm.h>
+#include <vm/vm_kern.h>
+#include <mach/vm_param.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <sys/errno.h>
+#include <sys/hakios.net.h>
+#include <sys/hakios.sta.h>
+#include <sys/hakios.macaddr.h>
+#include <sys/random.h>
+#include <kern/clock.h>              /* XCover5: the 30 s retry of the standing network */
+#include <mach/mach_time.h>
+#include <net/kpi_interface.h>         /* XCover5: lo0, before en0 */
+#ifdef HAKIOS_BCM4361_BT
+#include <kern/clock.h>
+#include <sys/kern_control.h>
+#include <sys/proc.h>
+#include <sys/tty.h>
+#include <sys/ttycom.h>
+#endif
+#include "hakios.lx_wpa.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_line(const char *line);
+extern void delay(int usec);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+#ifndef VM_WIMG_WCOMB
+#define VM_WIMG_WCOMB           0x6
+#endif
+extern const uint8_t *hakios_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+extern int hakios_partition_file(const char *partition, const char *mount, const char *path, uint64_t max, const uint8_t **data,
+    uint64_t *size);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	loader_log_line(line);
+	return printf("%s", line);
+}
+
+#define PMU_PA                  0x11860000u     /* system-controller@11860000 */
+#define MAILBOX_WLBT_PA         0x119C0000u     /* the AP<->WLBT mailbox (MAILBOX_AP2WLBT) */
+#define APM_PMIC_PA             0x11A50000u     /* VGPIO_TX_MONITOR at +0x1700 */
+#define VGPIO_TX_MONITOR        0x1700
+
+/* PMU (mif_reg_S5E3830.h) */
+#define WLBT_CONFIGURATION      0x3100          /* [0] LOCAL_PWR_CFG: power on */
+#define WLBT_STATUS             0x3104          /* [0] powered */
+#define WLBT_STATES             0x3108
+#define WLBT_OPTION             0x310C          /* [3] DATA */
+#define WLBT_CTRL_NS            0x3110          /* [6] ACTIVE_CLR [5] ACTIVE_EN */
+#define WLBT_CTRL_S             0x3114          /* [3] START */
+#define WLBT_DEBUG              0x005C
+#define TOP_OUT                 0x3920          /* [1] PWRRGTON_CP */
+
+/* the mailbox */
+#define INTGR0                  0x008
+#define INTMR0                  0x010
+#define INTSR0                  0x014
+#define INTGR1                  0x01C
+#define INTMR1                  0x024
+#define INTSR1                  0x028
+#define ISSR(n)                 (0x080 + 4 * (n))
+
+static uint64_t
+scsc_smc(uint64_t function, uint64_t first, uint64_t second, uint64_t third)
+{
+	register uint64_t x0 __asm__("x0") = function;
+	register uint64_t x1 __asm__("x1") = first;
+	register uint64_t x2 __asm__("x2") = second;
+	register uint64_t x3 __asm__("x3") = third;
+
+	__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : : "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	    "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	return x0;
+}
+
+static void
+scsc_look(void)
+{
+	vm_offset_t pmu = ml_io_map(PMU_PA, 0x10000);
+
+	if (pmu == 0) {
+		say("scsc: 1: the PMU could not be mapped\n");
+		return;
+	}
+	/* (the mailbox is not read: with WLBT off its block may have no clock -- the A50's 9 November) */
+	say("scsc: 1: PMU WLBT CONFIGURATION %#x STATUS %#x STATES %#x OPTION %#x CTRL_NS %#x CTRL_S %#x DEBUG %#x\n",
+	    *(volatile uint32_t *)(pmu + WLBT_CONFIGURATION), *(volatile uint32_t *)(pmu + WLBT_STATUS),
+	    *(volatile uint32_t *)(pmu + WLBT_STATES), *(volatile uint32_t *)(pmu + WLBT_OPTION),
+	    *(volatile uint32_t *)(pmu + WLBT_CTRL_NS), *(volatile uint32_t *)(pmu + WLBT_CTRL_S),
+	    *(volatile uint32_t *)(pmu + WLBT_DEBUG));
+}
+
+/*
+ * The A50's guard word (a DRAM page S-Boot leaves alone, set around a step that once stopped the phone for good) has
+ * no such page known on the XCover5, and no step here has stopped it: the guard always lets the step run.
+ */
+static bool
+guard_enter(uint32_t step)
+{
+	(void)step;
+	return true;
+}
+
+static void
+guard_leave(void)
+{
+}
+
+/* The A50's step 2 (power through MASK_PWR_REQ, not started): the 850's PMU has no such bit; scsc=3 powers and starts. */
+static void
+scsc_wlbt_power(void)
+{
+	say("scsc: 2: not on the Exynos 850 (no MASK_PWR_REQ): scsc=3 or more powers the chip and starts it\n");
+}
+
+/*
+ * Step 3: the chip started, as Samsung's mxman_start() and platform_mif_9610.c do it, short of the Maxwell manager:
+ *   - 16 MB of shared DRAM (the device tree's wifibt_if, 0x1000000), mx140.bin copied to its start verbatim
+ *     (mx140_file.c), cleaned to memory
+ *   - the mailbox reset as platform_mif_map() leaves it; ISSR0 the firmware's entry point (its header, +40), ISSR1 the
+ *     configuration's address (0 here: no mxconf yet), ISSR2 0xbcdeedcb, ISSR3 the start flags (0) (mxman.c mbox_init)
+ *   - WLBT_CTRL_S WLBT_START (the power and the reset as step 2), then the chip's boot ROM raises CFG_REQ (SPI 73,
+ *     GIC INTID 105, polled at the distributor's pending bits) and waits for the AP to configure it
+ *     (platform_cfg_req_isr): the TZPC through SMC CONN_IF, WLBT_REMAP, CHIP_VERSION_ID's EMA bits, the DBUS window
+ *     (WLBT 0x80000000.. -> the shared DRAM) and PBUS windows (the mailboxes, USI_CMG00, SYSREG_CMGP2WLBT, GPIO_CMGP,
+ *     SHUB), the keep-alive patch into BOOT_CFG +0x1000 (fw/scsc_ka.bin, tools/a50-scsc-ka.py), BOOT_CFG_ACK, and the
+ *     power given back (MASK_PWR_REQ 0)
+ * then for 5 s what the firmware does: the mailbox, the PMU, the first words of the panic record (header +176).
+ */
+#define GICD_PA                 0x12a01000u
+#define CFG_REQ_INTID           (0xE6u + 32u)   /* SPI 0xE6 (the 850's device tree: WLBT CFG_REQ) */
+#define WLBT_REMAP_PA           0x14C50000u
+#define DBUS_BAAW_PA            0x14C20000u
+#define PBUS_BAAW_PA            0x14C30000u
+#define BOOT_CFG_PA             0x14C60000u
+#define SHARED_BYTES            0xC00000u       /* wifibt_if: 12 MiB (WLBT_DBUS_BAAW_0_END 0x80C00000) */
+#define SHARED_PA               0x880000000ull  /* above 4 GiB, kept out of XNU (its RAM starts at 0x8a2800000) */
+#define BAAW_ACCESS             0x80000003u     /* INIT_DONE | EN_WRITE | EN_READ */
+
+static void
+w32(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+	__builtin_arm_dsb(0xf);
+}
+
+static uint32_t
+r32(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+/*
+ * Step 4: Maxwell's configuration (mxman.c transports_init(), mxconf.h, mifstream.c, cpacket_buffer.c, the 9610's
+ * mifintrbit): struct mxconf (magic 0x79828486, version 0.5) and the circular packet buffers it names, laid out in the
+ * shared DRAM after the firmware's runtime (miframman's heap starts at fw_runtime_length), every address an offset
+ * from the shared DRAM's start (platform_mif_get_mifram_ref). The streams, sized as Linux sizes them:
+ *   mxmgmt   to the AP and from it: 4 packets of 128 bytes (struct mxmgr_message: channel id, then 127 bytes)
+ *   gdb      R4's and M4's monitors, both ways: 512 packets of 4 bytes; M4_1 not in use (buffer 0)
+ *   mxlog    to the AP: 4096 packets of 4 bytes
+ * A stream to the AP is filled with 0xff first (mif_stream_init). Its read bit is the AP's to the chip, its write bit
+ * the chip's to the AP; from the AP, the other way round. The AP's bits to the chip go to the mailbox's INTGR1 (bit 0
+ * kept for forcing a panic), the chip's to the AP come in INTSR0's top half: not used here, the indices are polled.
+ */
+struct mx_cbuf {
+	uint32_t buffer, num_packets, packet_size, read_index, write_index;
+};
+struct mx_stream {
+	struct mx_cbuf buf;
+	uint8_t read_bit, write_bit, pad[2];
+};
+struct mx_trans {
+	struct mx_stream to_ap, from_ap;
+};
+struct mx_conf {
+	uint32_t magic;
+	uint16_t major, minor;
+	struct mx_trans mgmt, gdb_r4, gdb_m4;
+	struct mx_stream log;
+	uint32_t soc_revision, flags;
+	uint32_t fwconfig_offset, fwconfig_size;
+	struct mx_trans gdb_m4_1;
+};
