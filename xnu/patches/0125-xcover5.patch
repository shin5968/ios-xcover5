+
+/* One byte full duplex, polled (FIFO levels: TX [14:6], RX [23:15]). */
+static int
+xc5ts_xfer(uint8_t tx)
+{
+	for (int i = 0; i < 100000; i++) {
+		if (((xc5ts_rd(xc5ts_spi, 0x14) >> 6) & 0x1ffu) < 64) {
+			xc5ts_wr(xc5ts_spi, 0x18, tx);
