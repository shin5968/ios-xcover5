+	h->v5.fh_int = fh_bit;
+	h->v5.th_int = th_bit;
+	h->v5.scbrd_loc = h->v4.scbrd_loc;
+	h->v5.q_num = 6;
+	h->v5.q_len = 256;
+	h->v5.q_idx_sz = 1;
