diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 4fd8729..8a687cc 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -385,6 +385,135 @@ static struct mac_policy_conf sweet_amfi_mac_conf = {
 
 static mac_policy_handle_t sweet_amfi_mac_handle;
 
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)  /* XCOVER5 tree */
+#include <sys/errno.h>
+#include <pexpert/pexpert.h>
+#include <sys/sysctl.h>
+extern uint64_t xc5_gl_dyld_flags(void);
+
+/*
+ * AMFI's sysctl node, which the AMFI kext makes on a device (ios-topaz 0150):
+ * libamfi's amfi_developer_mode_status() reads security.mac.amfi.
+ * developer_mode_status (8 bytes, 1 = on) and ExtensionKit wants it when it
+ * reads the extension cache. Without it: "Unable to find AMFI", no extension
+ * points, no wallpapers or widgets.
+ */
+SYSCTL_DECL(_security_mac);
+SYSCTL_NODE(_security_mac, OID_AUTO, amfi, CTLFLAG_RW | CTLFLAG_LOCKED, 0, "AMFI");
+static uint64_t xc5_amfi_developer_mode = 1;
+static uint64_t xc5_amfi_qa_root_certs = 0;
+/*
+ * For the heartbeat (boot 70: no extension of any kind registered; is AMFI asked
+ * at all, and by whom?): reads of developer_mode_status, and the first six
+ * __mac_syscall("AMFI") request numbers with their counts and last caller.
+ */
+uint32_t xcover5_amfi_dev_reads;
+char xcover5_amfi_dev_last[20];
+int32_t xcover5_amfi_callno[6] = { -1, -1, -1, -1, -1, -1 };
+uint32_t xcover5_amfi_callcnt[6];
+char xcover5_amfi_calllast[6][20];
+
+static int
+xc5_amfi_dev_sysctl(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2,
+    struct sysctl_req *req)
+{
+	xcover5_amfi_dev_reads++;
+	proc_selfname(xcover5_amfi_dev_last, sizeof(xcover5_amfi_dev_last));
+	return SYSCTL_OUT(req, &xc5_amfi_developer_mode, sizeof(xc5_amfi_developer_mode));
+}
+SYSCTL_PROC(_security_mac_amfi, OID_AUTO, developer_mode_status,
+    CTLTYPE_QUAD | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0, xc5_amfi_dev_sysctl, "Q",
+    "developer mode (on: nothing is restricted here)");
+SYSCTL_QUAD(_security_mac_amfi, OID_AUTO, qa_root_certs_allowed, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &xc5_amfi_qa_root_certs, "");
+
+static void
+xc5_amfi_count(int call)
+{
+	for (int i = 0; i < 6; i++) {
+		if (xcover5_amfi_callno[i] == call || xcover5_amfi_callno[i] < 0) {
+			xcover5_amfi_callno[i] = call;
+			xcover5_amfi_callcnt[i]++;
+			proc_selfname(xcover5_amfi_calllast[i], sizeof(xcover5_amfi_calllast[i]));
+			return;
+		}
+	}
+}
+
+static int
+xc5_amfi_dyld_syscall(__unused struct proc *p, int call, user_addr_t arg)
+{
+	struct {
+		uint64_t input_flags;
+		uint64_t output;        /* user pointer to a u64 */
+	} args;
+	uint64_t flags;
+
+	xc5_amfi_count(call);
+	/*
+	 * Request 0x60, the state of AMFI's boot-args (herolte 0306, after FiiO JM21's
+	 * kern_minimac.c): unless one of the bits 0x86 is set, ExtensionKit wants
+	 * /System/Library/xpc/extensions.plist's signature checked by AMFI's IOKit
+	 * service, which is not here; the table is not read and LaunchServices refuses
+	 * every app extension: no PosterBoard wallpapers (black), widgets "Waiting...".
+	 * Boot-arg xc5ext=0 keeps the old answer.
+	 */
+	static int ext = -1;
+	if (ext < 0) {
+		ext = 1;
+		(void)PE_parse_boot_argn("xc5ext", &ext, sizeof(ext));
+	}
+	if (call == 0x60) {
+		if (!ext) {
+			return ENOPOLICY;
+		}
+		static int said;
+		if (said++ < 3) {
+			printf("XC5 AMFI: boot-arg state (0x60) for pid %d: 0x86\n", proc_selfpid());
+		}
+		flags = 0x86;
+		return copyout(&flags, arg, sizeof(flags));
+	}
+	/*
+	 * Any other request (ios-topaz 0147): succeed and leave the caller's output
+	 * alone, as libamfi's queries (ExtensionFoundation's among them) expect from a
+	 * policy named AMFI. dyld's request 90 keeps ENOPOLICY except for xc5gl.
+	 */
+	if (call != 90) {
+		static uint64_t seen;
+		if (!ext) {
+			return ENOPOLICY;
+		}
+		if (call >= 0 && call < 64 && !(seen & (1ULL << call))) {
+			seen |= 1ULL << call;
+			printf("XC5 AMFI: request %d from pid %d: ok\n", call, proc_selfpid());
+		}
+		return 0;
+	}
+	if ((flags = xc5_gl_dyld_flags()) == 0) {
+		return ENOPOLICY;
+	}
+	if (copyin(arg, &args, sizeof(args)) != 0) {
+		return EFAULT;
+	}
+	printf("XC5 AMFI: dyld policy for pid %d: input 0x%llx -> 0x%llx\n",
+	    proc_selfpid(), args.input_flags, flags);
+	return copyout(&flags, (user_addr_t)args.output, sizeof(flags));
+}
+
+static const struct mac_policy_ops xc5_amfi_dyld_mac_ops = {
+	.mpo_policy_syscall = xc5_amfi_dyld_syscall,
+};
+
+static struct mac_policy_conf xc5_amfi_dyld_mac_conf = {
+	.mpc_name = "AMFI",
+	.mpc_fullname = "XCover5 dyld policy for xc5gl",
+	.mpc_ops = &xc5_amfi_dyld_mac_ops,
+};
+
+static mac_policy_handle_t xc5_amfi_dyld_mac_handle;
+#endif
+
 /* Called from bsd_init once MAC policies can register, before any exec. */
 void sweet_amfi_policy_register(void);
 
@@ -397,5 +526,9 @@ sweet_amfi_policy_register(void)
 	error = mac_policy_register(&sweet_sandbox_mac_conf, &sweet_sandbox_mac_handle, NULL);
 	printf(PORT_NAME " Sandbox: permissive policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	error = mac_policy_register(&xc5_amfi_dyld_mac_conf, &xc5_amfi_dyld_mac_handle, NULL);
+	printf("XC5 AMFI: dyld policy %s (%d)\n", error ? "NOT registered" : "registered", error);
+#endif
 }
 #endif /* SWEET || A5XELTE */
