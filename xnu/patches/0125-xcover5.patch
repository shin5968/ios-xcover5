+#if defined(XCOVER5)
+#define EMMC_MULTI_MAX  512u            /* sectors per command: 256 KiB */
+#define CMD_SEND_STOP   (1u << 12)
+#define INT_ACD         (1u << 14)
+/* Boot 11: rint 0x424 = HTO, the FIFO was full and the controller paused
+ * the card clock until the CPU drained it. Not an error for PIO. */
+#define INT_HTO         (1u << 10)
+#define CMD_STOP_ABORT  (1u << 14)
+static uint64_t emmc_multi_buf[EMMC_MULTI_MAX * 512u / 8u];
+static int emmc_multi = -1;
+
+/* After a failed CMD18/CMD25 the card is still in its data state: without
+ * CMD12 the next read returns the old transfer's sectors (boot 11: HFS
+ * B-tree corruption). Stop it and empty the FIFO. */
+static void
+emmc_stop_transmission(void)
+{
+	uint32_t cmd = CMD_START | CMD_RESP_CRC | CMD_RESP | CMD_STOP_ABORT | 12u;
+	if ((emmc_rd(EMMC_CLKSEL) >> 16) & 7u) {
+		cmd |= CMD_HOLD;
+	}
+	for (unsigned i = 0; i < 1000000 && (emmc_rd(EMMC_CMD) & CMD_START); i++) {
+	}
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_CMDARG, 0);
+	emmc_wr(EMMC_CMD, cmd);
+	for (unsigned i = 0; i < 1000000; i++) {
+		if (emmc_rd(EMMC_RINTSTS) & INT_CMD_DONE) {
+			break;
+		}
+	}
+	for (unsigned i = 0; i < 4000000 && (emmc_rd(EMMC_STATUS) & (1u << 9)); i++) {
+	}
+	emmc_wr(EMMC_CTRL, emmc_rd(EMMC_CTRL) | CTRL_FIFO_RESET);
+	for (unsigned i = 0; i < 1000000 && (emmc_rd(EMMC_CTRL) & CTRL_FIFO_RESET); i++) {
+	}
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+}
+
+static int
+emmc_wait_idle(void)
+{
+	for (unsigned i = 0; i < 4000000; i++) {
+		if (!(emmc_rd(EMMC_STATUS) & (1u << 9))) {
+			return 0;
+		}
+	}
+	return ETIMEDOUT;
+}
+
+/* nblk sectors at lba to/from emmc_multi_buf; root partition only. */
+static int
+emmc_xfer_blocks(uint32_t lba, uint32_t nblk, bool write)
+{
+	uint32_t hcon = emmc_rd(EMMC_HCON);
+	uint32_t width = (hcon >> 7) & 7u;
+	uint32_t ver = emmc_rd(EMMC_VERID) & 0xffffu;
+	uint32_t data_off = ver < 0x240au ? 0x100u : 0x200u;
+	uint32_t ctrl = emmc_rd(EMMC_CTRL);
+	uint32_t ints = emmc_rd(EMMC_INTMASK);
+	uint32_t unit, words, done = 0;
+	int error = 0;
+
+	if (nblk == 0 || nblk > EMMC_MULTI_MAX || width > 2 || ver == 0 || ver == 0xffff ||
+	    !(emmc_rd(EMMC_PWREN) & 1u) || !(emmc_rd(EMMC_CLKENA) & 1u)) {
+		return ENXIO;
+	}
+	bool in_cache = !write && emmc_log_nsectors != 0 && (uint64_t)lba >= emmc_log_first_lba &&
+	    (uint64_t)lba + nblk <= emmc_log_first_lba + emmc_log_nsectors;
+	if (!in_cache && ((uint64_t)lba < emmc_first_lba ||
+	    (uint64_t)lba + nblk > emmc_first_lba + emmc_nsectors)) {
+		return EINVAL;
+	}
+	if (write && !emmc_writable) {
+		return EROFS;
+	}
+	unit = 2u << width;
+	words = nblk * 512u / unit;
+	if (emmc_wait_idle()) {
+		return EBUSY;
+	}
+	emmc_wr(EMMC_INTMASK, 0);
+	emmc_wr(EMMC_CTRL, (ctrl & ~(CTRL_INT_ENABLE | CTRL_DMA_ENABLE |
+	    CTRL_USE_IDMAC)) | CTRL_FIFO_RESET);
+	for (unsigned i = 0;; i++) {
+		if (!(emmc_rd(EMMC_CTRL) & CTRL_FIFO_RESET)) {
+			break;
+		}
+		if (i == 999999) {
+			error = ETIMEDOUT;
+			goto out;
+		}
+	}
+	emmc_wr(EMMC_TMOUT, 0x573177ffu);
+	emmc_wr(EMMC_BLKSIZ, 512);
+	emmc_wr(EMMC_BYTCNT, nblk * 512u);
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_CMDARG, lba);
+	uint32_t command = CMD_START | CMD_WAIT_DATA | CMD_DATA | CMD_RESP_CRC | CMD_RESP;
+	if (write) {
+		command |= CMD_WRITE;
+	}
+	if (nblk > 1) {
+		command |= CMD_SEND_STOP | (write ? 25u : 18u);
+	} else {
+		command |= write ? 24u : 17u;
+	}
+	if ((emmc_rd(EMMC_CLKSEL) >> 16) & 7u) {
+		command |= CMD_HOLD;
+	}
+	emmc_wr(EMMC_CMD, command);
+	if (write) {
+		xcover5_emmc_writes += nblk;
+	} else {
+		xcover5_emmc_reads += nblk;
+	}
+	uint64_t limit = 4000000ull + 400000ull * nblk;
+	for (uint64_t i = 0;; i++) {
+		uint32_t pending = emmc_rd(EMMC_RINTSTS);
+		if (pending & INT_HTO) {
+			emmc_wr(EMMC_RINTSTS, INT_HTO);
+		}
+		if (pending & INT_ERRORS & ~INT_HTO) {
+			printf("XC5 eMMC: CMD%u error lba=%u n=%u rint=%x status=%x words=%u/%u\n",
+			    command & 0x3fu, lba, nblk, pending, emmc_rd(EMMC_STATUS), done, words);
+			error = EIO;
+			goto out;
+		}
+		uint32_t fifo = (emmc_rd(EMMC_STATUS) >> 17) & 0x1fffu;
+		if (write) {
+			while (fifo < EMMC_FIFO_DEPTH && done < words) {
+				if (unit == 8) {
+					emmc_wr(data_off, (uint32_t)emmc_multi_buf[done]);
+					emmc_wr(data_off + 4, (uint32_t)(emmc_multi_buf[done] >> 32));
+				} else if (unit == 4) {
+					emmc_wr(data_off, ((uint32_t *)emmc_multi_buf)[done]);
+				} else {
+					*(volatile uint16_t *)(emmc_regs + data_off) =
+					    ((uint16_t *)emmc_multi_buf)[done];
+				}
+				done++;
+				fifo++;
+			}
+			if (pending & INT_TXDR) {
+				emmc_wr(EMMC_RINTSTS, INT_TXDR);
+			}
+		} else {
+			while (fifo && done < words) {
+				if (unit == 8) {
+					uint32_t lo = emmc_rd(data_off);
+					uint32_t hi = emmc_rd(data_off + 4);
+					emmc_multi_buf[done] = (uint64_t)lo | ((uint64_t)hi << 32);
+				} else if (unit == 4) {
+					((uint32_t *)emmc_multi_buf)[done] = emmc_rd(data_off);
+				} else {
+					((uint16_t *)emmc_multi_buf)[done] =
+					    *(volatile uint16_t *)(emmc_regs + data_off);
+				}
+				done++;
+				fifo--;
+			}
+			if (pending & INT_RXDR) {
+				emmc_wr(EMMC_RINTSTS, INT_RXDR);
+			}
+		}
+		if (done == words && (pending & INT_DATA_OVER) && (pending & INT_CMD_DONE)) {
+			break;
+		}
+		if (i == limit) {
+			printf("XC5 eMMC: CMD%u timeout lba=%u n=%u rint=%x words=%u/%u\n",
+			    command & 0x3fu, lba, nblk, pending, done, words);
+			error = ETIMEDOUT;
+			goto out;
+		}
+	}
+	if (nblk > 1) {
+		/* The controller sends CMD12 itself; let it finish. */
+		for (unsigned i = 0; i < 1000000; i++) {
+			if (emmc_rd(EMMC_RINTSTS) & INT_ACD) {
+				break;
+			}
+		}
+	}
+	if (write || nblk > 1) {
+		error = emmc_wait_idle();
+	}
+out:
+	if (error) {
+		emmc_stop_transmission();
+	}
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_INTMASK, ints);
+	return error;
+}
+
+#define EMMC_BMOD       0x080u
+#define EMMC_PLDMND     0x084u
+#define EMMC_DBADDRL    0x088u
+#define EMMC_DBADDRU    0x08cu
+#define EMMC_IDSTS      0x090u
+#define EMMC_IDINTEN    0x094u
+#define CTRL_DMA_RESET  (1u << 2)
+#define BMOD_SWR        (1u << 0)
+#define BMOD_FB         (1u << 1)
+#define BMOD_DE         (1u << 7)
+#define IDSTS_RI        (1u << 1)
+#define IDSTS_ERRORS    ((1u << 2) | (1u << 4) | (1u << 5) | (1u << 9)) /* FBE DU CES AIS */
+#define DES0_OWN        (1u << 31)
+#define DES0_CH         (1u << 4)
+#define DES0_FS         (1u << 3)
+#define DES0_LD         (1u << 2)
+#define DES0_DIC        (1u << 1)
+#define HCON_ADDR64     (1u << 27)
+#define EMMC_DMA_SEG    4096u
+#define EMMC_DESC_WORDS 32u
+extern uint64_t kvtophys(vm_offset_t va);
+static uint32_t emmc_desc[EMMC_MULTI_MAX * 512u / EMMC_DMA_SEG][EMMC_DESC_WORDS]
+    __attribute__((aligned(128)));
+static int emmc_dma = -1;
+static unsigned emmc_dma_checks, emmc_dma_sample;
+uint64_t xcover5_emmc_dma_reads;
+/* Heartbeat: DMA on, errors, PIO checks left, last error. */
+int xcover5_emmc_dma_on;
+unsigned emmc_dma_errors, xcover5_emmc_dma_checks_left;
+int xcover5_emmc_dma_last_error;
+/* rint idsts bmod ctrl dscaddr bufaddr tbbcnt status at the last DMA error. */
+uint32_t xcover5_emmc_dma_diag[8];
+
+/* The device does not snoop: clean and invalidate to the point of coherency. */
+static void
+emmc_dcache_flush(const void *p, size_t len)
+{
+	uintptr_t a = (uintptr_t)p & ~(uintptr_t)63, end = (uintptr_t)p + len;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (; a < end; a += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r"(a) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static int
+emmc_wait_clear(uint32_t off, uint32_t bits)
+{
+	for (unsigned i = 0; i < 1000000; i++) {
+		if (!(emmc_rd(off) & bits)) {
+			return 0;
+		}
+	}
+	return ETIMEDOUT;
+}
+
+/* nblk (> 1) sectors at lba into emmc_multi_buf by IDMAC. */
+static int
+emmc_dma_read(uint32_t lba, uint32_t nblk)
+{
+	uint32_t ctrl = emmc_rd(EMMC_CTRL);
+	uint32_t ints = emmc_rd(EMMC_INTMASK);
+	uint32_t bytes = nblk * 512u;
+	uint32_t nseg = (bytes + EMMC_DMA_SEG - 1) / EMMC_DMA_SEG;
+	uint64_t buf_pa = kvtophys((vm_offset_t)emmc_multi_buf);
+	uint64_t desc_pa = kvtophys((vm_offset_t)emmc_desc);
+	uint32_t pending = 0, idsts = 0;
+	int error = 0;
+
+	if (nblk < 2 || nblk > EMMC_MULTI_MAX || buf_pa == 0 || desc_pa == 0 ||
+	    !(emmc_rd(EMMC_HCON) & HCON_ADDR64)) {
+		/* Boot 40: dma=0 for the whole boot; say why. */
+		printf("XC5 eMMC: no DMA n=%u hcon=%x buf=0x%llx desc=0x%llx\n", nblk,
+		    emmc_rd(EMMC_HCON), buf_pa, desc_pa);
+		return ENXIO;
+	}
+	if ((uint64_t)lba < emmc_first_lba ||
+	    (uint64_t)lba + nblk > emmc_first_lba + emmc_nsectors) {
+		return EINVAL;
+	}
+	if (emmc_wait_idle()) {
+		return EBUSY;
+	}
+	bzero(emmc_desc, nseg * sizeof(emmc_desc[0]));
+	for (uint32_t i = 0; i < nseg; i++) {
+		uint32_t *d = emmc_desc[i];
+		uint64_t a = buf_pa + (uint64_t)i * EMMC_DMA_SEG;
+		uint64_t next = i + 1 < nseg ? desc_pa + (uint64_t)(i + 1) * sizeof(emmc_desc[0]) : 0;
+		/* Boot 41: DIC on the last descriptor too kept IDSTS.RI clear and
+		 * every DMA read timed out (err 60). Only the last one interrupts. */
+		d[0] = DES0_OWN | DES0_CH | (i == 0 ? DES0_FS : 0) |
+		    (i + 1 == nseg ? DES0_LD : DES0_DIC);
+		d[2] = MIN(EMMC_DMA_SEG, bytes - i * EMMC_DMA_SEG);
+		d[4] = (uint32_t)a;
+		d[5] = (uint32_t)(a >> 32);
+		d[6] = (uint32_t)next;
+		d[7] = (uint32_t)(next >> 32);
+	}
+	emmc_dcache_flush(emmc_desc, nseg * sizeof(emmc_desc[0]));
+	emmc_dcache_flush(emmc_multi_buf, bytes);
+
+	emmc_wr(EMMC_INTMASK, 0);
+	emmc_wr(EMMC_CTRL, (ctrl & ~(CTRL_INT_ENABLE | CTRL_DMA_ENABLE | CTRL_USE_IDMAC)) |
+	    CTRL_FIFO_RESET | CTRL_DMA_RESET);
+	if (emmc_wait_clear(EMMC_CTRL, CTRL_FIFO_RESET | CTRL_DMA_RESET)) {
+		error = ETIMEDOUT;
+		goto out;
+	}
+	emmc_wr(EMMC_BMOD, BMOD_SWR);
+	if (emmc_wait_clear(EMMC_BMOD, BMOD_SWR)) {
+		error = ETIMEDOUT;
+		goto out;
+	}
+	emmc_wr(EMMC_IDSTS, 0xffffffffu);
+	emmc_wr(EMMC_IDINTEN, 0);
+	emmc_wr(EMMC_DBADDRL, (uint32_t)desc_pa);
+	emmc_wr(EMMC_DBADDRU, (uint32_t)(desc_pa >> 32));
+	emmc_wr(EMMC_CTRL, emmc_rd(EMMC_CTRL) | CTRL_USE_IDMAC | CTRL_DMA_ENABLE);
+	emmc_wr(EMMC_BMOD, BMOD_DE | BMOD_FB);
+
+	emmc_wr(EMMC_TMOUT, 0x573177ffu);
+	emmc_wr(EMMC_BLKSIZ, 512);
+	emmc_wr(EMMC_BYTCNT, bytes);
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_CMDARG, lba);
+	uint32_t command = CMD_START | CMD_WAIT_DATA | CMD_DATA | CMD_RESP_CRC | CMD_RESP |
+	    CMD_SEND_STOP | 18u;
+	if ((emmc_rd(EMMC_CLKSEL) >> 16) & 7u) {
+		command |= CMD_HOLD;
+	}
+	emmc_wr(EMMC_CMD, command);
+	emmc_wr(EMMC_PLDMND, 1);
+	xcover5_emmc_reads += nblk;
+
+	uint64_t limit = 4000000ull + 400000ull * nblk;
+	for (uint64_t i = 0;; i++) {
+		pending = emmc_rd(EMMC_RINTSTS);
+		idsts = emmc_rd(EMMC_IDSTS);
+		if ((pending & INT_ERRORS & ~INT_HTO) || (idsts & IDSTS_ERRORS)) {
+			error = EIO;
+			goto out;
+		}
+		/* Boot 42: rint=402c (CD, DTO, RXDR, ACD), TBBCNT = 0x1000 = the whole
+		 * read, BUFADDR inside our buffer, but IDSTS stayed 0 (no RI) even
+		 * with DIC cleared on the last descriptor. Done is: data over, all
+		 * bytes through the host bus, and the IDMAC gave every descriptor back. */
+		if ((pending & INT_DATA_OVER) && (pending & INT_CMD_DONE) &&
+		    emmc_rd(EMMC_TBBCNT) == bytes) {
+			emmc_dcache_flush(emmc_desc, nseg * sizeof(emmc_desc[0]));
+			bool owned = false;
+			for (uint32_t k = 0; k < nseg; k++) {
+				owned |= (*(volatile uint32_t *)&emmc_desc[k][0] & DES0_OWN) != 0;
+			}
+			if (!owned) {
+				break;
+			}
+		}
+		if (i == limit) {
+			error = ETIMEDOUT;
+			goto out;
+		}
+	}
+	for (unsigned i = 0; i < 1000000; i++) {
+		if (emmc_rd(EMMC_RINTSTS) & INT_ACD) {
+			break;
+		}
+	}
+	error = emmc_wait_idle();
+out:
+	if (error) {
+		printf("XC5 eMMC: DMA read error %d lba=%u n=%u rint=%x idsts=%x bmod=%x ctrl=%x\n",
+		    error, lba, nblk, pending, idsts, emmc_rd(EMMC_BMOD), emmc_rd(EMMC_CTRL));
+		/* For the heartbeat: the error lines scroll away during boot. */
+		xcover5_emmc_dma_diag[0] = pending;
+		xcover5_emmc_dma_diag[1] = idsts;
+		xcover5_emmc_dma_diag[2] = emmc_rd(EMMC_BMOD);
+		xcover5_emmc_dma_diag[3] = emmc_rd(EMMC_CTRL);
+		xcover5_emmc_dma_diag[4] = emmc_rd(0x098u);   /* DSCADDRL */
+		xcover5_emmc_dma_diag[5] = emmc_rd(0x0a0u);   /* BUFADDRL */
+		xcover5_emmc_dma_diag[6] = emmc_rd(EMMC_TBBCNT);
+		xcover5_emmc_dma_diag[7] = emmc_rd(EMMC_STATUS);
+	}
+	emmc_wr(EMMC_BMOD, 0);
+	emmc_wr(EMMC_CTRL, (emmc_rd(EMMC_CTRL) & ~(CTRL_USE_IDMAC | CTRL_DMA_ENABLE)) |
+	    CTRL_FIFO_RESET | CTRL_DMA_RESET);
+	(void)emmc_wait_clear(EMMC_CTRL, CTRL_FIFO_RESET | CTRL_DMA_RESET);
+	emmc_wr(EMMC_IDSTS, 0xffffffffu);
+	if (error) {
+		emmc_stop_transmission();
+	}
+	emmc_dcache_flush(emmc_multi_buf, bytes);
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_INTMASK, ints);
+	return error;
+}
+
+/* nblk sectors at lba into dst: DMA when on, PIO otherwise. */
+static int
+emmc_read_blocks(uint32_t lba, uint32_t nblk, caddr_t dst)
+{
+	if (emmc_dma < 0) {
+		/* Off unless xc5dma=1: boots 49-50 read root files as garbage
+		 * (non-platform rapportd/bluetoothd, a broken HFS catalog) with DMA
+		 * on, even after USERDATA was reflashed and writes went back to 128
+		 * sectors. Suspect: the done test (TBBCNT, OWN) can see the end of a
+		 * transfer before its last bus writes reach memory. */
+		emmc_dma = 0;
+		(void)PE_parse_boot_argn("xc5dma", &emmc_dma, sizeof(emmc_dma));
+		emmc_dma_checks = 64;
+		printf("XC5 eMMC: DMA reads %s, hcon=%x\n", emmc_dma ? "on" : "off",
+		    emmc_rd(EMMC_HCON));
+	}
+	xcover5_emmc_dma_on = emmc_dma;
+	xcover5_emmc_dma_checks_left = emmc_dma_checks;
+	if (emmc_dma && nblk > 1) {
+		int error = emmc_dma_read(lba, nblk);
+		if (!error) {
+			memcpy(dst, emmc_multi_buf, nblk * 512u);
+			xcover5_emmc_dma_reads += nblk;
+			/* The first 64 reads, then 1 in 256 for as long as DMA is on. */
+			if (emmc_dma_checks == 0 && (++emmc_dma_sample & 255u) != 0) {
+				return 0;
+			}
+			/* Read it again by PIO and compare. */
+			if (emmc_dma_checks) {
+				emmc_dma_checks--;
+			}
+			error = emmc_xfer_blocks(lba, nblk, false);
+			if (error) {
+				return error;
+			}
+			if (memcmp(dst, emmc_multi_buf, nblk * 512u) == 0) {
+				if (emmc_dma_checks == 0 && emmc_dma_sample == 0) {
+					printf("XC5 eMMC: 64 DMA reads matched PIO, now 1 in 256\n");
+				}
+				return 0;
+			}
